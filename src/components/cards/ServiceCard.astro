---
import Badge from "../common/Badge.astro";
import type { Service } from "../../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="card-surface flex h-full flex-col p-6">
  <div class="mb-6 flex flex-wrap gap-2">
    {service.tags.map((tag) => <Badge>{tag}</Badge>)}
  </div>
  <h3 class="font-heading text-xl font-semibold text-[var(--color-text)]">{service.title}</h3>
  <p class="mt-3 text-sm leading-6 text-[var(--color-text-soft)]">{service.summary}</p>
  <p class="mt-4 text-sm leading-6 text-[var(--color-text-muted)]">{service.detail}</p>
  <ul class="mt-5 grid gap-2">
    {service.deliverables.map((item) => (
      <li class="flex gap-3 text-sm leading-6 text-[var(--color-text-soft)]">
        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-primary)]"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</article>
