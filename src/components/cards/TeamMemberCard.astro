---
import type { Contributor } from "../../data/contributors";

interface Props {
  member: Contributor;
}

const { member } = Astro.props;
---

<article class="team-card card-surface group flex h-full flex-col p-6">
  <div class="flex items-center gap-4">
    <img
      src={member.avatar}
      alt={member.name}
      class="team-card__avatar"
      width="72"
      height="72"
      loading="lazy"
      decoding="async"
    />
    <div class="min-w-0">
      <h3 class="font-heading text-lg font-semibold text-[var(--color-text)]">{member.name}</h3>
      {member.handle && (
        <a
          href={member.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[0.72rem] text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-primary)]"
        >
          @{member.handle}
        </a>
      )}
    </div>
  </div>

  <p class="mt-4 font-mono text-[0.68rem] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
    {member.role}
  </p>
  <p class="mt-3 flex-1 text-sm leading-6 text-[var(--color-text-soft)]">{member.bio}</p>

  {member.skills && (
    <div class="mt-5 flex flex-wrap gap-1.5">
      {member.skills.map((skill) => (
        <span class="font-mono text-[0.58rem] uppercase tracking-wider text-white/55 border border-white/5 rounded-full px-2 py-0.5">
          {skill}
        </span>
      ))}
    </div>
  )}

  <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-white/5 pt-5 text-sm font-semibold">
    <a
      href={member.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-[var(--color-text)] transition-colors hover:text-[var(--color-primary)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
        <path d="M9 18c-4.51 2-5-2-7-2"/>
      </svg>
      <span>GitHub</span>
    </a>
    {member.portfolioUrl && (
      <a
        href={member.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[var(--color-text)] transition-colors hover:text-[var(--color-primary)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" x2="21" y1="14" y2="3"/>
        </svg>
        <span>Portfolio</span>
      </a>
    )}
  </div>
</article>

<style>
  .team-card__avatar {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-soft);
    object-fit: cover;
    transition: border-color 200ms ease;
  }
  .team-card:hover .team-card__avatar {
    border-color: var(--color-primary);
  }
</style>
