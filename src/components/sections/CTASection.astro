---
import Button from "../common/Button.astro";
import Container from "../common/Container.astro";
import { getDict, getLangFromUrl, localizePath } from "../../i18n/ui";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang).cta;

const { eyebrow = t.eyebrow, title = t.title, description = t.description } = Astro.props;
---

<section class="section-spacing">
  <Container>
    <div class="cta-panel relative overflow-hidden p-7 sm:p-10 lg:p-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-primary)]/30 bg-[#0d1508]/90 px-3 py-1 text-[0.72rem] font-mono font-medium tracking-[0.14em] uppercase text-[var(--color-primary)] shadow-sm backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)] shadow-[0_0_8px_var(--color-primary)]"></span>
          <span>{eyebrow}</span>
        </div>
        <h2 class="mt-4 font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
          {title}
        </h2>
        <p class="mt-4 text-base leading-7 text-[var(--color-text-soft)]">{description}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={localizePath("/contact", lang)}>{t.contact}</Button>
        <Button href={localizePath("/services", lang)} variant="secondary">{getDict(lang).nav.services}</Button>
      </div>
    </div>
  </Container>
</section>
