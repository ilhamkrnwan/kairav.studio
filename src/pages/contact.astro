---
/**
 * src/pages/contact.astro
 * Architectural Blueprint Contact & Project Intake Page for Kairav Studio.
 * Designed to seamlessly match the Clonix aesthetic of index.astro and works/index.astro:
 * 1. Dark Blueprint Hero with live status, telemetry bar, and studio clock.
 * 2. Light Canvas Interactive Project Matrix & Inquiry Form (Services, Timeline, Budget).
 * 3. 4 Studio Direct Communication Channels & Telemetry Grid.
 * 4. 4-Stage Client Intake Protocol ("What Happens Next").
 * 5. Prospective Client FAQ Accordion.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

// Available services for interactive intake matrix
const serviceOptions = [
  { id: "web-astro", label: "High-Velocity Web / Astro", icon: "⚡" },
  { id: "web-app", label: "Custom Web App / SaaS", icon: "🛠️" },
  { id: "ai-workflows", label: "AI Automation & Workflows", icon: "🤖" },
  { id: "seo-geo", label: "SEO & GEO Architecture", icon: "📈" },
  { id: "design-systems", label: "Design System & Branding", icon: "🎨" },
  { id: "iot-connected", label: "IoT & Connected Systems", icon: "🔌" },
];

// Timeline options
const timelineOptions = [
  { id: "urgent", label: "Urgent (< 3 Weeks)" },
  { id: "standard", label: "Standard (1–2 Months)" },
  { id: "strategic", label: "Strategic (2–4 Months)" },
  { id: "retainer", label: "Ongoing Studio Retainer" },
];

// Budget options
const budgetOptions = [
  { id: "tier-1", label: "< $2,500 (~Rp 15M–35M)" },
  { id: "tier-2", label: "$2,500–$7,500 (~Rp 35M–100M)" },
  { id: "tier-3", label: "$7,500–$15,000+ (~Rp 100M+)" },
  { id: "flexible", label: "Let's Discuss Scope First" },
];

// Direct contact channels
const contactChannels = [
  {
    title: "Direct Mail & RFPs",
    detail: "hello@kairav.studio",
    href: "mailto:hello@kairav.studio",
    note: "For detailed briefs, RFPs, pitch decks, and technical specs.",
    action: "Copy Email",
    isCopy: true,
  },
  {
    title: "Direct WhatsApp Line",
    detail: "+62 822 4190 7338",
    href: "https://wa.me/6282241907338?text=Hello%20Kairav%20Studio%2C%20I%20would%20like%20to%20discuss%20a%20new%20project.",
    note: "Fast messaging for initial alignments, quick questions, and fit check.",
    action: "Open WhatsApp",
    isCopy: false,
    external: true,
  },
  {
    title: "Studio Engineering Lab",
    detail: "17 Mataram St, Yogyakarta, ID",
    href: "https://maps.google.com/?q=Mataram+St+Yogyakarta",
    note: "Base headquarters. In-person sprint sessions by prior appointment.",
    action: "View Map",
    isCopy: false,
    external: true,
  },
  {
    title: "Code Integrity & OSS",
    detail: "github.com/ilhamkrnwan",
    href: "https://github.com/ilhamkrnwan/kairav.studio",
    note: "Public repositories, open source utilities, and architecture blueprints.",
    action: "Explore GitHub",
    isCopy: false,
    external: true,
  },
];

// Intake Protocol Steps
const protocolSteps = [
  {
    num: "01",
    tag: "< 24 Hours",
    title: "Triage & Feasibility Review",
    desc: "Our engineering leads review your brief, assess architectural feasibility, check our delivery pipeline, and confirm availability.",
  },
  {
    num: "02",
    tag: "20 Mins",
    title: "Focused Alignment Call",
    desc: "A direct conversation with engineers — no sales fluff. We discuss goals, performance bottlenecks, tech stacks, and team workflows.",
  },
  {
    num: "03",
    tag: "Fixed Scope",
    title: "Architectural Blueprint & Proposal",
    desc: "You receive a structured proposal outlining exact deliverables, milestones, fixed pricing, and an architectural recommendation.",
  },
  {
    num: "04",
    tag: "Sprint Zero",
    title: "Kickoff & Production Sprints",
    desc: "Shared GitHub repos, automated staging preview links, and asynchronous weekly video demos keep progress completely transparent.",
  },
];

// Prospective Client FAQs
const clientFaqs = [
  {
    q: "How fast will I hear back after submitting an inquiry?",
    a: "We review every incoming inquiry within 24 hours (usually within 2–4 hours during Indonesia business hours, UTC+7). You will receive a direct reply from our engineering leads with initial thoughts and next steps.",
  },
  {
    q: "Do you work on fixed-price projects or monthly retainers?",
    a: "We offer both! For defined builds like new websites, MVPs, and migrations, we provide transparent fixed-price milestones so there are no billing surprises. For evolving products, we offer dedicated monthly engineering retainers.",
  },
  {
    q: "Can you redesign or optimize an existing codebase, or do you only build from scratch?",
    a: "We frequently audit, optimize, and refactor existing applications. Whether you need a Core Web Vitals speed audit, an Astro frontend migration, or AI integration into an existing stack, we can step in and deliver.",
  },
  {
    q: "Do you work with international clients outside Indonesia?",
    a: "Yes. Over 70% of our workflow is async-first. We collaborate smoothly with founders and teams across North America, Europe, Singapore, and Australia using GitHub, Figma, Linear, and Loom.",
  },
  {
    q: "What do I need to prepare before our first conversation?",
    a: "Just a clear problem statement or business goal! You do not need finished wireframes or a 20-page document. If you have links to references, current metrics, or rough notes, that is more than enough to get started.",
  },
];
---

<BaseLayout
  title="Contact & Project Intake — Kairav Studio"
  description="Start your project with Kairav Studio. Direct intake for high-velocity websites, custom web applications, SEO/GEO architecture, and AI automation. We respond within 24 hours."
>
  <main class="contact-page-main">
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. HERO BAND (Dark Blueprint Architecture)                             */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="contact-hero-section" data-hero-section aria-label="Contact Overview">
      {/* Background Rotating Watermark */}
      <div class="hero-watermark" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" class="rotor-svg">
          <path
            d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.6142 50 100C50 72.6142 72.6142 50 100 50C72.6142 50 50 27.6142 50 0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <div class="contact-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        {/* Top Blueprint Telemetry Bar */}
        <div class="blueprint-meta-bar" aria-hidden="true">
          <div class="blueprint-meta-left">
            <span class="blueprint-status-dot"></span>
            <span class="blueprint-mono">STATUS: ONLINE · SLOTS OPEN FOR Q2–Q3 · RESPONSE &lt; 24H</span>
          </div>
          <div class="blueprint-meta-right">
            <span class="blueprint-mono">LOC: 07°47'S · 110°22'E · YOGYAKARTA, ID (UTC+7)</span>
          </div>
        </div>

        <div class="band-row hero-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Direct Line
            </div>
            
            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Accepting Inquiries
            </div>

            <!-- Studio Time Indicator -->
            <div class="studio-clock-card" id="studio-clock-widget">
              <span class="clock-label">STUDIO TIME (UTC+7)</span>
              <span class="clock-time" id="studio-live-clock">--:--:-- WIB</span>
              <span class="clock-status">YOGYAKARTA LAB ACTIVE</span>
            </div>

            <!-- Rating Trust Signal -->
            <div class="rating-badge">
              <div class="rating-star-box">
                <span class="star-icon">★</span>
                <span class="rating-val">4.9</span>
              </div>
              <span class="rating-sub">50+ Shipped Systems</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main hero-main">
            <div class="hero-header-wrap">
              <span class="hero-eyebrow">PROJECT INTAKE · ARCHITECTURAL BLUEPRINT</span>
              <h1 class="hero-title">Start with the Goal, the Problem, or the Bold Idea.</h1>
              <p class="hero-desc">
                We partner with ambitious founders, brands, and engineering teams to turn complex ideas into high-velocity websites, custom web applications, and AI-enabled systems. Tell us what needs to be built — we respond within 24 hours with honest engineering advice and next steps.
              </p>
            </div>

            {/* Quick Action Badges Strip */}
            <div class="quick-channels-strip" aria-label="Quick Communication Options">
              <div class="quick-channel-card">
                <div class="quick-card-left">
                  <span class="quick-card-label">DIRECT EMAIL</span>
                  <a href="mailto:hello@kairav.studio" class="quick-card-value">hello@kairav.studio</a>
                </div>
                <button
                  type="button"
                  class="quick-copy-button"
                  id="hero-copy-email-btn"
                  data-clipboard="hello@kairav.studio"
                  aria-label="Copy email address"
                >
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>

              <div class="quick-channel-card">
                <div class="quick-card-left">
                  <span class="quick-card-label">INSTANT CHAT</span>
                  <a
                    href="https://wa.me/6282241907338?text=Hello%20Kairav%20Studio%2C%20I%20would%20like%20to%20discuss%20a%20new%20project."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="quick-card-value"
                  >
                    +62 822 4190 7338
                  </a>
                </div>
                <a
                  href="https://wa.me/6282241907338?text=Hello%20Kairav%20Studio%2C%20I%20would%20like%20to%20discuss%20a%20new%20project."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="quick-action-link"
                  aria-label="Open WhatsApp chat"
                >
                  <span>Chat</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <div class="quick-channel-badge">
                <span class="badge-icon">⚡</span>
                <span class="badge-text">&lt; 2.4h Avg Reply</span>
              </div>

              <div class="quick-channel-badge">
                <span class="badge-icon">🔒</span>
                <span class="badge-text">Mutual NDA Default</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. INTERACTIVE INQUIRY MATRIX (Light Architectural Grid)               */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="contact-intake-section" id="inquiry-form-section" aria-label="Project Scope and Inquiry Form">
      <div class="contact-container container-light">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row form-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Scope Matrix
            </div>

            <div class="rail-sticky-info">
              <h3 class="rail-info-title">Configurable Intake</h3>
              <p class="rail-info-desc">
                Select your required project disciplines and timeline. This helps us assign the right senior engineer and prepare an accurate estimate before our first call.
              </p>

              <div class="rail-proof-box">
                <div class="proof-avatars" aria-hidden="true">
                  <img
                    src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=96&h=96&fit=crop&crop=face"
                    alt="Team 1"
                    class="avatar-circle"
                    width="32"
                    height="32"
                    loading="lazy"
                  />
                  <img
                    src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=96&h=96&fit=crop&crop=face"
                    alt="Team 2"
                    class="avatar-circle"
                    width="32"
                    height="32"
                    loading="lazy"
                  />
                  <img
                    src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=96&h=96&fit=crop&crop=face"
                    alt="Team 3"
                    class="avatar-circle"
                    width="32"
                    height="32"
                    loading="lazy"
                  />
                </div>
                <span class="proof-text">Direct collaboration with senior designers & architects.</span>
              </div>

              <div class="rail-guarantee-note">
                <span class="guarantee-check">✓</span>
                <span>Zero sales pressure. Straightforward technical assessment.</span>
              </div>
            </div>
          </aside>

          {/* Right Main Form Container */}
          <div class="band-main main-light form-main">
            <div class="form-header-wrap">
              <h2 class="form-section-title">Configure Your Project Blueprint</h2>
              <p class="form-section-subtitle">
                Select what you need below, or simply drop in your brief. We will analyze your requirements and follow up promptly.
              </p>
            </div>

            {/* Submission Status Alert (Client-side feedback) */}
            <div class="form-alert-banner" id="form-feedback-alert" role="alert" style="display: none;">
              <span class="alert-icon">✓</span>
              <div class="alert-content">
                <h4 class="alert-heading">Inquiry Received</h4>
                <p class="alert-text">
                  Thank you! Your project notes have been queued. Our engineering lead will follow up at your email address within 24 hours.
                </p>
              </div>
            </div>

            <!-- Form Element -->
            <form
              class="intake-form"
              id="kairav-project-form"
              action="mailto:hello@kairav.studio"
              method="post"
              enctype="text/plain"
            >
              {/* ── STEP 1: Service Disciplines ── */}
              <div class="form-group-block">
                <div class="group-label-row">
                  <span class="step-num">01</span>
                  <label class="group-title">What capabilities do you require?</label>
                  <span class="group-hint">Select all that apply</span>
                </div>

                <div class="chips-selector-grid" role="group" aria-label="Service capabilities">
                  {serviceOptions.map((s) => (
                    <button
                      type="button"
                      class="service-chip-btn"
                      data-service-id={s.id}
                      data-service-label={s.label}
                      aria-pressed="false"
                    >
                      <span class="chip-icon" aria-hidden="true">{s.icon}</span>
                      <span class="chip-text">{s.label}</span>
                      <span class="chip-indicator" aria-hidden="true">+</span>
                    </button>
                  ))}
                </div>
                <input type="hidden" name="selected_services" id="hidden-services-input" value="" />
              </div>

              {/* ── STEP 2: Desired Timeline ── */}
              <div class="form-group-block">
                <div class="group-label-row">
                  <span class="step-num">02</span>
                  <label class="group-title">Target Launch Timeline</label>
                  <span class="group-hint">Choose one</span>
                </div>

                <div class="pills-selector-grid" role="radiogroup" aria-label="Target timeline">
                  {timelineOptions.map((t, idx) => (
                    <button
                      type="button"
                      class={`timeline-pill-btn ${idx === 1 ? "is-selected" : ""}`}
                      data-timeline-id={t.id}
                      data-timeline-label={t.label}
                      role="radio"
                      aria-checked={idx === 1 ? "true" : "false"}
                    >
                      <span class="pill-dot" aria-hidden="true"></span>
                      <span class="pill-text">{t.label}</span>
                    </button>
                  ))}
                </div>
                <input type="hidden" name="selected_timeline" id="hidden-timeline-input" value="Standard (1–2 Months)" />
              </div>

              {/* ── STEP 3: Estimated Investment ── */}
              <div class="form-group-block">
                <div class="group-label-row">
                  <span class="step-num">03</span>
                  <label class="group-title">Estimated Budget Allocation</label>
                  <span class="group-hint">Helps calibrate scope</span>
                </div>

                <div class="pills-selector-grid" role="radiogroup" aria-label="Budget allocation">
                  {budgetOptions.map((b, idx) => (
                    <button
                      type="button"
                      class={`budget-pill-btn ${idx === 1 ? "is-selected" : ""}`}
                      data-budget-id={b.id}
                      data-budget-label={b.label}
                      role="radio"
                      aria-checked={idx === 1 ? "true" : "false"}
                    >
                      <span class="pill-dot" aria-hidden="true"></span>
                      <span class="pill-text">{b.label}</span>
                    </button>
                  ))}
                </div>
                <input type="hidden" name="selected_budget" id="hidden-budget-input" value="$2,500–$7,500 (~Rp 35M–100M)" />
              </div>

              {/* ── STEP 4: Personal / Project Details ── */}
              <div class="form-group-block">
                <div class="group-label-row">
                  <span class="step-num">04</span>
                  <label class="group-title">Your Details & Project Brief</label>
                </div>

                <div class="input-fields-grid">
                  <div class="field-item">
                    <label class="field-label" for="contact-name">
                      Your Name <span class="required-star">*</span>
                    </label>
                    <input
                      type="text"
                      id="contact-name"
                      name="name"
                      required
                      placeholder="e.g. Alex Henderson"
                      class="custom-text-input"
                    />
                  </div>

                  <div class="field-item">
                    <label class="field-label" for="contact-email">
                      Work Email <span class="required-star">*</span>
                    </label>
                    <input
                      type="email"
                      id="contact-email"
                      name="email"
                      required
                      placeholder="alex@company.com"
                      class="custom-text-input"
                    />
                  </div>

                  <div class="field-item">
                    <label class="field-label" for="contact-phone">
                      WhatsApp / Phone <span class="optional-tag">(Optional, for fast sync)</span>
                    </label>
                    <input
                      type="tel"
                      id="contact-phone"
                      name="phone"
                      placeholder="+62 812 3456 7890"
                      class="custom-text-input"
                    />
                  </div>

                  <div class="field-item">
                    <label class="field-label" for="contact-company">
                      Company / Organization / Existing URL <span class="optional-tag">(Optional)</span>
                    </label>
                    <input
                      type="text"
                      id="contact-company"
                      name="company"
                      placeholder="e.g. Acme Corp or acme.com"
                      class="custom-text-input"
                    />
                  </div>
                </div>

                <div class="field-item full-width-field">
                  <label class="field-label" for="contact-notes">
                    Tell us about the project, the primary challenge, or the rough idea <span class="required-star">*</span>
                  </label>
                  <textarea
                    id="contact-notes"
                    name="message"
                    rows="5"
                    required
                    placeholder="Briefly describe what you are looking to build or optimize. Mention key goals, current performance bottlenecks, or specific references if you have them."
                    class="custom-textarea"
                  ></textarea>
                </div>
              </div>

              {/* Form Submission Actions */}
              <div class="form-actions-bar">
                <button type="submit" class="clonix-cta-button" id="submit-intake-btn">
                  <span class="clonix-cta-button__text">Send Project Inquiry</span>
                  <span class="clonix-cta-button__box" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 8h10M9 4l4 4-4 4"></path>
                    </svg>
                  </span>
                </button>

                <!-- Alternative WhatsApp Direct Action -->
                <button
                  type="button"
                  class="whatsapp-compose-button"
                  id="whatsapp-dispatch-btn"
                  title="Generate a prefilled WhatsApp message with this brief"
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.78 14.04c-.24.68-1.39 1.3-1.92 1.38-.5.08-1.14.11-3.69-.93-3.07-1.25-5.06-4.38-5.21-4.58-.15-.2-1.24-1.65-1.24-3.15 0-1.5 1.15-2.24 1.56-2.55.41-.31.9-.39 1.2-.39.3 0 .61.01.87.02.28.01.65-.11 1.01.77.38.92 1.29 3.15 1.41 3.38.11.23.19.5.04.8-.15.3-.23.49-.45.75-.23.26-.48.58-.69.78-.23.23-.47.48-.2.94.27.46 1.21 1.99 2.59 3.22 1.78 1.58 3.27 2.07 3.74 2.3.46.23.74.19 1.01-.12.27-.31 1.16-1.35 1.47-1.81.31-.46.61-.39 1.03-.23.41.15 2.65 1.25 3.1 1.48.46.23.77.34.88.53.11.2.11 1.13-.13 1.81z"/>
                  </svg>
                  <span>Compose via WhatsApp</span>
                </button>

                <div class="form-privacy-note">
                  <span class="lock-icon">🔒</span>
                  <span>Direct to founder & engineering lead. Strictly confidential.</span>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. FOUR DIRECT CHANNELS & TELEMETRY (Light Architectural Band)         */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="contact-channels-section" aria-label="Direct Communication Channels">
      <div class="contact-container container-light">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row channels-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Direct Channels
            </div>
            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Fast Access Lines
            </div>
          </aside>

          {/* Right Main Grid */}
          <div class="band-main main-light">
            <div class="channels-grid">
              {contactChannels.map((ch, idx) => (
                <div class="channel-card">
                  <div class="channel-card-top">
                    <span class="channel-index">0{idx + 1} / CHANNEL</span>
                    <h3 class="channel-title">{ch.title}</h3>
                  </div>

                  <p class="channel-detail">
                    {ch.href.startsWith("mailto:") ? (
                      <a href={ch.href} class="channel-link">{ch.detail}</a>
                    ) : (
                      <a href={ch.href} target={ch.external ? "_blank" : "_self"} rel={ch.external ? "noopener noreferrer" : ""} class="channel-link">
                        {ch.detail}
                      </a>
                    )}
                  </p>

                  <p class="channel-note">{ch.note}</p>

