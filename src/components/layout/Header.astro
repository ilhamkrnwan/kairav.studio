---
import { getLangFromUrl, localizePath, useTranslations, languages, type Lang } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: "/works", label: t("Work") },
  { href: "/services", label: t("Services") },
  { href: "/tools", label: t("Tools") },
  { href: "/insights", label: t("Insights") },
  { href: "/about", label: t("About") },
  { href: "/contact", label: t("Contact") },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header" data-site-header>
  <div class="site-topbar">
    <a href="/" class="site-logo" aria-label="Kairav Studio home">
      <img src="/logo-mark.avif" alt="" class="site-logo__mark" width="80" height="80" />
      <span class="site-logo__text">
        <span class="site-logo__name">KAIRAV</span>
        <span class="site-logo__studio">STUDIO</span>
      </span>
    </a>

    <div class="site-actions" aria-label="Site actions">
      <button class="site-menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">{t("Menu")}</span>
        <span class="site-menu-toggle__line"></span>
        <span class="site-menu-toggle__line"></span>
        <span class="site-menu-toggle__line"></span>
        <span class="site-rail-tooltip">{t("Menu")}</span>
      </button>
      <a class="site-icon-link" href={localizePath("/services", lang)} aria-label={t("Services")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span class="site-rail-tooltip">{t("Services")}</span>
      </a>
      <a class="site-icon-link" href="mailto:hello@kairav.studio" aria-label={t("Email Kairav Studio")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span class="site-rail-tooltip">Email</span>
      </a>
      <div class="site-lang-dropdown site-lang-dropdown--rail" data-lang-dropdown>
        <button class="site-lang-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-lang-trigger>
          {lang.toUpperCase()}
          <span class="site-rail-tooltip">{t("Language")}</span>
        </button>
        <div class="site-lang-menu">
          {
            Object.entries(languages).map(([code, label]) => (
              <a 
                href={localizePath(Astro.url.pathname, code as Lang)} 
                class:list={["site-lang-option", code === lang && "is-active"]}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <a class="site-announcement" href="/contact">
    <span>{t("Premium websites, fast builds, SEO/GEO-ready systems.")}</span>
    <span>{t("Premium websites, fast builds, SEO/GEO-ready systems.")}</span>
    <span>{t("Premium websites, fast builds, SEO/GEO-ready systems.")}</span>
  </a>

  <div class="site-menu-backdrop" data-menu-backdrop></div>

  <nav id="site-menu" class="site-menu" aria-label="Primary navigation" aria-hidden="true" data-menu-panel>
    <div class="site-menu__main">
      <div class="site-menu__head">
        <p class="site-menu__eyebrow">{t("Navigate")}</p>
        <div class="site-lang-dropdown site-lang-dropdown--drawer" data-lang-dropdown>
          <button class="site-lang-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" data-lang-trigger>
            {lang.toUpperCase()}
          </button>
          <div class="site-lang-menu">
            {
              Object.entries(languages).map(([code, label]) => (
                <a 
                  href={localizePath(Astro.url.pathname, code as Lang)} 
                  class:list={["site-lang-option", code === lang && "is-active"]}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="site-menu__primary">
        {
          navItems.map((item) => (
            <a href={item.href} class:list={[isActive(item.href) && "is-active"]}>
              {item.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="site-menu__secondary">
      <a href="/contact">{t("Start a Project")}</a>
      <a href="mailto:hello@kairav.studio">hello@kairav.studio</a>
      <a href="https://github.com/kairavstudio">{t("GitHub")}</a>
    </div>
  </nav>
</header>

<script>
  let scrollListener: (() => void) | null = null;
  let keydownListener: ((event: KeyboardEvent) => void) | null = null;

  const initHeader = () => {
    const siteHeader = document.querySelector("[data-site-header]");
    const toggle = document.querySelector("[data-menu-toggle]");
    const panel = document.querySelector("[data-menu-panel]");
    const backdrop = document.querySelector("[data-menu-backdrop]");

    const setMenu = (open: boolean) => {
      siteHeader?.classList.toggle("is-menu-open", open);
      document.documentElement.classList.toggle("site-menu-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
      panel?.setAttribute("aria-hidden", String(!open));
    };

    // Scroll listener cleanup and registration
    if (scrollListener) {
      window.removeEventListener("scroll", scrollListener);
    }
    const handleScroll = () => {
      const isScrolled = window.scrollY > 20;
      siteHeader?.classList.toggle("is-scrolled", isScrolled);
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    scrollListener = handleScroll;
    handleScroll();

    // Toggle click
    toggle?.addEventListener("click", () => {
      setMenu(!siteHeader?.classList.contains("is-menu-open"));
    });

    // Backdrop click
    backdrop?.addEventListener("click", () => setMenu(false));

    // Panel links click
    panel?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    // Keydown listener cleanup and registration
    if (keydownListener) {
      document.removeEventListener("keydown", keydownListener);
    }
    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") setMenu(false);
    };
    document.addEventListener("keydown", handleKeydown);
    keydownListener = handleKeydown;

    // Language dropdowns trigger and click outside handler
    const dropdowns = document.querySelectorAll("[data-lang-dropdown]");
    dropdowns.forEach((dropdown) => {
      const trigger = dropdown.querySelector("[data-lang-trigger]");
      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = dropdown.classList.contains("is-open");
        
        dropdowns.forEach((d) => {
          d.classList.remove("is-open");
          d.querySelector("[data-lang-trigger]")?.setAttribute("aria-expanded", "false");
        });
        
        if (!isOpen) {
          dropdown.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", () => {
      dropdowns.forEach((d) => {
        d.classList.remove("is-open");
        d.querySelector("[data-lang-trigger]")?.setAttribute("aria-expanded", "false");
      });
    });
  };

  // Run on load and page swaps
  document.addEventListener("astro:page-load", initHeader);
</script>
