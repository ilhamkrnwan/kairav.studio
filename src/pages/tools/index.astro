---
/**
 * src/pages/tools/index.astro
 * Architectural Blueprint Tools & Capabilities Page for Kairav Studio.
 * Designed to seamlessly match the Clonix aesthetic of index.astro, services.astro, teams.astro, and about.astro:
 * 1. Dark Blueprint Hero with telemetry bar, toolkit dossier status, and engineering guarantees.
 * 2. Light Canvas 6-Tool Architectural Showcase Matrix with interactive discipline filtering.
 * 3. Dark Obsidian Interactive Fit Matrix ("Which Tool Fits Your Stage?").
 * 4. Light Canvas 4-Stage Implementation & Delivery Protocol.
 * 5. Prospective Client Tooling FAQ Accordion.
 * 6. Monumental Bottom CTA Banner leading to /contact.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, serviceCategories } from "../../data/services";

// Filter categories for the interactive discipline bar
const filterCategories = [
  { id: "all", label: "All Disciplines", count: services.length },
  { id: "Web Experiences", label: "Web Experiences", count: services.filter(s => s.category === "Web Experiences").length },
  { id: "Systems & Intelligence", label: "Systems & Intelligence", count: services.filter(s => s.category === "Systems & Intelligence").length },
];

// 3-Stage Growth & Stage Fit Matrix
const fitStages = [
  {
    stage: "STAGE 01",
    label: "Launch & Brand Authority",
    audience: "Early-stage products, new studios, and ambitious brand relaunches",
    tools: ["Brand Website", "SEO & GEO Architecture"],
    desc: "Establish unmistakable visual gravity, flawless Core Web Vitals, and day-one indexation across Google and modern AI engines (ChatGPT, Perplexity, Claude).",
    timeframe: "2–4 Weeks Delivery",
    accent: "#b6ff5c",
  },
  {
    stage: "STAGE 02",
    label: "Velocity & System Scale",
    audience: "Growing businesses facing frontend performance bottlenecks or scaling pains",
    tools: ["Performance Optimization", "Custom Digital Systems"],
    desc: "Slash page weight, decouple sluggish monolithic code, and build custom internal portals, SaaS dashboards, and automated client workflows.",
    timeframe: "3–6 Weeks Delivery",
    accent: "#38bdf8",
  },
  {
    stage: "STAGE 03",
    label: "Intelligence & Connected Ecosystems",
    audience: "Teams looking to automate workflows or bridge hardware and mobile clients",
    tools: ["AI Integration", "Android & IoT Connected Systems"],
    desc: "Deploy cost-aware prompt caching pipelines, custom vector search, and cross-platform mobile clients with offline-first SQLite synchronization.",
    timeframe: "4–8 Weeks Delivery",
    accent: "#a855f7",
  },
];

// 4-Stage Implementation Protocol
const implementationSteps = [
  {
    num: "01",
    tag: "Audit & Scoping",
    title: "Constraint & Telemetry Mapping",
    desc: "We analyze current payloads, database structures, search indexation health, and user pain points before writing a single line of production code.",
  },
  {
    num: "02",
    tag: "Architecture",
    title: "Component & Protocol Design",
    desc: "We design strictly-typed interfaces, reusable design system tokens, and edge API contracts that establish clean module boundaries.",
  },
  {
    num: "03",
    tag: "Engineering",
    title: "High-Velocity Static-First Sprints",
    desc: "We build with Astro, TypeScript, and edge runtime architectures, providing weekly Loom video demos and private staging branch deployments.",
  },
  {
    num: "04",
    tag: "Verification",
    title: "Automated Testing & Full IP Handoff",
    desc: "Every system undergoes Core Web Vitals audits, accessibility tests, and clean documentation handoffs. You own 100% of your GitHub repository.",
  },
];

// Tools FAQ
const toolsFaqs = [
  {
    q: "Can we combine multiple capabilities into a single engagement?",
    a: "Yes. Most clients combine a Brand Website with SEO/GEO Architecture, or pair Performance Optimization with Custom Digital Systems. We tailor the scope to your exact product requirements without billing for unused capabilities.",
  },
  {
    q: "How do individual /tools differ from full /services?",
    a: "The /services page presents our broad business engagement models and retainers. This /tools section provides the deep architectural blueprint for each specific capability — detailing technical stacks, deliverables, problems solved, and measurable outcomes.",
  },
  {
    q: "Can Kairav Studio refactor our existing codebase instead of building from scratch?",
    a: "Absolutely. Our Performance Optimization and Custom Digital Systems capabilities frequently operate on legacy codebases — auditing bottlenecks, eliminating JavaScript bloat, and modernizing architectures without requiring a high-risk full rebuild.",
  },
  {
    q: "What technical documentation do we receive upon project delivery?",
    a: "You receive complete architectural documentation including component usage guides, design tokens, environment configurations, CI/CD deployment instructions, and full API endpoint documentation.",
  },
  {
    q: "Who owns the code, assets, and design system after completion?",
    a: "You retain 100% full intellectual property ownership. Repositories are hosted under your GitHub organization, assets are transferred in full, and there are zero proprietary lock-in licenses or ongoing platform fees.",
  },
];
---

<BaseLayout
  title="Tools & Engineering Capabilities — Kairav Studio"
  description="Explore the technical capabilities and engineering tools behind every Kairav Studio build: brand websites, SEO/GEO architecture, performance, custom systems, and AI."
  canonicalPath="/tools"
>
  <main class="tools-page-main">
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. HERO BAND (Dark Blueprint Architecture)                             */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="tools-hero-section" data-hero-section aria-label="Tools and Capabilities Overview">
      {/* Background Rotating Watermark */}
      <div class="hero-watermark" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" class="rotor-svg">
          <path
            d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.6142 50 100C50 72.6142 72.6142 50 100 50C72.6142 50 50 27.6142 50 0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <div class="tools-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        {/* Top Blueprint Telemetry Bar */}
        <div class="blueprint-meta-bar" aria-hidden="true">
          <div class="blueprint-meta-left">
            <span class="blueprint-mono">TOOLS</span>
          </div>
          <div class="blueprint-meta-right">
            <span class="blueprint-mono">YOGYAKARTA, ID</span>
          </div>
        </div>

        <div class="band-row hero-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Toolkit Dossier
            </div>

            <div class="rail-live-badge">
              Production Tooling
            </div>

            {/* Rating Pill */}
            <div class="rating-badge">
              <div class="rating-star-box">
                <span class="star-icon">★</span>
                <span class="rating-val">4.9</span>
              </div>
              <span class="rating-sub">50+ Shipped Systems</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">TOOLKIT RANGE</span>
              <span class="spec-value">6 Disciplines</span>
              <span class="spec-detail">Full architectural coverage from front-end design systems to edge runtimes.</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">CODE RIGOR</span>
              <span class="spec-value">TypeScript Core</span>
              <span class="spec-detail">Strictly typed components, robust error handling, zero unvetted runtime dependencies.</span>
            </div>
          </aside>

          {/* Main Hero Stage */}
          <div class="band-main">
            <div class="hero-header-wrap">
              <span class="hero-eyebrow">ENGINEERING CAPABILITIES & TOOLING</span>
              <h1 class="hero-title">
                Bespoke Capabilities. <span class="hero-highlight">Engineered for High Output.</span>
              </h1>
              <p class="hero-desc">
                The full engineering toolkit behind every Kairav Studio build. Each discipline is documented with deep architectural specifications, technical directions, deliverables, and measurable outcomes.
              </p>
            </div>

            {/* Guarantees & Operating Commitments Strip */}
            <div class="hero-standards-strip">
              <div class="standard-chip">
                <span class="chip-val">Design System Tokens</span>
                <span class="chip-sub">Component-first token architecture that scales effortlessly.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Sub-100ms Hydration</span>
                <span class="chip-sub">Zero-JS default static delivery for instant interaction.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">SEO & GEO Schemas</span>
                <span class="chip-sub">Structured JSON-LD optimized for Google and modern LLMs.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Zero Vendor Lock-In</span>
                <span class="chip-sub">100% clean GitHub repository ownership upon completion.</span>
              </div>
            </div>

            {/* Action buttons */}
            <div class="hero-action-row">
              <a href="#toolkit-matrix" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Explore All 6 Tools</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3v10M4 9l4 4 4-4"/>
                  </svg>
                </span>
              </a>

              <a href="/services" class="hero-outline-btn">
                <span>View Full Service Packages</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. ARCHITECTURAL TOOLKIT MATRIX (Light Canvas #f8f5ec)                 */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="toolkit-matrix-section" id="toolkit-matrix" aria-label="Tools and Capabilities Catalog">
      <div class="tools-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Capabilities
            </div>

            <div class="rail-pill">
              Interactive Catalog
            </div>

            <div class="tools-meta-note">
              <span class="meta-label">CATALOG SCOPE</span>
              <span class="meta-val">{services.length} Core Tools</span>
              <span class="meta-desc">Click any capability for deep specifications, deliverables, and FAQ.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">01 · DETAILED SPECIFICATION ARCHIVE</span>
              <h2 class="matrix-title">Disciplines & Engineering Arsenal.</h2>
              <p class="matrix-desc">
                Select a capability below to explore technical directions, target problems, included deliverables, and verified business outcomes.
              </p>
            </div>

            {/* Interactive Discipline Filter Chips */}
            <div class="discipline-filters-row" role="tablist" aria-label="Filter capabilities by discipline">
              {filterCategories.map((cat, idx) => (
                <button
                  type="button"
                  class={`discipline-chip-btn ${idx === 0 ? "is-active" : ""}`}
                  data-filter={cat.id}
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  <span class="chip-text">{cat.label}</span>
                  <span class="chip-count">({cat.count})</span>
                </button>
              ))}
            </div>

            {/* 6 Architectural Tool Cards Grid */}
            <div class="tools-cards-grid">
              {services.map((service, index) => (
                <article
                  class="architectural-tool-card"
                  data-tool-card
                  data-category={service.category}
                  id={`tool-${service.id}`}
                >
                    {/* Corner Crosshairs */}
                    <span class="tool-cross cross--tl" aria-hidden="true">+</span>
                    <span class="tool-cross cross--tr" aria-hidden="true">+</span>
                    <span class="tool-cross cross--bl" aria-hidden="true">+</span>
                    <span class="tool-cross cross--br" aria-hidden="true">+</span>

                    {/* Card Top Meta */}
                    <div class="tool-card-head">
                      <div class="tool-category-badge">
                        <span class="badge-text">{service.category}</span>
                      </div>
                      <span class="tool-index-tag">0{index + 1}</span>
                    </div>

                    {/* Interactive Visual Media Preview Frame */}
                    <a href={`/tools/${service.id}`} class="tool-card-media" aria-label={`View ${service.title} specification`}>
                      <img
                        src={service.image}
                        alt={`${service.title} visual specification preview`}
                        class="tool-card-img"
                        loading="lazy"
                        width="640"
                        height="360"
                      />
                      <div class="tool-card-img-overlay"></div>
                      <div class="tool-card-chip">
                        <span>{service.techDirection[0]} ENGINE</span>
                      </div>
                      <span class="tool-media-badge-zoom" aria-hidden="true">
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M6 2H2v4M10 14h4v-4M14 2L9 7M2 14l5-5"/>
                        </svg>
                      </span>
                    </a>

                    {/* Title & Icon Header */}
                    <div class="tool-title-row">
                      <div class="tool-icon-frame" aria-hidden="true">
                        <Fragment set:html={service.icon} />
                      </div>
                      <h3 class="tool-title-text">{service.title}</h3>
                    </div>

                    {/* Summary & Who It's For */}
                    <p class="tool-summary-text">{service.summary}</p>
                    
                    <div class="tool-audience-box">
                      <span class="audience-label">TARGET AUDIENCE:</span>
                      <p class="audience-text">{service.detail}</p>
                    </div>

                    {/* Deliverables Preview */}
                    <div class="tool-deliverables-section">
                      <span class="deliverables-label">PRIMARY DELIVERABLES:</span>
                      <div class="deliverables-chips">
                        {service.deliverables.slice(0, 4).map((item) => (
                          <span class="deliverable-pill">{item}</span>
                        ))}
                      </div>
                    </div>

                    {/* Tech Direction Tags */}
                    <div class="tool-tech-strip">
                      <span class="tech-label">CORE DIRECTION:</span>
                      <div class="tech-pills">
                        {service.techDirection.map((tech) => (
                          <span class="tech-pill">{tech}</span>
                        ))}
                      </div>
                    </div>

                    {/* Measurable Outcome Banner */}
                    <div class="tool-outcome-banner">
                      <span class="outcome-icon">★</span>
                      <span class="outcome-text">Outcome: {service.outcome}</span>
                    </div>

                    {/* Card Action Link to Detail Page */}
                    <div class="tool-action-bar">
                      <a href={`/tools/${service.id}`} class="tool-drilldown-link">
                        <span>Read Full Specification</span>
                        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M3 8h10M9 4l4 4-4 4"/>
                        </svg>
                      </a>
                    </div>
                  </article>
                ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. STAGE FIT MATRIX (Dark Obsidian Canvas #07080b)                     */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="fit-matrix-section" aria-label="Capability Fit by Stage">
      <div class="tools-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Growth Fit
            </div>

            <div class="rail-live-badge">
              3 Strategic Stages
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">FIT STRATEGY</span>
              <span class="spec-value">Scope Precision</span>
              <span class="spec-detail">Right-sizing engineering capabilities to match your current company stage.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main">
            <div class="fit-header-wrap">
              <span class="fit-eyebrow">02 · STRATEGIC RECOMMENDATION</span>
              <h2 class="fit-title">Which Tools Fit Your Current Stage?</h2>
              <p class="fit-desc">
                Don't over-engineer hypothetical requirements. Align your technical investments with your actual business stage.
              </p>
            </div>

            {/* 3 Stage Cards */}
            <div class="fit-stages-grid">
              {fitStages.map((stage) => (
                <div class="fit-stage-card">
                  <div class="stage-top-bar">
                    <span class="stage-phase-tag">{stage.stage}</span>
                    <span class="stage-timeframe">{stage.timeframe}</span>
                  </div>

                  <h3 class="stage-title">{stage.label}</h3>
                  <p class="stage-audience">{stage.audience}</p>
                  <p class="stage-desc">{stage.desc}</p>

                  <div class="stage-recommended-tools">
                    <span class="rec-label">RECOMMENDED TOOLS:</span>
                    <div class="rec-chips">
                      {stage.tools.map((t) => (
                        <span class="rec-chip">{t}</span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. IMPLEMENTATION PROTOCOL (Light Canvas #f8f5ec)                      */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="implementation-section" aria-label="Implementation Protocol">
      <div class="tools-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Delivery Protocol
            </div>

            <div class="rail-pill">
              4-Phase Flow
            </div>

            <div class="tools-meta-note">
              <span class="meta-label">CADENCE</span>
              <span class="meta-val">Async-First</span>
              <span class="meta-desc">Continuous feedback via GitHub PRs, Loom demos, and Linear boards.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">03 · HOW WE DELIVER EACH TOOL</span>
              <h2 class="matrix-title">Our 4-Stage Implementation Architecture.</h2>
              <p class="matrix-desc">
                From initial constraint mapping to full production verification, every build follows a transparent engineering path.
              </p>
            </div>

            {/* 4 Protocol Steps */}
            <div class="protocol-steps-grid">
              {implementationSteps.map((step) => (
                <div class="protocol-step-card">
                  <div class="step-head">
                    <span class="step-num">{step.num}</span>
                    <span class="step-tag">{step.tag}</span>
                  </div>
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-desc">{step.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 5. TOOLING FAQ ACCORDION (Light Canvas #f8f5ec)                        */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="tools-faq-section" aria-label="Tools FAQ">
      <div class="tools-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Capability FAQ
            </div>

            <div class="rail-pill">
              Frequently Asked
            </div>

            <div class="tools-meta-note">
              <span class="meta-label">TECHNICAL CLARITY</span>
              <span class="meta-val">Full Answers</span>
              <span class="meta-desc">Details regarding tool combinations, migrations, and ownership.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="faq-header-wrap">
              <span class="faq-eyebrow">04 · CLARITY & SPECIFICATIONS</span>
              <h2 class="faq-title">Common Questions About Our Capabilities</h2>
              <p class="faq-desc">
                Everything you need to know about combining tools, stack choices, and codebase integration.
              </p>
            </div>

            {/* Interactive FAQ Accordion */}
            <div class="tools-faq-accordion" data-faq-group>
              {toolsFaqs.map((faq, idx) => (
                <div class={`faq-item-row ${idx === 0 ? "is-expanded" : ""}`} data-faq-item={idx}>
                  <button
                    type="button"
                    class="faq-item-trigger"
                    data-faq-trigger
                    aria-expanded={idx === 0 ? "true" : "false"}
                  >
                    <div class="trigger-left">
                      <span class="faq-index-number">0{idx + 1}</span>
                      <h3 class="faq-question-text">{faq.q}</h3>
                    </div>
                    <span class="faq-toggle-icon" aria-hidden="true">+</span>
                  </button>

                  <div class="faq-item-body">
                    <div class="faq-item-content">
                      <p class="faq-answer-text">{faq.a}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     BASE CANVAS & ARCHITECTURAL BLUEPRINT GRID
     ═══════════════════════════════════════════════════════════════════════════ */
  .tools-page-main {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }

  /* ── 1. Hero Section (Dark Canvas #07080b) ────────────────────────────────── */
  .tools-hero-section {
    position: relative;
    background-color: #07080b;
    color: #f8f5ec;
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .tools-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .hero-watermark {
    position: absolute;
    top: 50%;
    right: -10%;
    transform: translateY(-50%);
    width: 60vw;
    max-width: 800px;
    height: 60vw;
    max-height: 800px;
    opacity: 0.035;
    pointer-events: none;
    z-index: 0;
    color: #ffffff;
  }

  .rotor-svg {
    width: 100%;
    height: 100%;
    animation: slowSpin 140s linear infinite;
  }

  @keyframes slowSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .tools-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(7, 8, 11, 0.95);
    z-index: 1;
  }

  /* ── Crosshairs (+) ───────────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 1.15rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
    user-select: none;
    z-index: 10;
  }

  .cross--tl { top: -0.6rem; left: -0.45rem; }
  .cross--tr { top: -0.6rem; right: -0.45rem; }
  .cross--bl { bottom: -0.6rem; left: -0.45rem; }
  .cross--br { bottom: -0.6rem; right: -0.45rem; }

  /* ── Blueprint Telemetry Bar ─────────────────────────────────────────────── */
  .blueprint-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.015);
  }

  .blueprint-meta-left,
  .blueprint-meta-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .blueprint-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 10px rgba(182, 255, 92, 0.7);
    animation: statusPulse 2s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .blueprint-mono {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  /* ── Band Row: Split Rail & Main Stage ───────────────────────────────────── */
  .band-row {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  @media (min-width: 900px) {
    .band-row {
      flex-direction: row;
    }
  }

  /* ── Left Rail Layout ─────────────────────────────────────────────────────── */
  .band-rail {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #07080b;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      width: 24%;
      min-width: 260px;
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      padding: 3rem 1.75rem;
    }
  }

  .rail-light {
    background: #f4efe4;
    border-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right: 1px solid rgba(7, 20, 21, 0.08);
    }
  }

  .rail-tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #f8f5ec;
    text-transform: uppercase;
  }

  .rail-tag--dark { color: #111113; }
  .rail-slash { color: #b6ff5c; margin-right: 0.35rem; }
  .rail-tag--dark .rail-slash { color: #4f7d18; }

  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .rail-spec-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .spec-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .spec-value {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .spec-detail {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  .tools-meta-note {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
  }

  .meta-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .meta-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #111113;
  }

  .meta-desc {
    font-size: 0.76rem;
    color: #475569;
    line-height: 1.4;
  }

  /* ── Rating Badge ─────────────────────────────────────────────────────────── */
  .rating-badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: fit-content;
  }

  .rating-star-box {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    color: #b6ff5c;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .rating-sub {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }

  /* ── Main Column Layout ───────────────────────────────────────────────────── */
  .band-main {
    padding: 2rem 1.5rem;
    flex: 1;
  }

  @media (min-width: 900px) {
    .band-main {
      padding: 3.5rem 3rem;
    }
  }

  .main-light { background-color: #faf9f5; }

  /* ── Hero Content ─────────────────────────────────────────────────────────── */
  .hero-header-wrap { max-width: 58rem; }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #b6ff5c;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2.3rem, 4.8vw, 4.2rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #f8f5ec;
    margin-bottom: 1.5rem;
  }

  .hero-highlight { color: #b6ff5c; }

  .hero-desc {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: #94a3b8;
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  /* ── Standards Strip ──────────────────────────────────────────────────────── */
  .hero-standards-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .hero-standards-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .standard-chip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
  }

  .chip-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .chip-sub {
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.35;
  }

  /* ── Hero Actions ─────────────────────────────────────────────────────────── */
  .hero-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-outline-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
    padding: 0.85rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background: transparent;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .hero-outline-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #b6ff5c;
    color: #b6ff5c;
  }

  /* ── 2. Toolkit Matrix Section (Light Canvas) ────────────────────────────── */
  .toolkit-matrix-section {
    position: relative;
    background-color: #f4efe4;
    color: #111113;
    padding: 2rem 1rem 0 1rem;
  }

  @media (min-width: 640px) {
    .toolkit-matrix-section {
      padding: 3rem 1.5rem 0 1.5rem;
    }
  }

  .toolkit-matrix-section .tools-container {
    background: #faf9f5;
    border-color: rgba(7, 20, 21, 0.08);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
  }

  .toolkit-matrix-section .grid-cross { color: rgba(7, 20, 21, 0.25); }

  .matrix-header-wrap {
    max-width: 52rem;
    margin-bottom: 2rem;
  }

  .matrix-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #4f7d18;
    margin-bottom: 0.85rem;
  }

  .matrix-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111113;
    margin-bottom: 1rem;
  }

  .matrix-desc {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.02rem;
    line-height: 1.6;
    color: #475569;
  }

  /* Discipline Filter Chips */
  .discipline-filters-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(7, 20, 21, 0.08);
  }

  .discipline-chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    border: 1px solid rgba(7, 20, 21, 0.1);
    padding: 0.45rem 0.85rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .discipline-chip-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .discipline-chip-btn.is-active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  .chip-count {
    opacity: 0.65;
    font-size: 0.68rem;
  }

  /* Tools Cards Grid */
  .tools-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 900px) {
    .tools-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .tools-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .architectural-tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.85rem;
    background: #ffffff;
    border: 1px solid rgba(7, 20, 21, 0.08);
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .architectural-tool-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.06);
    border-color: rgba(79, 125, 24, 0.4);
  }

  .tool-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.85rem;
    line-height: 1;
    color: rgba(7, 20, 21, 0.18);
    pointer-events: none;
    user-select: none;
  }

  .architectural-tool-card .cross--tl { top: 0.4rem; left: 0.5rem; }
  .architectural-tool-card .cross--tr { top: 0.4rem; right: 0.5rem; }
  .architectural-tool-card .cross--bl { bottom: 0.4rem; left: 0.5rem; }
  .architectural-tool-card .cross--br { bottom: 0.4rem; right: 0.5rem; }

  .tool-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .tool-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    font-weight: 700;
    color: #4f7d18;
    background: rgba(79, 125, 24, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .badge-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .tool-index-tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 700;
    color: #94a3b8;
  }

  /* Interactive Visual Media Frame */
  .tool-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    background: #07080b;
    border: 1px solid rgba(7, 20, 21, 0.08);
    display: block;
    text-decoration: none;
  }

  .tool-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.05);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .architectural-tool-card:hover .tool-card-img {
    transform: scale(1.06);
    filter: saturate(1.15) contrast(1.05);
  }

  .tool-card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 8, 11, 0) 40%, rgba(7, 8, 11, 0.65) 100%);
    pointer-events: none;
  }

  .tool-card-chip {
    position: absolute;
    bottom: 0.65rem;
    left: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(7, 8, 11, 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
    pointer-events: none;
    letter-spacing: 0.04em;
  }

  .chip-pulse-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 6px rgba(182, 255, 92, 0.8);
  }

  .tool-media-badge-zoom {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: rgba(7, 8, 11, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f8f5ec;
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .architectural-tool-card:hover .tool-media-badge-zoom {
    opacity: 1;
    transform: scale(1);
  }

  .tool-title-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .tool-icon-frame {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #0f172a;
    flex-shrink: 0;
  }

  .tool-icon-frame :global(svg) {
    width: 20px;
    height: 20px;
  }

  .tool-title-text {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.22rem;
    font-weight: 700;
    color: #111113;
    line-height: 1.2;
  }

  .tool-summary-text {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.88rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 1.25rem;
  }

  .tool-audience-box {
    padding: 0.75rem 0.95rem;
    background: #f8fafc;
    border-left: 3px solid #b6ff5c;
    border-radius: 0 4px 4px 0;
    margin-bottom: 1.25rem;
  }

  .audience-label {
    display: block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.58rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 0.2rem;
  }

  .audience-text {
    font-size: 0.78rem;
    line-height: 1.45;
    color: #334155;
    margin: 0;
  }

  .tool-deliverables-section {
    margin-bottom: 1.15rem;
  }

  .deliverables-label,
  .tech-label {
    display: block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 0.45rem;
  }

  .deliverables-chips,
  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .deliverable-pill {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.65rem;
    color: #1e293b;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .tool-tech-strip {
    margin-bottom: 1.25rem;
  }

  .tech-pill {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #475569;
    background: #f8fafc;
    border: 1px dashed rgba(7, 20, 21, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .tool-outcome-banner {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    font-weight: 600;
    color: #0f172a;
    background: #f1eee4;
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.45rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.25rem;
    margin-top: auto;
  }

  .outcome-icon { color: #4f7d18; font-weight: 700; }

  .tool-action-bar {
    padding-top: 1rem;
    border-top: 1px solid rgba(7, 20, 21, 0.08);
  }

  .tool-drilldown-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: #111113;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .tool-drilldown-link:hover {
    color: #4f7d18;
    transform: translateX(2px);
  }

  /* ── 3. Fit Matrix Section (Dark Canvas) ─────────────────────────────────── */
  .fit-matrix-section {
    position: relative;
    background-color: #07080b;
    color: #f8f5ec;
    padding: 2rem 1rem 0 1rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .fit-matrix-section {
      padding: 3rem 1.5rem 0 1.5rem;
    }
  }

  .fit-header-wrap {
    max-width: 52rem;
    margin-bottom: 2.75rem;
  }

  .fit-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #b6ff5c;
    margin-bottom: 0.85rem;
