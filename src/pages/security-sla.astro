---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Security Architecture & Service Level Agreement (SLA) — Kairav Studio"
  description="Kairav Studio security posture, 99.9% production uptime commitments, zero-trust infrastructure, automated incident response, and SLA remediation policies."
  canonicalPath="/security-sla"
>
  <main class="legal-page">

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. DARK BLUEPRINT HERO (#07080b)                                       */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="legal-hero-section" data-hero-section aria-label="Security and SLA Header">
      <div class="legal-container">
        
        {/* Top Telemetry Header Bar */}
        <div class="legal-telemetry-bar">
          <div class="telemetry-left">
            <span class="telemetry-text">SECURITY POSTURE &amp; SERVICE LEVEL AGREEMENT</span>
          </div>
          <div class="telemetry-right">
            <span class="telemetry-text">LAST AUDITED: 2026-10-10</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">YOGYAKARTA, ID</span>
          </div>
          <span class="grid-cross cross--tl" aria-hidden="true">+</span>
          <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        </div>

        {/* 24% / 76% Asymmetric Blueprint Band */}
        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Security Dossier
            </div>

            <div class="rail-live-badge">
              Continuous Hardening
            </div>

            <div class="dossier-card">
              <span class="dossier-label">PRODUCTION UPTIME TARGET</span>
              <span class="dossier-val font-accent">99.9% Availability SLA</span>
              <span class="dossier-desc">Backed by global edge CDN distribution, automated failover, and multi-region health checks.</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">SECURITY ARCHITECTURE</span>
              <span class="dossier-val font-accent">Zero-Trust &amp; Static-First</span>
              <span class="dossier-desc">Eliminating server-side attack surfaces via static generation, edge caching, and strict CSP policies.</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">INCIDENT RESPONSE</span>
              <span class="dossier-val">&lt; 1 Hour P1 Triage</span>
              <span class="dossier-desc">Rapid emergency engineering response for critical production outages or vulnerability reports.</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            
            <div class="legal-meta-top">
              <nav class="legal-breadcrumbs" aria-label="Breadcrumbs">
                <a href="/">Studio</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">Security &amp; SLA</span>
              </nav>

              <span class="legal-badge-pill">
                ACTIVE COMMITMENT
              </span>
            </div>

            <h1 class="legal-hero-title">
              Security Posture &amp; <span class="title-highlight">Service Level Agreement.</span>
            </h1>

            <p class="legal-hero-summary">
              We engineer digital systems built for resilience, deterministic performance, and zero runtime vulnerabilities. Our Service Level Agreement (SLA) guarantees high uptime, rapid incident remediation, and transparent security standards for all client deployments.
            </p>

            <div class="legal-action-row">
              <a href="/contact" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Initiate Project Intake</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </span>
              </a>

              <a href="/" class="hero-back-link">
                <span aria-hidden="true">←</span>
                <span>Return to Studio Home</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. SECURITY & SLA PROVISIONS (Light Canvas #f8f5ec)                     */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="policy-section" aria-label="Security and SLA Articles">
      <div class="legal-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Specifications
            </div>

            <div class="rail-pill">
              6 Core Commitments
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · RESILIENCE &amp; RELIABILITY FRAMEWORK</span>
              <h2 class="section-title">Enterprise Uptime, Zero-Trust Hardening &amp; SLA Guarantees.</h2>
              <p class="section-desc">
                Comprehensive engineering standards governing code security, production hosting reliability, scheduled maintenance, and incident triage.
              </p>
            </div>

            {/* Articles Stack */}
            <div class="articles-flow">
              
              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 01</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">99.9% Production Uptime SLA &amp; High Availability</h3>
                <p class="article-body">
                  For client digital products hosted via our recommended managed edge networks (Cloudflare, Vercel, AWS Edge), Kairav Studio commits to an operational availability target of 99.9% uptime per calendar month. This excludes pre-announced scheduled maintenance windows and upstream tier-1 ISP outages. In the event of an unscheduled outage exceeding our threshold, eligible clients on active maintenance retainers receive pro-rata service credits applied toward subsequent billing periods.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 02</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Zero-Trust Architecture &amp; Static-First Attack Surface Elimination</h3>
                <p class="article-body">
                  Our core architectural doctrine prioritizes Static Site Generation (SSG) with targeted island hydration over monolithic server-side rendering. By compiling production sites to static HTML, CSS, and immutable asset hashes, we eliminate traditional attack vectors such as SQL injections, server execution exploits, and database credential scraping at the edge. Every build incorporates strict Content Security Policies (CSP), HTTP Strict Transport Security (HSTS), and Subresource Integrity (SRI) headers.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 03</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Data Encryption Standards &amp; Zero Unnecessary Retention</h3>
                <p class="article-body">
                  All traffic to and from Kairav Studio infrastructure is encrypted in transit via modern TLS 1.3 cryptographic protocols with perfect forward secrecy. Sensitive credentials, API tokens, and client secrets are managed exclusively through hardware-backed secret managers (e.g. AWS KMS, Doppler, Cloudflare Secrets) and never committed to source repositories. We enforce a zero-bloat tracking policy: user data submitted through lead capture forms is never monetized, brokered, or shared with third-party tracking conglomerates.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 04</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Incident Severity Matrix &amp; Mean Time to Remediation (MTTR)</h3>
                <p class="article-body">
                  Production incidents are categorized into three structured severity tiers:
                  <br /><br />
                  <strong>• Severity 1 (Critical Outage):</strong> Complete system downtime or validated security vulnerability affecting active production environments. Initial engineer triage commences within <strong>&lt; 1 hour</strong>, with continuous hourly status dispatches until full service restoration.
                  <br />
                  <strong>• Severity 2 (Major Impairment):</strong> Non-critical functional degradation or performance anomalies where core user workflows remain partially accessible. Engineering triage within <strong>&lt; 4 hours</strong>.
                  <br />
                  <strong>• Severity 3 (Minor Defect):</strong> Cosmetic layout discrepancies or non-blocking edge-case defects. Triage and scheduled patch deployment within <strong>&lt; 24 business hours</strong>.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 05</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Vulnerability Disclosure &amp; Proactive Code Auditing</h3>
                <p class="article-body">
                  Kairav Studio operates an internal security review protocol led by engineers with offensive security and CTF backgrounds. Prior to production release, applications undergo automated dependency vulnerability audits (<code class="inline-code">npm audit</code>, Trivy, Dependabot) and manual logic verification. We welcome responsible vulnerability disclosures from security researchers and clients at <a href="mailto:hello@kairav.studio" class="inline-link">hello@kairav.studio</a>, with an initial acknowledgment SLA of 24 hours.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 06</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Disaster Recovery, Automated Rollbacks &amp; Backup Redundancy</h3>
                <p class="article-body">
                  All builds and infrastructure-as-code definitions are version-controlled in deterministic Git repositories. In the event of an unforeseen regression or edge corruption, our edge infrastructure supports instant, zero-downtime rollbacks with a Recovery Time Objective (RTO) of <strong>&lt; 60 seconds</strong>. For projects involving relational or document databases, automated nightly snapshots and WAL archiving guarantee a Recovery Point Objective (RPO) of <strong>&lt; 24 hours</strong>.
                </p>
              </article>

            </div>

            {/* Bottom Actions */}
            <div class="legal-bottom-nav">
              <a href="/terms" class="legal-sub-link">
                <span>Review Terms &amp; Conditions</span>
                <span aria-hidden="true">→</span>
              </a>

              <a href="/privacy-policy" class="legal-sub-link">
                <span>Review Privacy Policy</span>
                <span aria-hidden="true">→</span>
              </a>

              <a href="/contact" class="legal-sub-link font-accent-dark">
                <span>Initiate Engineering Discovery</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. BOTTOM CTA BANNER (Dark Obsidian #07080b)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="legal-cta-section" aria-label="Get in Touch">
      <div class="legal-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>

        <div class="cta-inner-box">
          <span class="cta-eyebrow">HARDENED SYSTEMS · ZERO RUNTIME VULNERABILITIES</span>
          <h2 class="cta-title">
            Build Your Digital Infrastructure on a <span class="cta-highlight">Resilient, Secure Foundation.</span>
          </h2>
          <p class="cta-desc">
            Need enterprise-grade SLAs, custom security reviews, or high-velocity development without operational bloat? Let’s schedule a technical discovery call.
          </p>

          <div class="cta-button-cluster">
            <a href="/contact" class="cta-primary-btn">
              <span>Initiate Project Intake</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="mailto:hello@kairav.studio?subject=Security%20%26%20SLA%20Inquiry%20-%20Kairav%20Studio"
              class="cta-outline-btn"
            >
              <span>Email Engineering Lead</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════ */
  /* SCOPED CLONIX ARCHITECTURAL BLUEPRINT DESIGN SYSTEM                         */
  /* ═══════════════════════════════════════════════════════════════════════════ */

  .legal-page {
    background-color: #07080b;
    color: #f8f5ec;
    font-family: var(--font-body, system-ui, sans-serif);
    overflow-x: hidden;
    position: relative;
  }

  /* ── Layout Containers & Clonix Hairlines ─────────────────────────────────── */
  .legal-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container-light {
    background-color: #f8f5ec;
    color: #111113;
    border-left-color: rgba(7, 20, 21, 0.08);
    border-right-color: rgba(7, 20, 21, 0.08);
  }

  /* ── Corner Crosshairs (+) ────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
    pointer-events: none;
    z-index: 10;
  }

  .container-light .grid-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross--tl { top: -6px; left: -5px; }
  .cross--tr { top: -6px; right: -5px; }
  .cross--bl { bottom: -6px; left: -5px; }
  .cross--br { bottom: -6px; right: -5px; }

  /* ── Hairline Dividers ────────────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    height: 1px;
    z-index: 2;
  }

  .divider-dark {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .divider-light {
    background-color: rgba(7, 20, 21, 0.08);
  }

  .divider-cross {
    position: absolute;
    top: -6px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
  }

  .divider-light .divider-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 24%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid {
      display: block;
    }
  }

  /* ── Band Row: 24% Left Rail / 76% Main Stage ─────────────────────────────── */
  .band-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .band-row {
      grid-template-columns: 24% 76%;
    }
  }

  .band-rail {
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      padding: 3rem 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: none;
    }
  }

  .rail-light {
    border-bottom-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right-color: rgba(7, 20, 21, 0.08);
    }
  }

  .band-main {
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 900px) {
    .band-main {
      padding: 3rem 3rem 4rem 3rem;
    }
  }

  /* ── Rail Components ──────────────────────────────────────────────────────── */
  .rail-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: inherit;
  }

  .rail-tag--dark {
    color: #111113;
  }

  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .dossier-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dossier-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .dossier-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .font-accent {
    color: #b6ff5c;
  }

  .dossier-desc {
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* ── 1. Hero Section ──────────────────────────────────────────────────────── */
  .legal-hero-section {
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    background-color: #07080b;
  }

  @media (min-width: 900px) {
    .legal-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .legal-telemetry-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }

  .telemetry-left,
  .telemetry-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .legal-meta-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .legal-breadcrumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.75rem;
    color: #64748b;
  }

  .legal-breadcrumbs a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .legal-breadcrumbs a:hover {
    color: #b6ff5c;
  }

  .crumb-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .crumb-current {
    color: #f8f5ec;
    font-weight: 600;
  }

  .legal-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #b6ff5c;
    background: rgba(182, 255, 92, 0.06);
    border: 1px solid rgba(182, 255, 92, 0.2);
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
  }

  .legal-hero-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2.2rem, 4.8vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .title-highlight {
    color: #b6ff5c;
  }

  .legal-hero-summary {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 820px;
    margin-bottom: 2.25rem;
  }

  .legal-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .clonix-cta-button {
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    background-color: #b6ff5c;
    color: #07080b;
    border: none;
    padding: 3px 3px 3px 18px;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(182, 255, 92, 0.25);
    transition: transform 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }

  .clonix-cta-button:hover {
    background-color: #c9ff7a;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(182, 255, 92, 0.4);
  }

  .clonix-cta-button__text {
    padding-right: 14px;
    color: #07080b;
  }

  .clonix-cta-button__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: #07080b;
    color: #ffffff;
    border-radius: 3px;
    transition: transform 200ms ease;
  }

  .clonix-cta-button:hover .clonix-cta-button__box {
    transform: translateX(2px);
  }

  .hero-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

