---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Container from "../../components/common/Container.astro";
import CTASection from "../../components/sections/CTASection.astro";
import { services } from "../../data/services";
import type { Service } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const related = services.filter((item) => item.id !== service.id);
const canonicalPath = `/tools/${service.id}`;
const canonicalUrl = `https://kairav.studio${canonicalPath}`;

/* ── Structured data for SEO + GEO (docs/guide.md §GEO Theme Rules) ── */
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.whatItIs,
  url: canonicalUrl,
  provider: {
    "@type": "Organization",
    name: "Kairav Studio",
    url: "https://kairav.studio",
  },
  areaServed: "Worldwide",
  audience: { "@type": "Audience", audienceType: service.whoItsFor },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${service.title} - Kairav Studio`}
  description={service.summary}
  canonicalPath={canonicalPath}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <main class="service-detail" style={`--accent: ${service.accent};`}>
    {/* ── Hero ── */}
    <section class="relative overflow-hidden border-b border-[var(--color-border)] py-20 sm:py-24">
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full opacity-[0.16] blur-3xl"
        style={`background: ${service.accent};`}
        aria-hidden="true"
      >
      </div>
      <Container>
        <p class="mb-5 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          <a href="/tools" class="link-accent">Tools</a> / {service.category}
        </p>
        <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:items-start">
          <div class="service-detail__icon" aria-hidden="true">
            <Fragment set:html={service.icon} />
          </div>
          <div class="max-w-3xl">
            <div class="mb-5 flex flex-wrap gap-2">
              {service.tags.map((tag) => <Badge>{tag}</Badge>)}
            </div>
            <h1 class="font-heading text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl lg:text-6xl">
              {service.title}
            </h1>
            <p class="mt-6 text-base leading-8 text-[var(--color-text-soft)] sm:text-lg">
              {service.summary}
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="/contact">Start a project</Button>
              <Button href="/tools" variant="secondary">All tools</Button>
            </div>
          </div>
        </div>
      </Container>
    </section>

    {/* ── What it is / Who it's for ── */}
    <section class="section-spacing">
      <Container>
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="card-surface p-7">
            <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">What it is</p>
            <p class="mt-4 leading-7 text-[var(--color-text-soft)]">{service.whatItIs}</p>
          </article>
          <article class="card-surface p-7">
            <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Who it's for</p>
            <p class="mt-4 leading-7 text-[var(--color-text-soft)]">{service.whoItsFor}</p>
          </article>
        </div>
      </Container>
    </section>

    {/* ── Problem it solves ── */}
    <section class="section-spacing pt-0">
      <Container>
        <div class="problem-panel p-7 sm:p-10">
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">The problem</p>
          <p class="mt-4 max-w-3xl font-heading text-2xl font-medium leading-snug text-[var(--color-text)] sm:text-3xl">
            {service.problem}
          </p>
        </div>
      </Container>
    </section>

    {/* ── What's included ── */}
    <section class="section-spacing bg-[var(--color-background-soft)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div class="max-w-sm">
            <p class="mb-3 font-mono text-xs font-semibold uppercase text-[var(--color-primary)]">What's included</p>
            <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
              Deliverables you can expect.
            </h2>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {service.deliverables.map((item) => (
              <li class="card-surface flex items-start gap-3 p-5">
                <span class="deliverable-dot" aria-hidden="true"></span>
                <span class="text-sm leading-6 text-[var(--color-text-soft)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>

    {/* ── Tech direction ── */}
    <section class="section-spacing">
      <Container>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Tech direction</p>
          <div class="flex flex-wrap gap-2">
            {service.techDirection.map((tech) => <span class="tag-muted">{tech}</span>)}
          </div>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-6 text-[var(--color-text-muted)]">
          Stacks are chosen per project. These are the typical tools we reach for first when delivering this capability.
        </p>
      </Container>
    </section>

    {/* ── How it works ── */}
    <section class="section-spacing pt-0">
      <Container>
        <p class="mb-3 font-mono text-xs font-semibold uppercase text-[var(--color-primary)]">How it works</p>
        <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
          A clear, reviewable process.
        </h2>
        <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {service.process.map((step, index) => (
            <li class="card-surface flex h-full flex-col p-6">
              <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-4 font-heading text-lg font-semibold text-[var(--color-text)]">{step.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-soft)]">{step.detail}</p>
            </li>
          ))}
        </ol>
      </Container>
    </section>

    {/* ── Expected outcome ── */}
    <section class="section-spacing pt-0">
      <Container>
        <div class="outcome-panel p-7 sm:p-10">
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Expected outcome</p>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-[var(--color-text)] sm:text-xl">
            {service.outcome}
          </p>
        </div>
      </Container>
    </section>

    {/* ── FAQ ── */}
    <section class="section-spacing bg-[var(--color-background-soft)] pt-0">
      <Container>
        <p class="mb-3 font-mono text-xs font-semibold uppercase text-[var(--color-primary)]">FAQ</p>
        <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
          Common questions.
        </h2>
        <div class="mt-8 grid max-w-3xl gap-3">
          {service.faq.map((item) => (
            <details class="faq-item card-surface">
              <summary class="faq-summary">
                <span>{item.q}</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <p class="faq-answer">{item.a}</p>
            </details>
          ))}
        </div>
      </Container>
    </section>

    {/* ── Related capabilities ── */}
    <section class="section-spacing">
      <Container>
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-heading text-2xl font-semibold text-[var(--color-text)] sm:text-3xl">
            Other capabilities
          </h2>
          <a href="/tools" class="link-accent font-brand text-[0.65rem] tracking-wider">VIEW ALL TOOLS →</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <a href={`/tools/${item.id}`} class="related-card card-surface group flex items-center gap-4 p-5" style={`--accent: ${item.accent};`}>
              <span class="related-card__icon" aria-hidden="true" set:html={item.icon} />
              <span class="min-w-0">
                <span class="block font-heading text-base font-semibold text-[var(--color-text)] transition-colors group-hover:text-[var(--color-primary)]">{item.title}</span>
                <span class="mt-1 block font-mono text-[0.62rem] uppercase tracking-wider text-[var(--color-text-muted)]">{item.category}</span>
              </span>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <CTASection
      eyebrow="Start a project"
      title={`Ready to start with ${service.title.toLowerCase()}?`}
      description="Bring the goal or the rough idea. We will shape it into a clear, fast, and maintainable build."
    />
  </main>
</BaseLayout>

<style>
  .service-detail__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }
  .service-detail__icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  /* Problem panel — quiet, bordered emphasis */
  .problem-panel {
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)), var(--color-surface);
  }

  .deliverable-dot {
    margin-top: 0.4rem;
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
  }

  /* Outcome — accent-tinted highlight */
  .outcome-panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  /* FAQ accordion */
  .faq-item {
    overflow: hidden;
    padding: 0;
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 240ms ease, color 240ms ease;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }
  .faq-answer {
    padding: 0 1.25rem 1.2rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-soft);
  }

  /* Related capability cards */
  .related-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .related-card__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
  }
</style>
