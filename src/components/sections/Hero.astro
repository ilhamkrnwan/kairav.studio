<script is:inline>
  const setupHeroVideo = () => {
    const playBtn = document.getElementById("hero-video-play-btn");
    if (!playBtn) return;
    if (playBtn.dataset.listenerAttached) return;
    playBtn.dataset.listenerAttached = "true";

    playBtn.addEventListener("click", () => {
      // Smooth trigger for reel or contact discussion
      window.location.href = "/works";
    });
  };

  document.addEventListener("DOMContentLoaded", setupHeroVideo);
  document.addEventListener("astro:page-load", setupHeroVideo);
</script>
