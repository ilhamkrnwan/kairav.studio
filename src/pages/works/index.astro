    transform: translateX(3px);
  }

  .row-hover-banner {
    display: none;
  }

  /* ── 4. All Projects Gallery Grid ─────────────────────────────────────────── */
  .gallery-main {
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 768px) {
    .gallery-main {
      padding: 3.5rem 3rem;
    }
  }

  .gallery-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .gallery-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  .project-tile-card {
    background-color: #ffffff;
    border: 1px solid rgba(7, 20, 21, 0.1);
    border-radius: 4px;
