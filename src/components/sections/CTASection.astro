---
import Button from "../common/Button.astro";
import Container from "../common/Container.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = "Start a Project",
  title = "Have a website, product, or workflow idea?",
  description = "Let's shape it into a clear, fast, and maintainable digital experience.",
} = Astro.props;
---

<section class="section-spacing">
  <Container>
    <div class="cta-panel p-7 sm:p-10 lg:p-12">
      <div class="max-w-2xl">
        <p class="font-mono text-xs font-semibold uppercase text-[var(--color-primary)]">{eyebrow}</p>
        <h2 class="mt-3 font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
          {title}
        </h2>
        <p class="mt-4 text-base leading-7 text-[var(--color-text-soft)]">{description}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact">Contact Us</Button>
        <Button href="/works" variant="secondary">View Works</Button>
      </div>
    </div>
  </Container>
</section>
