---
interface Props {
  color1?: string;
  color2?: string;
  color3?: string;
  timeSpeed?: number;
  colorBalance?: number;
  warpStrength?: number;
  warpFrequency?: number;
  warpSpeed?: number;
  warpAmplitude?: number;
  blendAngle?: number;
  blendSoftness?: number;
  rotationAmount?: number;
  noiseScale?: number;
  grainAmount?: number;
  grainScale?: number;
  grainAnimated?: boolean;
  contrast?: number;
  gamma?: number;
  saturation?: number;
  centerX?: number;
  centerY?: number;
  zoom?: number;
  class?: string;
}

const {
  color1 = "#b6ff5c",
  color2 = "#080c09",
  color3 = "#243c14",
  timeSpeed = 0.22,
  colorBalance = 0.0,
  warpStrength = 1.0,
  warpFrequency = 4.5,
  warpSpeed = 1.6,
  warpAmplitude = 50.0,
  blendAngle = 10.0,
  blendSoftness = 0.08,
  rotationAmount = 450.0,
  noiseScale = 2.0,
  grainAmount = 0.09,
  grainScale = 2.5,
  grainAnimated = false,
  contrast = 1.35,
  gamma = 1.0,
  saturation = 1.05,
  centerX = 0.0,
  centerY = 0.0,
  zoom = 0.95,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["grainient-canvas-container", className]}
  data-grainient-canvas
  data-color1={color1}
  data-color2={color2}
  data-color3={color3}
  data-time-speed={timeSpeed}
  data-color-balance={colorBalance}
  data-warp-strength={warpStrength}
  data-warp-frequency={warpFrequency}
  data-warp-speed={warpSpeed}
  data-warp-amplitude={warpAmplitude}
  data-blend-angle={blendAngle}
  data-blend-softness={blendSoftness}
  data-rotation-amount={rotationAmount}
  data-noise-scale={noiseScale}
  data-grain-amount={grainAmount}
  data-grain-scale={grainScale}
  data-grain-animated={grainAnimated ? "true" : "false"}
  data-contrast={contrast}
  data-gamma={gamma}
  data-saturation={saturation}
  data-center-x={centerX}
  data-center-y={centerY}
  data-zoom={zoom}
  aria-hidden="true"
>
</div>

<style>
  .grainient-canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .grainient-canvas-container :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
</style>

<script>
  import { Renderer, Program, Mesh, Triangle } from 'ogl';

  const hexToRgb = (hex: string): [number, number, number] => {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (!result) return [0.03, 0.05, 0.04];
    return [
      parseInt(result[1], 16) / 255,
      parseInt(result[2], 16) / 255,
      parseInt(result[3], 16) / 255,
    ];
  };

  const vertexShader = `#version 300 es
in vec2 position;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

  const fragmentShader = `#version 300 es
precision highp float;
uniform vec2 iResolution;
uniform float iTime;
uniform float uTimeSpeed;
uniform float uColorBalance;
uniform float uWarpStrength;
uniform float uWarpFrequency;
uniform float uWarpSpeed;
uniform float uWarpAmplitude;
uniform float uBlendAngle;
uniform float uBlendSoftness;
uniform float uRotationAmount;
uniform float uNoiseScale;
uniform float uGrainAmount;
uniform float uGrainScale;
uniform float uGrainAnimated;
uniform float uContrast;
uniform float uGamma;
uniform float uSaturation;
uniform vec2 uCenterOffset;
uniform float uZoom;
uniform vec3 uColor1;
uniform vec3 uColor2;
uniform vec3 uColor3;
out vec4 fragColor;

#define S(a,b,t) smoothstep(a,b,t)

mat2 Rot(float a) {
  float s = sin(a), c = cos(a);
  return mat2(c, -s, s, c);
}

vec2 hash(vec2 p) {
  p = vec2(dot(p, vec2(2127.1, 81.17)), dot(p, vec2(1269.5, 283.37)));
  return fract(sin(p) * 43758.5453);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float n = mix(
    mix(dot(-1.0 + 2.0 * hash(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0)),
        dot(-1.0 + 2.0 * hash(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)), u.x),
    mix(dot(-1.0 + 2.0 * hash(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
        dot(-1.0 + 2.0 * hash(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)), u.x),
    u.y
  );
  return 0.5 + 0.5 * n;
}

void mainImage(out vec4 o, vec2 C) {
  float t = iTime * uTimeSpeed;
  vec2 uv = C / iResolution.xy;
  float ratio = iResolution.x / iResolution.y;
  vec2 tuv = uv - 0.5 + uCenterOffset;
  tuv /= max(uZoom, 0.001);

  float degree = noise(vec2(t * 0.1, tuv.x * tuv.y) * uNoiseScale);
  tuv.y *= 1.0 / ratio;
  tuv *= Rot(radians((degree - 0.5) * uRotationAmount + 180.0));
  tuv.y *= ratio;

  float frequency = uWarpFrequency;
  float ws = max(uWarpStrength, 0.001);
  float amplitude = uWarpAmplitude / ws;
  float warpTime = t * uWarpSpeed;
  tuv.x += sin(tuv.y * frequency + warpTime) / amplitude;
  tuv.y += sin(tuv.x * (frequency * 1.5) + warpTime) / (amplitude * 0.5);

  vec3 colLav = uColor1;
  vec3 colOrg = uColor2;
  vec3 colDark = uColor3;
  float b = uColorBalance;
  float s = max(uBlendSoftness, 0.0);
  mat2 blendRot = Rot(radians(uBlendAngle));
  float blendX = (tuv * blendRot).x;
  float edge0 = -0.3 - b - s;
  float edge1 = 0.2 - b + s;
  float v0 = 0.5 - b + s;
  float v1 = -0.3 - b - s;
  vec3 layer1 = mix(colDark, colOrg, S(edge0, edge1, blendX));
  vec3 layer2 = mix(colOrg, colLav, S(edge0, edge1, blendX));
  vec3 col = mix(layer1, layer2, S(v0, v1, tuv.y));

  vec2 grainUv = uv * max(uGrainScale, 0.001);
  if (uGrainAnimated > 0.5) {
    grainUv += vec2(iTime * 0.05);
  }
  float grain = fract(sin(dot(grainUv, vec2(12.9898, 78.233))) * 43758.5453);
  col += (grain - 0.5) * uGrainAmount;

  col = (col - 0.5) * uContrast + 0.5;
  float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
  col = mix(vec3(luma), col, uSaturation);
  col = pow(max(col, 0.0), vec3(1.0 / max(uGamma, 0.001)));
  col = clamp(col, 0.0, 1.0);

  o = vec4(col, 1.0);
}

void main() {
  vec4 o = vec4(0.0);
  mainImage(o, gl_FragCoord.xy);
  fragColor = o;
}
`;

  interface GrainientInstance {
    destroy: () => void;
  }

  const activeInstances = new Map<HTMLElement, GrainientInstance>();

  function initGrainient(container: HTMLElement) {
    if (activeInstances.has(container)) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Read dataset props
    const ds = container.dataset;
    const timeSpeed = parseFloat(ds.timeSpeed || '0.22');
    const colorBalance = parseFloat(ds.colorBalance || '0.0');
    const warpStrength = parseFloat(ds.warpStrength || '1.0');
    const warpFrequency = parseFloat(ds.warpFrequency || '4.5');
    const warpSpeed = parseFloat(ds.warpSpeed || '1.6');
    const warpAmplitude = parseFloat(ds.warpAmplitude || '50.0');
    const blendAngle = parseFloat(ds.blendAngle || '10.0');
    const blendSoftness = parseFloat(ds.blendSoftness || '0.08');
    const rotationAmount = parseFloat(ds.rotationAmount || '450.0');
    const noiseScale = parseFloat(ds.noiseScale || '2.0');
    const grainAmount = parseFloat(ds.grainAmount || '0.09');
    const grainScale = parseFloat(ds.grainScale || '2.5');
    const grainAnimated = ds.grainAnimated === 'true';
    const contrast = parseFloat(ds.contrast || '1.35');
    const gamma = parseFloat(ds.gamma || '1.0');
    const saturation = parseFloat(ds.saturation || '1.05');
    const centerX = parseFloat(ds.centerX || '0.0');
    const centerY = parseFloat(ds.centerY || '0.0');
    const zoom = parseFloat(ds.zoom || '0.95');

    const c1 = hexToRgb(ds.color1 || '#b6ff5c');
    const c2 = hexToRgb(ds.color2 || '#080c09');
    const c3 = hexToRgb(ds.color3 || '#243c14');

    let renderer: Renderer | null = null;
    try {
      renderer = new Renderer({
        webgl: 2,
        alpha: true,
        antialias: false,
        dpr: Math.min(window.devicePixelRatio || 1, 1.5),
      });
    } catch (e) {
      console.warn('WebGL2 not available for Grainient background', e);
      return;
    }

    const gl = renderer.gl;
    const canvas = gl.canvas as HTMLCanvasElement;
    container.appendChild(canvas);

    const geometry = new Triangle(gl);
    const program = new Program(gl, {
      vertex: vertexShader,
      fragment: fragmentShader,
      uniforms: {
        iTime: { value: 0 },
        iResolution: { value: new Float32Array([1, 1]) },
        uTimeSpeed: { value: timeSpeed },
        uColorBalance: { value: colorBalance },
        uWarpStrength: { value: warpStrength },
        uWarpFrequency: { value: warpFrequency },
        uWarpSpeed: { value: warpSpeed },
        uWarpAmplitude: { value: warpAmplitude },
        uBlendAngle: { value: blendAngle },
        uBlendSoftness: { value: blendSoftness },
        uRotationAmount: { value: rotationAmount },
        uNoiseScale: { value: noiseScale },
        uGrainAmount: { value: grainAmount },
        uGrainScale: { value: grainScale },
        uGrainAnimated: { value: grainAnimated ? 1.0 : 0.0 },
        uContrast: { value: contrast },
        uGamma: { value: gamma },
        uSaturation: { value: saturation },
        uCenterOffset: { value: new Float32Array([centerX, centerY]) },
        uZoom: { value: zoom },
        uColor1: { value: new Float32Array(c1) },
        uColor2: { value: new Float32Array(c2) },
        uColor3: { value: new Float32Array(c3) },
      },
    });

    const mesh = new Mesh(gl, { geometry, program });

    const setSize = () => {
      const rect = container.getBoundingClientRect();
      const width = Math.max(1, Math.floor(rect.width));
      const height = Math.max(1, Math.floor(rect.height));
      renderer?.setSize(width, height);
      const res = (program.uniforms.iResolution as { value: Float32Array }).value;
      res[0] = gl.drawingBufferWidth;
      res[1] = gl.drawingBufferHeight;
    };

    const ro = new ResizeObserver(setSize);
    ro.observe(container);
    setSize();

    let raf = 0;
    let isVisible = false;
    const t0 = performance.now();

    const loop = (t: number) => {
      if (!isVisible) return;
      (program.uniforms.iTime as { value: number }).value = (t - t0) * 0.001;
      renderer?.render({ scene: mesh });
      if (!prefersReducedMotion) {
        raf = requestAnimationFrame(loop);
      }
    };

    // IntersectionObserver to only animate when footer is in view
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            isVisible = true;
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(loop);
          } else {
            isVisible = false;
            cancelAnimationFrame(raf);
          }
        });
      },
      { threshold: 0.01 }
    );
    io.observe(container);

    const destroy = () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      try {
        if (canvas.parentNode === container) {
          container.removeChild(canvas);
        }
      } catch {
        // Ignore
      }
      activeInstances.delete(container);
    };

    activeInstances.set(container, { destroy });
  }

  function setupAllGrainients() {
    document.querySelectorAll<HTMLElement>('[data-grainient-canvas]').forEach((el) => {
      initGrainient(el);
    });
  }

  document.addEventListener('DOMContentLoaded', setupAllGrainients);
  document.addEventListener('astro:page-load', setupAllGrainients);
  document.addEventListener('astro:before-swap', () => {
    activeInstances.forEach((inst) => inst.destroy());
    activeInstances.clear();
  });
  setupAllGrainients();
</script>
