  .tag-hash { color: #b6ff5c; font-weight: 700; }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-back-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.8rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-back-btn:hover { color: #f8f5ec; }

  /* ── Hairline Dividers ────────────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    width: 100%;
    height: 1px;
    z-index: 2;
  }

  .divider-dark { background-color: rgba(255, 255, 255, 0.08); }
  .divider-light { background-color: rgba(7, 20, 21, 0.08); }

  .divider-cross {
    position: absolute;
    top: -7px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    user-select: none;
  }

  .divider-dark .divider-cross { color: rgba(255, 255, 255, 0.25); }
  .divider-light .divider-cross { color: rgba(7, 20, 21, 0.35); }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 24%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid { display: block; }
  }

  /* ── Section Headers ──────────────────────────────────────────────────────── */
  .section-header-wrap { margin-bottom: 2.5rem; }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4f7d18;
    margin-bottom: 0.75rem;
  }

  .arsenal-section .section-eyebrow,
  .related-tools-section .section-eyebrow {
    color: #b6ff5c;
  }

  .section-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #111113;
    margin: 0 0 1rem 0;
  }

  .text-light { color: #f8f5ec; }
  .text-muted { color: #94a3b8; }

  .section-desc {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.02rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
    max-width: 52rem;
  }

  /* ── 2. Mandate Section (Light Canvas) ────────────────────────────────────── */
  .mandate-section {
    position: relative;
    background-color: #f8f5ec;
    padding: 0 1rem;
  }

