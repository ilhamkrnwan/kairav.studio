---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyChooseSection from "../components/sections/WhyChooseSection.astro";
import ServicesNumbersSection from "../components/sections/ServicesNumbersSection.astro";
import AboutTimelineAwardsSection from "../components/sections/AboutTimelineAwardsSection.astro";
import ProjectsShowcaseSection from "../components/sections/ProjectsShowcaseSection.astro";
import TestimonialsCompaniesSection from "../components/sections/TestimonialsCompaniesSection.astro";
import FaqAccordionSection from "../components/sections/FaqAccordionSection.astro";
---

<BaseLayout
  title="Kairav Studio - Design-led Technology Studio"
  description="Kairav Studio builds modern brand websites, SEO/GEO-ready content architecture, and scalable digital systems for businesses that care about design, performance, and clarity."
>
  <main>
    {/* ── 1. Hero ─────────────────────────────────────────────────────── */}
    <Hero />

    {/* ── 2. Why Choose Us / Strategy & Approach ──────────────────────── */}
    <WhyChooseSection />

    {/* ── 3. Services & Our Numbers ───────────────────────────────────── */}
    <ServicesNumbersSection />

    {/* ── 4. About Us, Founder & Awards ───────────────────────────────── */}
    <AboutTimelineAwardsSection />

    {/* ── 5. Our Projects & Featured Showcase ─────────────────────────── */}
    <ProjectsShowcaseSection />

    {/* ── 6. Testimonials & Trusted Companies ─────────────────────────── */}
    <TestimonialsCompaniesSection />

    {/* ── 7. Category FAQ Accordion ───────────────────────────────────── */}
    <FaqAccordionSection />
  </main>
</BaseLayout>

