---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class="mb-3 font-mono text-xs font-semibold uppercase text-[var(--color-primary)]">{eyebrow}</p>}
  <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 text-base leading-7 text-[var(--color-text-soft)] sm:text-lg">
        {description}
      </p>
    )
  }
</div>
