<script>
  // Dynamic Studio Clock & Interactive Form Logic
  const initContactPage = () => {
    // 1. Live Studio Clock (Yogyakarta WIB = UTC+7)
    const clockEl = document.getElementById("studio-live-clock");
    const updateClock = () => {
      if (!clockEl) return;
      try {
        const now = new Date();
        const options: Intl.DateTimeFormatOptions = {
          timeZone: "Asia/Jakarta",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
        };
        const formatter = new Intl.DateTimeFormat("en-GB", options);
        clockEl.textContent = `${formatter.format(now)} WIB`;
      } catch (e) {
        // Fallback
        const now = new Date();
        clockEl.textContent = `${now.toLocaleTimeString()} WIB`;
      }
    };
    updateClock();
    const clockInterval = setInterval(updateClock, 1000);

    // 2. Clipboard Copy Buttons
    const copyButtons = document.querySelectorAll("[data-clipboard]");
    copyButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const textToCopy = btn.getAttribute("data-clipboard");
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          const originalText = btn.innerHTML;
          btn.innerHTML = `<span style="color:#b6ff5c; font-weight:700;">✓ Copied!</span>`;
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 2000);
        } catch (err) {
          console.error("Clipboard copy failed", err);
        }
      });
    });

    // 3. Interactive Service Chips Selection (Multi-select)
    const serviceChips = document.querySelectorAll(".service-chip-btn");
    const hiddenServicesInput = document.getElementById("hidden-services-input") as HTMLInputElement | null;
    const selectedServicesSet = new Set<string>();

    serviceChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const label = chip.getAttribute("data-service-label") || "";
        const isCurrentActive = chip.classList.contains("is-active");

        if (isCurrentActive) {
          chip.classList.remove("is-active");
          chip.setAttribute("aria-pressed", "false");
          selectedServicesSet.delete(label);
        } else {
          chip.classList.add("is-active");
          chip.setAttribute("aria-pressed", "true");
          selectedServicesSet.add(label);
        }

        if (hiddenServicesInput) {
          hiddenServicesInput.value = Array.from(selectedServicesSet).join(", ");
        }
      });
    });

    // 4. Interactive Timeline Pills (Single-select)
    const timelinePills = document.querySelectorAll(".timeline-pill-btn");
    const hiddenTimelineInput = document.getElementById("hidden-timeline-input") as HTMLInputElement | null;

    timelinePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        timelinePills.forEach((p) => {
          p.classList.remove("is-selected");
          p.setAttribute("aria-checked", "false");
        });
        pill.classList.add("is-selected");
        pill.setAttribute("aria-checked", "true");

        const label = pill.getAttribute("data-timeline-label") || "";
        if (hiddenTimelineInput) {
          hiddenTimelineInput.value = label;
        }
      });
    });

    // 5. Interactive Budget Pills (Single-select)
    const budgetPills = document.querySelectorAll(".budget-pill-btn");
    const hiddenBudgetInput = document.getElementById("hidden-budget-input") as HTMLInputElement | null;

    budgetPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        budgetPills.forEach((p) => {
          p.classList.remove("is-selected");
          p.setAttribute("aria-checked", "false");
        });
        pill.classList.add("is-selected");
        pill.setAttribute("aria-checked", "true");

        const label = pill.getAttribute("data-budget-label") || "";
        if (hiddenBudgetInput) {
          hiddenBudgetInput.value = label;
        }
      });
    });

    // 6. WhatsApp Compose Generator
    const whatsappBtn = document.getElementById("whatsapp-dispatch-btn");
    whatsappBtn?.addEventListener("click", () => {
      const nameInput = document.getElementById("contact-name") as HTMLInputElement | null;
      const emailInput = document.getElementById("contact-email") as HTMLInputElement | null;
      const notesInput = document.getElementById("contact-notes") as HTMLTextAreaElement | null;
      const companyInput = document.getElementById("contact-company") as HTMLInputElement | null;

      const services = Array.from(selectedServicesSet).join(", ") || "General Inquiry";
      const timeline = hiddenTimelineInput?.value || "Standard";
      const budget = hiddenBudgetInput?.value || "Discuss Scope";
      const name = nameInput?.value || "Prospective Client";
      const email = emailInput?.value || "-";
      const company = companyInput?.value ? ` (${companyInput.value})` : "";
      const notes = notesInput?.value || "Looking forward to discussing our project.";

      const messageText = `Hi Kairav Studio!

*Project Inquiry:*
- *Name:* ${name}${company}
- *Email:* ${email}
- *Disciplines:* ${services}
- *Timeline:* ${timeline}
- *Budget Range:* ${budget}

*Brief / Notes:*
${notes}`;

      const waUrl = `https://wa.me/6282241907338?text=${encodeURIComponent(messageText)}`;
      window.open(waUrl, "_blank", "noopener,noreferrer");
    });

    // 7. Form Submission Handler & Feedback
    const form = document.getElementById("kairav-project-form") as HTMLFormElement | null;
    const alertBanner = document.getElementById("form-feedback-alert");

    form?.addEventListener("submit", () => {
      // Let mailto fire or preventDefault if we prefer direct confirmation
      if (alertBanner) {
        alertBanner.style.display = "flex";
        alertBanner.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });

    // 8. FAQ Accordion Handler
    const faqRows = document.querySelectorAll(".faq-item-row");
    faqRows.forEach((row) => {
      const trigger = row.querySelector("[data-faq-trigger]");
      trigger?.addEventListener("click", () => {
        const isCurrentlyExpanded = row.classList.contains("is-expanded");
        
        // Optional accordion behavior: collapse others
        faqRows.forEach((r) => {
          r.classList.remove("is-expanded");
          const t = r.querySelector("[data-faq-trigger]");
          t?.setAttribute("aria-expanded", "false");
          const icon = r.querySelector(".faq-toggle-icon");
          if (icon) icon.textContent = "+";
        });

        if (!isCurrentlyExpanded) {
          row.classList.add("is-expanded");
          trigger.setAttribute("aria-expanded", "true");
          const icon = row.querySelector(".faq-toggle-icon");
          if (icon) icon.textContent = "×";
        }
      });
    });

    // Cleanup interval on page unload (for ClientRouter)
    document.addEventListener(
      "astro:before-swap",
      () => {
        clearInterval(clockInterval);
      },
      { once: true }
    );
  };

  // Support Astro ClientRouter page transitions
  document.addEventListener("astro:page-load", initContactPage);
</script>
