---
import Container from "../common/Container.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, description, image = "/hero-works.png", imageAlt } = Astro.props;
---

<section class="page-hero">
  {/* ── Top Boundary Line ── */}
  <div class="page-hero__rule" aria-hidden="true"></div>

  <div class="page-hero__body">
    {/* Background Grid, Low Opacity Hero Image & Ambient Lime Glow */}
    <div class="page-hero__bg" aria-hidden="true">
      {
        image && (
          <img
            src={image}
            alt=""
            loading="eager"
            class="page-hero__bg-img"
          />
        )
      }
      <div class="page-hero__glow"></div>
      <div class="page-hero__grid"></div>
    </div>

    <Container>
      <div class="page-hero__inner">
        {
          eyebrow && (
            <div class="page-hero__meta">
              <span class="page-hero__pill">
                <span class="page-hero__pill-dot"></span>
                // {eyebrow.toUpperCase()}
              </span>
            </div>
          )
        }

        <h1 class="page-hero__title">
          {title}
        </h1>

        {
          description && (
            <p class="page-hero__description">
              {description}
            </p>
          )
        }
      </div>
    </Container>
  </div>

  {/* ── Bottom Section Divider ── */}
  <div class="page-hero__divider" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    position: relative;
    background-color: #060608;
    color: #f8f5ec;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Top Boundary Line ────────────────────────────────────────────── */
  .page-hero__rule {
    height: 1px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 20%,
      rgba(182, 255, 92, 0.4) 50%,
      rgba(255, 255, 255, 0.08) 80%,
      transparent 100%
    );
  }

  /* ── Main Hero Container (Uniform 50vh Height across all static pages) ── */
  .page-hero__body {
    position: relative;
    overflow: hidden;
    height: 50vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.25rem;
  }

  @media (min-width: 640px) {
    .page-hero__body {
      height: 50vh;
      min-height: 420px;
      padding: 3rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .page-hero__body {
      height: 50vh;
      min-height: 450px;
      padding: 3.5rem 2.5rem;
    }
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  /* Low Opacity Hero Background Image */
  .page-hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.2;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    mask-image: radial-gradient(
      ellipse 85% 85% at 50% 50%,
      black 20%,
      rgba(0, 0, 0, 0.4) 65%,
      transparent 90%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 85% 85% at 50% 50%,
      black 20%,
      rgba(0, 0, 0, 0.4) 65%,
      transparent 90%
    );
  }

  /* Lime spotlight ambient glow */
  .page-hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 65% 75% at 50% 85%,
      rgba(182, 255, 92, 0.14) 0%,
      rgba(182, 255, 92, 0.04) 45%,
      transparent 75%
    );
  }

  /* Technical Grid Lines */
  .page-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 80%,
      black 25%,
      rgba(0, 0, 0, 0.4) 60%,
      transparent 85%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 80%,
      black 25%,
      rgba(0, 0, 0, 0.4) 60%,
      transparent 85%
    );
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 54rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    will-change: transform, opacity;
  }

  .page-hero__meta {
    margin-bottom: 1.5rem;
  }

  .page-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-primary, #b6ff5c);
  }

  .page-hero__pill-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-primary, #b6ff5c);
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.8);
  }

  .page-hero__title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f8f5ec;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .page-hero__title {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .page-hero__title {
      font-size: 3.75rem;
    }
  }

  .page-hero__description {
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #a1a1aa;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .page-hero__description {
      font-size: 1.0625rem;
    }
  }

  /* ── Bottom Section Divider ────────────────────────────────────────── */
  .page-hero__divider {
    height: 1px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.06) 20%,
      rgba(182, 255, 92, 0.25) 50%,
      rgba(255, 255, 255, 0.06) 80%,
      transparent 100%
    );
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initPageHeroParallax = () => {
    const heroes = document.querySelectorAll(".page-hero");

    heroes.forEach((hero) => {
      const bg = hero.querySelector(".page-hero__bg");
      const inner = hero.querySelector(".page-hero__inner");

      if (bg) {
        gsap.to(bg, {
          yPercent: 30,
          ease: "none",
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });
      }

      if (inner) {
        gsap.to(inner, {
          yPercent: -12,
          opacity: 0.25,
          ease: "none",
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });
      }
    });
  };

  document.addEventListener("astro:page-load", initPageHeroParallax);
</script>
