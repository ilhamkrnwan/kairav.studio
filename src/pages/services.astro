---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/common/Button.astro";
import Container from "../components/common/Container.astro";
import SectionHeading from "../components/common/SectionHeading.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import CTASection from "../components/sections/CTASection.astro";
import PageHero from "../components/sections/PageHero.astro";
import { services } from "../data/services";
---

<BaseLayout
  title="Services - Kairav Studio"
  description="Explore Kairav Studio services for modern websites, custom web apps, SEO/GEO optimization, AI automation, and maintenance."
>
  <main>
    <PageHero
      eyebrow="Services"
      title="Focused web, product, and automation services."
      description="We keep the offer clear: modern websites, practical systems, stronger discovery, and maintainable improvements."
    />

    <section class="section-spacing">
      <Container>
        <div class="grid gap-5 md:grid-cols-2">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
      </Container>
    </section>

    <section class="section-spacing bg-[var(--color-background-soft)]">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
          <SectionHeading
            eyebrow="Approach"
            title="Not overly salesy. Just useful, clear, and built to last."
            description="Every engagement starts by understanding the business goal, current constraints, and what should be easier after launch."
          />
          <div class="grid gap-4">
            {["Audit what exists", "Design the right structure", "Build reusable parts", "Measure and improve"].map((item) => (
              <div class="card-surface p-5">
                <h2 class="font-heading text-lg font-semibold text-[var(--color-text)]">{item}</h2>
                <p class="mt-3 text-sm leading-6 text-[var(--color-text-soft)]">
                  Small, reviewable steps keep the project understandable for clients and contributors.
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-10">
          <Button href="/contact">Contact Us</Button>
        </div>
      </Container>
    </section>

    <CTASection />
  </main>
</BaseLayout>
