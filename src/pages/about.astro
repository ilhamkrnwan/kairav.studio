---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import SectionHeading from "../components/common/SectionHeading.astro";
import TeamMemberCard from "../components/cards/TeamMemberCard.astro";
import CTASection from "../components/sections/CTASection.astro";
import DarkAccentSection from "../components/sections/DarkAccentSection.astro";
import PageHero from "../components/sections/PageHero.astro";
import Badge from "../components/common/Badge.astro";
import { contributors } from "../data/contributors";
---

<BaseLayout
  title="About - Kairav Studio"
  description="Learn about Kairav Studio, our team, philosophy, and approach to modern web experiences and collaborative digital systems."
>
  <main>
    <PageHero
      eyebrow="About"
      title="A studio for modern web experiences and collaborative digital systems."
      description="Kairav Studio exists to help brands and projects build websites that feel considered, load quickly, and stay maintainable as the team grows."
      image="/hero-works.png"
      imageAlt="About Kairav Studio"
    />

    <section class="section-spacing">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
          <SectionHeading
            eyebrow="Positioning"
            title="Premium, practical, and open to collaboration."
            description="We care about visual identity, interface clarity, performance, SEO/GEO structure, and the small engineering decisions that make a site easier to evolve."
          />
          <div class="grid gap-4">
            {["Modern web craft", "Open-source mindset", "Clear delivery process"].map((item) => (
              <div class="card-surface p-5">
                <h2 class="font-heading text-xl font-semibold text-[var(--color-text)]">{item}</h2>
                <p class="mt-3 text-sm leading-6 text-[var(--color-text-soft)]">
                  We keep the work transparent, component-based, and structured enough for contributors and clients to understand.
                </p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <DarkAccentSection>
      <div class="max-w-2xl">
        <Badge class="border-[var(--color-lime-soft)] bg-[var(--color-lime-soft)] text-[var(--color-lime-bright)]">Open Source Spirit</Badge>
        <h2 class="mt-5 font-heading text-3xl font-semibold leading-tight text-white sm:text-4xl">
          Built together, in the open.
        </h2>
        <p class="mt-4 text-base leading-7 text-[var(--color-dark-text-soft)]">
          The studio should feel polished, but the process stays simple and honest. Work is shaped with contributors, transparent notes, and reusable patterns that anyone on the team can pick up.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {["Clarity before complexity", "Performance as default", "Systems that invite contribution"].map((value) => (
          <article class="card-surface p-6">
            <h3 class="font-heading text-xl font-semibold text-white">{value}</h3>
            <p class="mt-4 text-sm leading-6 text-[var(--color-dark-text-soft)]">
              Practical decisions, clean structure, and useful notes help the work stay readable after launch.
            </p>
          </article>
        ))}
      </div>
    </DarkAccentSection>

    {/* ── Team Section ── */}
    <section class="section-spacing">
      <Container>
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Core Team</p>
            <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
              The people behind the systems.
            </h2>
          </div>
          <span class="font-mono text-[0.68rem] text-[var(--color-text-subtle)]">
            {contributors.length} core members
          </span>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {contributors.map((member) => <TeamMemberCard member={member} />)}
        </div>

        {/* ── Editorial note ── */}
        <div class="mt-12 border-l-2 border-[var(--color-primary)] bg-white/[0.01] p-6 rounded-r-md">
          <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-wider text-[var(--color-text-muted)]">Collaboration</p>
          <p class="text-sm italic leading-6 text-[var(--color-text-soft)]">
            We collaborate with designers, copywriters, and specialists per project. More profiles will be added as the studio grows.
          </p>
        </div>
      </Container>
    </section>

    <CTASection />
  </main>
</BaseLayout>
