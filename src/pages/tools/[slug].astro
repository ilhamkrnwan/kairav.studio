  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .rail-spec-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .spec-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .spec-value {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .spec-detail {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  .tool-meta-note {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
  }

  .meta-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .meta-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #111113;
  }

  .meta-desc {
    font-size: 0.76rem;
    color: #475569;
    line-height: 1.4;
  }

  /* ── Rating Badge ─────────────────────────────────────────────────────────── */
  .rating-badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
