---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const { href, variant = "primary", class: className = "" } = Astro.props;

/* guide.md:
   Primary: bg #b6ff5c, text #080808 (lime on dark)
   Secondary: glass border, ivory text
   Ghost: transparent, muted text */
const styles = {
  primary:
    "btn-primary bg-[var(--color-primary)] !text-[#080808] font-bold shadow-[var(--shadow-glow-primary)] hover:bg-[var(--color-primary-hover)] hover:opacity-95",
  secondary:
    "btn-secondary border border-white/20 bg-white/[0.06] !text-[#f5f1e8] font-semibold backdrop-blur-sm hover:border-[var(--color-primary)] hover:!text-[var(--color-primary)] hover:bg-[var(--color-primary-soft)]",
  ghost:
    "btn-ghost border border-transparent bg-transparent !text-[var(--color-text-muted)] font-medium hover:!text-[var(--color-primary)]",
};

const classes = [
  "inline-flex min-h-11 items-center justify-center rounded-full px-5 py-3 text-sm transition duration-200 cursor-pointer select-none",
  styles[variant],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button class:list={classes}>
      <slot />
    </button>
  )
}

<style>
  .btn-primary {
    color: #080808 !important;
  }
  .btn-secondary {
    color: #f5f1e8 !important;
  }
  .btn-secondary:hover {
    color: var(--color-primary) !important;
  }
</style>
