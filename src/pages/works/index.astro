<script>
  const setupWorksFilter = () => {
    const filterContainer = document.querySelector("[data-filter-bar]");
    if (!filterContainer || filterContainer.hasAttribute("data-initialized")) return;
    filterContainer.setAttribute("data-initialized", "true");

    const buttons = filterContainer.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-card-category]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filterVal = btn.getAttribute("data-filter") || "all";

        // Update active tab buttons
        buttons.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");

        // Filter cards smoothly
        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-card-category");
          if (filterVal === "all" || cardCat === filterVal) {
            card.style.display = "flex";
            card.style.opacity = "1";
            card.style.transform = "scale(1)";
          } else {
            card.style.display = "none";
            card.style.opacity = "0";
            card.style.transform = "scale(0.96)";
          }
        });
      });
    });
  };

  const initWorksPage = () => {
    setupWorksFilter();
  };

  document.addEventListener("DOMContentLoaded", initWorksPage);
  document.addEventListener("astro:page-load", initWorksPage);
  initWorksPage();
</script>
