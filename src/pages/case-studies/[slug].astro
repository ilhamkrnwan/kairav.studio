---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, index) => {
    const related = projects.filter((p) => p.slug !== project.slug);
    return {
      params: { slug: project.slug },
      props: { project, index, related },
    };
  });
}

interface Props {
  project: Project;
  index: number;
  related: Project[];
}

const { project, index, related } = Astro.props;

// Rich project metadata lookup with safe defaults
const projectMeta: Record<string, { image: string; timeline: string; metric: string; client: string; categoryLabel: string }> = {
  biolearn: {
    image: "https://framerusercontent.com/images/2PmXnNCt00qT9vzYVb3QaUnf4zw.png?width=1376&height=768",
    timeline: "4 Weeks",
    metric: "40+ Visual Modules",
    client: "BioLearn EdTech",
    categoryLabel: "Mobile Applications",
  },
  masjidflow: {
    image: "https://framerusercontent.com/images/XjlU11jxUwW1F9YareI2KWN9h7U.png?width=1376&height=768",
    timeline: "3 Weeks",
    metric: "Real-time Approval Flow",
    client: "MasjidFlow Community",
    categoryLabel: "Mobile Applications",
  },
  statprov: {
    image: "https://framerusercontent.com/images/UFrKcEOmaSl26doqir6ihNDhig.png?width=1376&height=768",
    timeline: "4 Weeks",
    metric: "Cryptographic Audit Trail",
    client: "StatProv Research",
    categoryLabel: "Research & Protocols",
  },
  "sistem-informasi-desa": {
    image: "https://framerusercontent.com/images/eidAjOUfrcQoUHpfZzJkhQhq904.png?width=1376&height=768",
    timeline: "6 Weeks",
    metric: "Instant Citizen Portal",
    client: "Desa Digital Indonesia",
    categoryLabel: "Web & Portals",
  },
  "kairav-studio-landing-upgrade": {
    image: "https://framerusercontent.com/images/9zKvRtHkgdsk6GrAEumhiKXosI.png?width=1376&height=768",
    timeline: "2 Weeks",
    metric: "100/100 Lighthouse Performance",
    client: "Kairav Studio Internal",
    categoryLabel: "Systems & Web",
  },
};

const meta = projectMeta[project.slug] || {
  image: "https://framerusercontent.com/images/9zKvRtHkgdsk6GrAEumhiKXosI.png?width=1376&height=768",
  timeline: "3-4 Weeks",
  metric: "Production Verified",
  client: "Client Engagement",
  categoryLabel: project.type,
};

// Formatted case study ID
const caseId = `CS-${String(index + 1).padStart(2, "0")}`;
const projectAccent = project.accent || "#b6ff5c";

const projectGallery: Record<string, { title: string; image: string; tag: string; metric: string }[]> = {
  "kairav-studio-landing-upgrade": [
    { title: "Dark Operating Board", image: "https://framerusercontent.com/images/9zKvRtHkgdsk6GrAEumhiKXosI.png?width=1376&height=768", tag: "UI TELEMETRY", metric: "60FPS SMOOTH" },
    { title: "Motion & Parallax Rig", image: "https://framerusercontent.com/images/Yq4KEmqOVkZqrGpcssu03px94.png?width=1376&height=768", tag: "GSAP TIMELINE", metric: "ZERO JANK" },
    { title: "Static Core Architecture", image: "https://framerusercontent.com/images/jQ4Hi4oiEduhRH7VSroCWQKfILc.png?width=1376&height=768", tag: "ASTRO STATIC", metric: "<100MS LOAD" },
  ],
  "biolearn": [
    { title: "Interactive Mobile Quiz", image: "https://framerusercontent.com/images/2PmXnNCt00qT9vzYVb3QaUnf4zw.png?width=1376&height=768", tag: "MOBILE UI", metric: "40+ MODULES" },
    { title: "Learning Curriculum State", image: "https://framerusercontent.com/images/iixq8RLOqwba1Oy62rZEh6kL4cI.png?width=1376&height=768", tag: "EXPO RUNTIME", metric: "ZUSTAND STORE" },
    { title: "Performance & Offline Sync", image: "https://framerusercontent.com/images/DSzg39Hm4aY9wgyDlvQ3M0nJ4yw.png?width=1376&height=768", tag: "OFFLINE FIRST", metric: "FAST HYDRATION" },
  ],
  "masjidflow": [
    { title: "Community Dashboard View", image: "https://framerusercontent.com/images/XjlU11jxUwW1F9YareI2KWN9h7U.png?width=1376&height=768", tag: "COMMUNITY APP", metric: "3-STAGE APPROVAL" },
    { title: "Role-Based Access Control", image: "https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768", tag: "AUTH PROTOCOL", metric: "SECURE JWT" },
    { title: "Real-time Agenda Schedule", image: "https://framerusercontent.com/images/ebxeUkq1qqvXG04ito9B2T0yg6A.png?width=1376&height=768", tag: "AGENDA ENGINE", metric: "SYNCED CALENDAR" },
  ],
  "statprov": [
    { title: "Statistical Analytics Portal", image: "https://framerusercontent.com/images/UFrKcEOmaSl26doqir6ihNDhig.png?width=1376&height=768", tag: "DATA DASHBOARD", metric: "10K+ RECORDS" },
    { title: "Interactive Data Visualizer", image: "https://framerusercontent.com/images/dynhmneOOuqyizRngVjQ72c76w.png?width=1376&height=768", tag: "CHART ENGINE", metric: "CLIENT CACHED" },
    { title: "Export Pipeline & Telemetry", image: "https://framerusercontent.com/images/jQ4Hi4oiEduhRH7VSroCWQKfILc.png?width=1376&height=768", tag: "API PIPELINE", metric: "SUB-50MS API" },
  ],
  "sistem-informasi-desa": [
    { title: "Public Citizen Portal", image: "https://framerusercontent.com/images/eidAjOUfrcQoUHpfZzJkhQhq904.png?width=1376&height=768", tag: "PUBLIC PORTAL", metric: "ACCESSIBLE WCAG" },
    { title: "Citizen Submission Engine", image: "https://framerusercontent.com/images/rPuHe16bujQppKTJnkgFk7DPJQ.png?width=1376&height=768", tag: "DATA INTAKE", metric: "AUDITED LOGS" },
    { title: "Village Registry Management", image: "https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768", tag: "ADMIN CONTROL", metric: "MODULAR CRUD" },
  ],
};
---

<BaseLayout
  title={`${project.title} — Case Study & Production Architecture | Kairav Studio`}
  description={project.summary}
  canonicalPath={`/case-studies/${project.slug}`}
>
  <main class="case-study-page" style={`--case-accent: ${projectAccent};`}>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. DARK BLUEPRINT HERO (#07080b)                                       */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="case-hero-section" data-hero-section aria-label="Case Study Overview">
      <div class="case-container">
        
        {/* Top Telemetry Header Bar */}
        <div class="case-telemetry-bar">
          <div class="telemetry-left">
            <span class="telemetry-dot" aria-hidden="true"></span>
            <span class="telemetry-text">STATUS: VERIFIED PRODUCTION CASE</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">ARCHIVE ID: {caseId}</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">YEAR: {project.year}</span>
          </div>
          <div class="telemetry-right">
            <span class="telemetry-text">CLASSIFICATION: {project.type.toUpperCase()} ARCHITECTURE</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">YOGYAKARTA (UTC+7)</span>
          </div>
          <span class="grid-cross cross--tl" aria-hidden="true">+</span>
          <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        </div>

        {/* 24% / 76% Asymmetric Blueprint Band */}
        <div class="band-row">
          
          {/* Left Rail: Project Dossier */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Case Dossier
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Shipped System
            </div>

            <div class="rating-badge">
              <span class="rating-star" aria-hidden="true">★</span>
              <span class="rating-val">4.9</span>
              <span class="rating-desc">Production Sign-off</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">CLIENT ENGAGEMENT</span>
              <span class="dossier-val">{meta.client}</span>
              <span class="dossier-desc">{meta.categoryLabel} · {meta.timeline} Sprint</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">VERIFIED METRIC</span>
              <span class="dossier-val font-accent">{meta.metric}</span>
              <span class="dossier-desc">100% Client-Owned IP &amp; Repository</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            
            {/* Breadcrumb & Identifier */}
            <div class="case-meta-top">
              <nav class="case-breadcrumbs" aria-label="Breadcrumbs">
                <a href="/works">Works</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-cat">{meta.categoryLabel}</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-id">{caseId}</span>
              </nav>

              <span class="case-badge-pill">
                <span class="badge-dot" aria-hidden="true"></span>
                {project.type.toUpperCase()}
              </span>
            </div>

            {/* Monumental Headline */}
            <h1 class="case-hero-title">
              {project.title}
            </h1>

            {/* Summary */}
            <p class="case-hero-summary">
              {project.summary}
            </p>

            {/* Tag Pills Strip */}
            <div class="case-pills-strip">
              <span class="case-pill"># {project.type}</span>
              <span class="case-pill"># {project.year}</span>
              {project.stack.slice(0, 3).map((tool) => (
                <span class="case-pill"># {tool}</span>
              ))}
            </div>

            {/* Primary Visual Showcase Frame */}
            <div class="case-image-frame">
              <span class="frame-tag">PRIMARY PRODUCTION SURFACE</span>
              <span class="frame-cross cross--tl" aria-hidden="true">+</span>
              <span class="frame-cross cross--tr" aria-hidden="true">+</span>
              <span class="frame-cross cross--bl" aria-hidden="true">+</span>
              <span class="frame-cross cross--br" aria-hidden="true">+</span>
              <img
                src={meta.image}
                alt={`${project.title} interface architecture showcase`}
                class="case-hero-img"
                loading="eager"
              />
              <div class="frame-caption">
                <span class="caption-id">{caseId} · UI &amp; SYSTEMS SPEC</span>
                <span class="caption-res">{meta.timeline} BUILD CYCLE · PRODUCTION DEPLOYED</span>
              </div>
            </div>

            {/* Action Row */}
            <div class="case-action-row">
              <a href={`/contact?type=${encodeURIComponent(project.type)}`} class="clonix-cta-button">
                <span class="clonix-cta-button__text">Inquire Similar System</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </span>
              </a>

              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="action-outline-btn">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>GitHub Repository</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}

              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="action-outline-btn">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                  <span>Live Production</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}

              <a href="/works" class="hero-back-link">
                <span aria-hidden="true">←</span>
                <span>Back to Selected Works</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. CHALLENGE VS SOLUTION MATRIX (Light Canvas #f8f5ec)                  */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="diagnostic-section" aria-label="Problem and Solution Breakdown">
      <div class="case-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Diagnostic
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Context &amp; Intervention
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · STRATEGIC DIAGNOSIS &amp; INTERVENTION</span>
              <h2 class="section-title">The Bottleneck &amp; The Engineering Fix.</h2>
              <p class="section-desc">
                Every project begins by identifying systemic friction points and designing a clean, measurable path to resolution.
              </p>
            </div>

            {/* Asymmetric Dual Matrix */}
            <div class="diagnostic-grid">
              
              {/* Problem Card */}
              <div class="matrix-card card--problem">
                <div class="card-head-pill pill--problem">
                  <span class="pill-dot dot--problem"></span>
                  THE OPERATIONAL BOTTLENECK
                </div>
                <h3 class="matrix-card__title">System Inefficiencies Before Intervention</h3>
                <p class="matrix-card__body">{project.problem}</p>
                <div class="card-footer-box footer-box--problem">
                  <span class="footer-label">ROOT CAUSE IDENTIFIED</span>
                  <p class="footer-text">
                    Lack of structured state management, friction in manual coordination, and absence of focused user workflows.
                  </p>
                </div>
              </div>

              {/* Solution Card */}
              <div class="matrix-card card--solution">
                <div class="card-head-pill pill--solution">
                  <span class="pill-dot dot--solution"></span>
                  THE ARCHITECTURAL INTERVENTION
                </div>
                <h3 class="matrix-card__title">How We Engineered the Resolution</h3>
                <p class="matrix-card__body">{project.solution}</p>
                <div class="card-footer-box footer-box--solution">
                  <span class="footer-label">DELIVERY VALUE</span>
                  <p class="footer-text">
                    Resilient architecture, clear hierarchy, low latency payloads, and zero dependency bloat.
                  </p>
                </div>
              </div>

            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. TECHNICAL ARCHITECTURE & KEY SYSTEMS BAND (Dark Obsidian #07080b)   */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="architecture-section" aria-label="Technical Architecture and Key Features">
      <div class="case-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Architecture
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Core System Modules
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            <div class="section-header-wrap">
              <span class="section-eyebrow">02 · SYSTEM MODULES &amp; SPECIFICATIONS</span>
              <h2 class="section-title text-light">Engineered for Modularity &amp; Scale.</h2>
              <p class="section-desc text-muted">
                Each subsystem was built with clean separation of concerns, strict typing, and rapid runtime execution.
              </p>
            </div>

              {/* Feature System Modules Grid */}
              <div class="features-modules-grid">
                {project.features.map((feature, fIdx) => (
                  <div class="feature-module-card">
                    <div class="module-head">
                      <span class="module-num">0{fIdx + 1}</span>
                      <span class="module-badge">SUBSYSTEM</span>
                    </div>
                    <h3 class="module-title">{feature}</h3>
                    <p class="module-desc">
                      Engineered to isolate operational concerns, reduce runtime errors, and provide predictable client interactions.
                    </p>
                    <div class="module-status">
                      <span class="status-indicator" aria-hidden="true"></span>
                      <span class="status-text">Integrated &amp; Verified</span>
                    </div>
                  </div>
                ))}
              </div>

              {/* Visual Production Surface Gallery */}
              <div class="system-gallery-strip">
                <div class="gallery-head">
                  <span class="gallery-eyebrow">// VERIFIED PRODUCTION SCREENS</span>
                  <span class="gallery-meta">ACTIVE DEPLOYMENT INTERFACES</span>
                </div>
                <div class="system-gallery-grid">
                  {(projectGallery[project.slug] || []).map((surf) => (
                    <div class="gallery-surface-card">
                      <div class="surface-img-frame">
                        <span class="surface-tag">{surf.tag}</span>
                        <img
                          src={surf.image}
                          alt={`${project.title} - ${surf.title}`}
                          class="surface-img"
                          loading="lazy"
                          width="640"
                          height="360"
                        />
                        <div class="surface-img-overlay"></div>
                      </div>
                      <div class="surface-meta-bar">
                        <span class="surface-title">{surf.title}</span>
                        <span class="surface-metric">{surf.metric}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            {/* Production Arsenal Banner */}
            <div class="tech-arsenal-box">
              <div class="arsenal-top">
                <span class="arsenal-eyebrow">PRODUCTION STACK SELECTION:</span>
                <span class="arsenal-audit">Strictly Typed · Low Latency Runtime</span>
              </div>
              <div class="arsenal-chips-row">
                {project.stack.map((item) => (
                  <span class="arsenal-chip">
                    <span class="arsenal-dot"></span>
                    {item}
                  </span>
                ))}
              </div>
              <p class="arsenal-rationale">
                Selected strictly on merit: each tool eliminates unnecessary runtime overhead while providing a joyfully typed developer experience.
              </p>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. MEASURABLE RESULTS & VERIFIED VALUE (Light Canvas #f8f5ec)           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="results-section" aria-label="Measurable Results and Outcomes">
      <div class="case-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Verification
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Business Impact
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">03 · PRODUCTION OUTCOMES &amp; DELIVERABLES</span>
              <h2 class="section-title">Measurable Results &amp; Clean Handover.</h2>
              <p class="section-desc">
                We measure success by durable business outcomes, not just code shipped.
              </p>
            </div>

            {/* Highlighted Outcome Box */}
            <div class="outcome-highlight-card">
              <div class="outcome-header">
                <span class="outcome-badge">★ VERIFIED OUTCOME SPECIFICATION</span>
                <span class="outcome-metric-pill">{meta.metric}</span>
              </div>
              <h3 class="outcome-title">What Was Delivered &amp; Verified</h3>
              <p class="outcome-body">{project.outcome}</p>
            </div>

            {/* Split Sub-Dossiers */}
            <div class="handover-grid">
              
              {/* Credits Box */}
