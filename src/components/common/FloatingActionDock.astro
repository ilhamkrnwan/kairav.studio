---
import { getLangFromUrl, localizePath } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
---

<aside 
  class="floating-dock" 
  id="floating-action-dock" 
  data-floating-dock 
  aria-label="Quick actions dock"
  aria-hidden="true"
>
  <!-- Primary Pill (Lime Accent - Start a Project) -->
  <a
    href={localizePath("/contact", lang)}
    class="dock-pill dock-pill--primary"
    id="dock-cta-project"
  >
    <span class="dock-pill__text">Start a Project</span>
    <span class="dock-pill__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </a>

  <!-- Secondary Pill (White/Ivory Pill - Hire / WhatsApp Direct) -->
  <a
    href="https://wa.me/6282241907338?text=Hello%20Kairav%20Studio,%20I%20would%20like%20to%20discuss%20a%20project"
    target="_blank"
    rel="noopener noreferrer"
    class="dock-pill dock-pill--secondary"
    id="dock-cta-chat"
  >
    <span class="dock-pill__text">Hire Studio</span>
    <span class="dock-pill__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </a>
</aside>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     CLONIX-INSPIRED FLOATING ACTION DOCK
     Desktop: Hidden by default, toggled via rail '+' button
     Mobile: Always visible at bottom right
     ═══════════════════════════════════════════════════════════════════ */

  .floating-dock {
    position: fixed;
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.625rem;
    pointer-events: none; /* children enable pointer events */
  }

  .dock-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    padding: 3px 3px 3px 18px;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow:
      0 12px 30px -6px rgba(0, 0, 0, 0.45),
      0 4px 12px -2px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms ease,
      filter 220ms ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .dock-pill:hover {
    transform: translateY(-2px);
    box-shadow:
      0 18px 36px -6px rgba(0, 0, 0, 0.6),
      0 6px 16px -2px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .dock-pill:active {
    transform: translateY(0) scale(0.98);
  }

  .dock-pill__text {
    padding-right: 14px;
  }

  /* ── Pill 1: Primary (Lime Accent) ────────────────────────────────── */
  .dock-pill--primary {
    background: #b6ff5c;
    color: #07080b;
    box-shadow:
      0 10px 24px -6px rgba(182, 255, 92, 0.35),
      0 4px 12px -2px rgba(0, 0, 0, 0.25);
  }

  .dock-pill--primary .dock-pill__icon {
    background: #07080b;
    color: #ffffff;
  }

  .dock-pill--primary:hover {
    background-color: #c9ff7a;
    box-shadow:
      0 14px 28px -4px rgba(182, 255, 92, 0.45),
      0 6px 16px -2px rgba(0, 0, 0, 0.3);
  }

  /* ── Pill 2: Secondary (White/Ivory High Contrast) ─────────────────── */
  .dock-pill--secondary {
    background: #ffffff;
    color: #07080b;
    box-shadow:
      0 10px 24px -6px rgba(0, 0, 0, 0.4),
      0 4px 12px -2px rgba(0, 0, 0, 0.25);
  }

  .dock-pill--secondary .dock-pill__icon {
    background: #07080b;
    color: #ffffff;
  }

  .dock-pill--secondary:hover {
    background-color: #f4f4f4;
  }

  /* ── Square Icon Container (Ngotak) ───────────────────────────────── */
  .dock-pill__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #07080b;
    color: #ffffff;
    border-radius: 3px;
    flex-shrink: 0;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-pill:hover .dock-pill__icon {
    transform: translateX(2px);
  }

  /* ── Desktop Right Rail Offset & Toggle Visibility ────────────────── */
  @media (min-width: 768px) {
    .floating-dock {
      right: calc(4.5rem + clamp(1.25rem, 2.5vw, 2rem));
      bottom: clamp(1.5rem, 3vw, 2.5rem);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(16px) scale(0.96);
      transition:
        opacity 220ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 220ms ease;
    }

    .floating-dock.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(0) scale(1);
    }
  }

  /* ── Mobile responsiveness: ALWAYS VISIBLE ────────────────────────── */
  @media (max-width: 767px) {
    .floating-dock {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: none !important;
      transform: none !important;
      bottom: 1rem;
      right: 1rem;
      gap: 0.5rem;
    }

    .dock-pill {
      pointer-events: auto !important;
      height: 38px;
      padding: 3px 4px 3px 13px;
      font-size: 0.76rem;
    }

    .dock-pill__icon {
      width: 28px;
      height: 28px;
    }
  }

  /* ── Accessibility ────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .floating-dock,
    .dock-pill,
    .dock-pill__icon {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  let docClickListener: ((e: MouseEvent) => void) | null = null;
  let keydownListener: ((e: KeyboardEvent) => void) | null = null;

  const initFloatingDock = () => {
    const dock = document.querySelector("[data-floating-dock]") as HTMLElement | null;
    const toggleBtn = document.querySelector("[data-dock-toggle]") as HTMLButtonElement | null;

    if (!dock) return;

    const isMobile = () => window.innerWidth < 768;

    const setDockState = (open: boolean) => {
      if (isMobile()) {
        dock.classList.remove("is-open");
        dock.setAttribute("aria-hidden", "false");
        toggleBtn?.classList.remove("is-active");
        toggleBtn?.setAttribute("aria-expanded", "false");
        return;
      }

      dock.classList.toggle("is-open", open);
      dock.setAttribute("aria-hidden", String(!open));
      toggleBtn?.classList.toggle("is-active", open);
      toggleBtn?.setAttribute("aria-expanded", String(open));
    };

    // Initial check for mobile
    if (isMobile()) {
      dock.setAttribute("aria-hidden", "false");
    } else {
      dock.setAttribute("aria-hidden", String(!dock.classList.contains("is-open")));
    }

    if (toggleBtn) {
      toggleBtn.onclick = (e) => {
        e.stopPropagation();
        const willOpen = !dock.classList.contains("is-open");
        setDockState(willOpen);
      };
    }

    // Clean up previous window listeners
    if (docClickListener) {
      document.removeEventListener("click", docClickListener);
    }
    if (keydownListener) {
      document.removeEventListener("keydown", keydownListener);
    }

    docClickListener = (e: MouseEvent) => {
      if (isMobile()) return;
      if (!dock.classList.contains("is-open")) return;

      const target = e.target as Node;
      if (!dock.contains(target) && !toggleBtn?.contains(target)) {
        setDockState(false);
      }
    };

    keydownListener = (e: KeyboardEvent) => {
      if (e.key === "Escape" && dock.classList.contains("is-open")) {
        setDockState(false);
        toggleBtn?.focus();
      }
    };

    document.addEventListener("click", docClickListener);
    document.addEventListener("keydown", keydownListener);
  };

  // Run on first load and Astro view transitions
  document.addEventListener("astro:page-load", initFloatingDock);
</script>
