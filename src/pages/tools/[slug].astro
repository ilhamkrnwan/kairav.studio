---
/**
 * src/pages/tools/[slug].astro
 * Architectural Blueprint Specification Detail Page for Kairav Studio.
 * Follows the signature Clonix / Blueprint Design System:
 * 1. Dark Blueprint Hero with telemetry bar, tool dossier left rail, and action buttons.
 * 2. Light Canvas Mandate & Problem Matrix (What it is, Who it's for, Bottleneck eliminated).
 * 3. Dark Obsidian Scope & Arsenal Band (Deliverables, Tech direction, Expected outcome).
 * 4. Light Canvas 4-Stage Execution Protocol (Milestone-driven delivery steps).
 * 5. Interactive Tool-Specific FAQ Accordion.
 * 6. Dark Obsidian Adjacent Tools Catalog.
 * 7. Monumental Bottom CTA Banner leading to /contact.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/services";
import type { Service } from "../../data/services";

export function getStaticPaths() {
  return services.map((service, index) => ({
    params: { slug: service.id },
    props: { service, index },
  }));
}

interface Props {
  service: Service;
  index: number;
}

const { service, index = 0 } = Astro.props;

const related = services.filter((item) => item.id !== service.id);
const canonicalPath = `/tools/${service.id}`;
const canonicalUrl = `https://kairav.studio${canonicalPath}`;

/* ── Structured data for SEO + GEO (docs/guide.md §GEO Theme Rules) ── */
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.whatItIs,
  url: canonicalUrl,
  provider: {
    "@type": "Organization",
    name: "Kairav Studio",
    url: "https://kairav.studio",
  },
  areaServed: "Worldwide",
  audience: { "@type": "Audience", audienceType: service.whoItsFor },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${service.title} — Engineering Specification · Kairav Studio`}
  description={service.summary}
  canonicalPath={canonicalPath}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <main class="tool-spec-main" style={`--svc-accent: ${service.accent};`}>
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. HERO BAND (Dark Blueprint Canvas #07080b)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="tool-hero-section" aria-label="Tool Engineering Specification" data-hero-section>
      {/* Background Rotating Watermark */}
      <div class="hero-watermark" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" class="rotor-svg">
          <path
            d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.6142 50 100C50 72.6142 72.6142 50 100 50C72.6142 50 50 27.6142 50 0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <div class="tool-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        {/* Blueprint Telemetry Bar */}
        <div class="blueprint-meta-bar" aria-label="Tool Specification Telemetry">
          <div class="blueprint-meta-left">
            <span class="blueprint-status-dot" aria-hidden="true"></span>
            <span class="blueprint-mono">STATUS: ACTIVE SPECIFICATION · TOOL ID: {service.id.toUpperCase()} · 2026 ARCHIVE</span>
          </div>
          <div class="blueprint-meta-right">
            <span class="blueprint-mono">STANDARDS: ZERO RUNTIME WASTE · TYPE SAFE · YOGYAKARTA (UTC+7)</span>
          </div>
        </div>

        <div class="band-row hero-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Spec Dossier
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Verified Discipline
            </div>

            {/* Rating Pill */}
            <div class="rating-badge">
              <div class="rating-star-box">
                <span class="star-icon">★</span>
                <span class="rating-val">4.9</span>
              </div>
              <span class="rating-sub">50+ Shipped Systems</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">DISCIPLINE CATEGORY</span>
              <span class="spec-value">{service.category}</span>
              <span class="spec-detail">Architectural classification in studio production pipeline.</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">CORE TECHNOLOGY</span>
              <span class="spec-value">{service.techDirection[0] || "TypeScript"}</span>
              <span class="spec-detail">Selected for low latency, zero waste, and maintainability.</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main hero-main">
            <div class="hero-header-wrap">
              <div class="hero-breadcrumbs">
                <a href="/tools" class="breadcrumb-link">Capabilities</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-current">{service.category}</span>
                <span class="breadcrumb-tag">0{index + 1}</span>
              </div>

              <div class="hero-title-group">
                <div class="tool-icon-frame" aria-hidden="true">
                  <Fragment set:html={service.icon} />
                </div>
                <h1 class="hero-title">
                  {service.title}
                </h1>
              </div>

              <p class="hero-desc">
                {service.summary}
              </p>
            </div>

            {/* Tags Strip */}
            <div class="hero-tags-strip" aria-label="Discipline tags">
              {service.tags.map((tag) => (
                <span class="hero-tag-chip">
                  <span class="tag-hash">#</span>
                  {tag}
                </span>
              ))}
            </div>

            {/* CTA Buttons Row */}
            <div class="hero-actions-row">
              <a href="/contact" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Inquire This Capability</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </span>
              </a>

              <a href="/tools" class="hero-back-btn">
                <span>← Back to All Tools</span>
              </a>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. MANDATE & PROBLEM MATRIX (Light Canvas #f8f5ec)                     */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="mandate-section" aria-label="Mandate and Target Problems">
      <div class="tool-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Context
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Strategic Purpose
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · CORE MANDATE & TARGET PROBLEM</span>
              <h2 class="section-title">Why This Architecture Matters.</h2>
              <p class="section-desc">
                Every tool in our arsenal was designed to eliminate common engineering debt and deliver tangible business outcomes.
              </p>
            </div>

            {/* Split Mandate Grid */}
            <div class="mandate-grid">
              <div class="mandate-card">
                <div class="card-head-pill">
                  <span class="card-pill-dot"></span>
                  WHAT IT IS
                </div>
                <h3 class="mandate-card__title">Architectural Definition</h3>
                <p class="mandate-card__body">{service.whatItIs}</p>

                <div class="mandate-sub-box">
                  <span class="sub-box-label">WHO IT'S FOR:</span>
                  <p class="sub-box-text">{service.whoItsFor}</p>
                </div>
              </div>

              <div class="mandate-card mandate-card--problem">
                <div class="card-head-pill pill-alert">
                  <span class="card-pill-dot dot-alert"></span>
                  THE BOTTLENECK
                </div>
                <h3 class="mandate-card__title">The Problem We Eliminate</h3>
                <p class="mandate-card__body">{service.problem}</p>

                <div class="mandate-sub-box sub-box--alert">
                  <span class="sub-box-label label-alert">CORE PRINCIPLE:</span>
                  <p class="sub-box-text">We build the foundation right on day one — eliminating costly post-launch rewrites and performance triage.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. SCOPE & ARSENAL BAND (Dark Obsidian Canvas #07080b)                 */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="arsenal-section" aria-label="Deliverables and Technical Stack">
      <div class="tool-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Scope & Stack
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Deliverables Dossier
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            <div class="section-header-wrap">
              <span class="section-eyebrow">02 · SPECIFICATION & PRODUCTION ASSETS</span>
              <h2 class="section-title text-light">Deliverables & Technical Direction.</h2>
              <p class="section-desc text-muted">
                Everything included with this capability is production-grade, strictly typed, and completely owned by your organization.
              </p>
            </div>

            {/* Deliverables Cards Grid */}
            <div class="deliverables-grid">
              {service.deliverables.map((item, dIdx) => (
                <div class="deliverable-card">
                  <div class="deliverable-head">
                    <span class="deliverable-num">0{dIdx + 1}</span>
                    <span class="deliverable-check" aria-hidden="true">✓</span>
                  </div>
                  <p class="deliverable-text">{item}</p>
                </div>
              ))}
            </div>

            {/* Tech Stack Arsenal Strip */}
            <div class="tech-arsenal-box">
              <div class="arsenal-head-row">
                <span class="arsenal-label">RECOMMENDED PRODUCTION STACK:</span>
                <span class="arsenal-sub">Zero bloat · Tailored per deployment</span>
              </div>
              <div class="arsenal-chips-row">
                {service.techDirection.map((tech) => (
                  <div class="tech-chip-item">
                    <span class="tech-chip-dot"></span>
                    <span class="tech-chip-name">{tech}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Expected Business Outcome Callout */}
            <div class="outcome-callout-card">
              <div class="outcome-badge">
                <span class="outcome-dot"></span>
                VERIFIED OUTCOME
              </div>
              <h3 class="outcome-title">What Success Looks Like</h3>
              <p class="outcome-desc">{service.outcome}</p>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. EXECUTION PROTOCOL (Light Canvas #f8f5ec)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="protocol-section" aria-label="Step-by-step Execution Protocol">
      <div class="tool-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Protocol
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Execution Stages
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">03 · STEP-BY-STEP CADENCE</span>
              <h2 class="section-title">A Clear, Reviewable Process.</h2>
              <p class="section-desc">
                From discovery and constraint mapping to final performance certification, every step is transparent.
              </p>
            </div>

            {/* 4 Process Cards */}
            <div class="process-cards-grid">
              {service.process.map((step, pIdx) => (
                <div class="process-card">
                  <div class="process-card__head">
                    <span class="process-step-num">0{pIdx + 1}</span>
                    <span class="process-step-tag">PHASE 0{pIdx + 1}</span>
                  </div>
                  <h3 class="process-card__title">{step.title}</h3>
                  <p class="process-card__detail">{step.detail}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 5. TOOL-SPECIFIC FAQ ACCORDION (Light Canvas #f8f5ec)                  */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="tool-faq-section" aria-label="Tool Specific FAQ">
      <div class="tool-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Tool FAQ
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Capability Clarity
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">04 · CLARITY & EDGE CASES</span>
              <h2 class="section-title">Common Questions About {service.title}</h2>
              <p class="section-desc">
                Straight answers about requirements, technical compatibility, and implementation timelines.
              </p>
            </div>

            {/* Interactive Accordion */}
            <div class="tool-faq-accordion" data-faq-group>
              {service.faq.map((item, fIdx) => (
                <div class={`faq-item-row ${fIdx === 0 ? "is-expanded" : ""}`} data-faq-item={fIdx}>
                  <button
                    type="button"
                    class="faq-item-trigger"
                    data-faq-trigger
                    aria-expanded={fIdx === 0 ? "true" : "false"}
                  >
                    <div class="trigger-left">
                      <span class="faq-index-number">0{fIdx + 1}</span>
                      <h3 class="faq-question-text">{item.q}</h3>
                    </div>
                    <span class="faq-toggle-icon" aria-hidden="true">{fIdx === 0 ? "×" : "+"}</span>
                  </button>

                  <div class="faq-item-body">
                    <p class="faq-answer-text">{item.a}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 6. ADJACENT CAPABILITIES (Dark Obsidian Canvas #07080b)                */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="related-tools-section" aria-label="Adjacent Capabilities">
      <div class="tool-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Arsenal
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Adjacent Tools
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            <div class="section-header-wrap">
              <div class="header-split-row">
                <div>
                  <span class="section-eyebrow">05 · EXPAND YOUR STACK</span>
                  <h2 class="section-title text-light">Adjacent Engineering Capabilities.</h2>
                </div>
                <a href="/tools" class="catalog-link">
                  <span>View All 6 Tools</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            {/* Related Cards Grid */}
            <div class="related-cards-grid">
              {related.map((item) => (
                <a href={`/tools/${item.id}`} class="related-tool-card" style={`--item-accent: ${item.accent};`}>
                  <div class="related-card-top">
                    <span class="related-card-category">{item.category}</span>
                    <span class="related-arrow" aria-hidden="true">→</span>
                  </div>
                  <div class="related-card-content">
                    <div class="related-card-icon" aria-hidden="true">
                      <Fragment set:html={item.icon} />
                    </div>
                    <h3 class="related-card-title">{item.title}</h3>
                    <p class="related-card-summary">{item.summary}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 7. MONUMENTAL CTA BANNER                                               */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="tool-cta-banner" aria-label="Start Project with this tool">
      <div class="cta-banner-container">
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="cta-banner-content">
          <span class="cta-eyebrow">READY TO DEPLOY THIS ARCHITECTURE?</span>
          <h2 class="cta-title">
            Let's Engineer Your <span class="highlight-text">{service.title}</span>.
          </h2>
          <p class="cta-desc">
            Bring the raw idea, the messy legacy codebase, or the ambitious product goal. We'll shape it into a high-velocity, strictly typed prototype in weeks.
          </p>

          <div class="cta-buttons-row">
            <a href="/contact" class="clonix-cta-button cta-primary">
              <span class="clonix-cta-button__text">Initiate Project Intake</span>
              <span class="clonix-cta-button__box" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </span>
            </a>

            <a
              href="https://wa.me/6287810777038"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-secondary-btn"
            >
              <span>Direct WhatsApp</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     BASE CANVAS & ARCHITECTURAL BLUEPRINT GRID
     ═══════════════════════════════════════════════════════════════════════════ */
  .tool-spec-main {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }

  /* ── 1. Hero Section (Dark Canvas #07080b) ────────────────────────────────── */
  .tool-hero-section {
    position: relative;
    background-color: #07080b;
    color: #f8f5ec;
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .tool-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .hero-watermark {
    position: absolute;
    top: -120px;
    right: -100px;
    width: 500px;
    height: 500px;
    opacity: 0.04;
    color: #f8f5ec;
    pointer-events: none;
    z-index: 0;
  }

  .rotor-svg {
    width: 100%;
    height: 100%;
    animation: slowSpin 140s linear infinite;
  }

  @keyframes slowSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .tool-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(7, 8, 11, 0.95);
    z-index: 1;
  }

  .container-light {
    border-color: rgba(7, 20, 21, 0.1);
    background: #faf9f5;
    color: #071415;
  }

  /* ── Crosshairs (+) ───────────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 1.15rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
    user-select: none;
    z-index: 10;
  }

  .container-light .grid-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross--tl { top: -0.6rem; left: -0.45rem; }
  .cross--tr { top: -0.6rem; right: -0.45rem; }
  .cross--bl { bottom: -0.6rem; left: -0.45rem; }
  .cross--br { bottom: -0.6rem; right: -0.45rem; }

  /* ── Blueprint Telemetry Bar ─────────────────────────────────────────────── */
  .blueprint-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.015);
  }

  .blueprint-meta-left,
  .blueprint-meta-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .blueprint-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 10px rgba(182, 255, 92, 0.7);
    animation: statusPulse 2s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .blueprint-mono {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  /* ── Band Row: Split Rail & Main Stage ───────────────────────────────────── */
  .band-row {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  @media (min-width: 900px) {
    .band-row {
      flex-direction: row;
    }
  }

  /* ── Left Rail Layout ─────────────────────────────────────────────────────── */
  .band-rail {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #07080b;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      width: 24%;
      min-width: 260px;
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      padding: 3rem 1.75rem;
    }
  }

  .rail-light {
    background: #f4efe4;
    border-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right: 1px solid rgba(7, 20, 21, 0.08);
