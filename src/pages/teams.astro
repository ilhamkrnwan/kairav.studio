---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import PageHero from "../components/sections/PageHero.astro";
import CTASection from "../components/sections/CTASection.astro";
import TeamMemberCard from "../components/cards/TeamMemberCard.astro";
import { contributors } from "../data/contributors";
---

<BaseLayout
  title="Teams - Kairav Studio"
  description="Meet the people behind Kairav Studio — a small, design-led team building modern websites, custom systems, and connected apps."
>
  <main>
    <PageHero
      eyebrow="Team"
      title="The people behind the systems."
      description="Kairav Studio is a small, design-led team. We shape visual platforms, develop resilient frontends, build custom systems, and keep security and performance in mind from the start."
    />

    <section class="section-spacing pt-0">
      <Container>
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Core team</p>
            <h2 class="font-heading text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl">
              Small team, full-stack range.
            </h2>
          </div>
          <span class="font-mono text-[0.68rem] text-[var(--color-text-subtle)]">
            {contributors.length} members
          </span>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {contributors.map((member) => <TeamMemberCard member={member} />)}
        </div>

        {/* ── Editorial note ── */}
        <div class="mt-12 border-l-2 border-[var(--color-primary)] bg-white/[0.01] p-6 rounded-r-md">
          <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-wider text-[var(--color-text-muted)]">Note</p>
          <p class="text-sm italic leading-6 text-[var(--color-text-soft)]">
            We collaborate with designers, copywriters, and specialists per project. More profiles will be added as the studio grows.
          </p>
        </div>
      </Container>
    </section>

    <CTASection
      eyebrow="Work with us"
      title="Have a project that needs design taste and solid engineering?"
      description="Bring the problem, the goal, or the rough idea. We will help shape the right path."
    />
  </main>
</BaseLayout>
