---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/blog";

// Topics and categories
const categories = [
  { id: "all", label: "All Dispatches", count: blogPosts.length },
  { id: "performance", label: "Performance", count: blogPosts.filter(p => p.category.toLowerCase().includes("perf")).length || 1 },
  { id: "opensource", label: "Open Source", count: blogPosts.filter(p => p.category.toLowerCase().includes("open") || p.category.toLowerCase().includes("source")).length || 1 },
  { id: "visibility", label: "Visibility & SEO", count: blogPosts.filter(p => p.category.toLowerCase().includes("seo") || p.category.toLowerCase().includes("geo")).length || 1 },
];

const featuredPost = blogPosts[0];

const postImages: Record<string, string> = {
  "why-fast-websites-still-matter": "https://framerusercontent.com/images/jQ4Hi4oiEduhRH7VSroCWQKfILc.png?width=1376&height=768",
  "building-with-an-open-source-spirit": "https://framerusercontent.com/images/Yq4KEmqOVkZqrGpcssu03px94.png?width=1376&height=768",
  "seo-and-geo-for-modern-brands": "https://framerusercontent.com/images/rPuHe16bujQppKTJnkgFk7DPJQ.png?width=1376&height=768",
};
---

<BaseLayout
  title="Insights & Engineering Dispatches — Kairav Studio"
  description="Useful notes, architecture deep dives, and performance benchmarks on websites, SEO, GEO, AI, and custom digital systems from Kairav Studio."
  canonicalPath="/insights"
>
  <main class="insights-page">

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. DARK BLUEPRINT HERO (#07080b)                                       */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="insights-hero-section" data-hero-section aria-label="Insights Overview">
      <div class="insights-container">
        
        {/* Top Telemetry Header Bar */}
        <div class="insights-telemetry-bar">
          <div class="telemetry-left">
            <span class="telemetry-text">STATUS: OPEN ARCHIVE</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">DISPATCH PROTOCOL</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">{blogPosts.length} PAPERS PUBLISHED</span>
          </div>
          <div class="telemetry-right">
            <span class="telemetry-text">FIELD NOTES &amp; ENGINEERING ESSAYS</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">YOGYAKARTA (UTC+7)</span>
          </div>
          <span class="grid-cross cross--tl" aria-hidden="true">+</span>
          <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        </div>

        {/* 24% / 76% Asymmetric Blueprint Band */}
        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Journal Dossier
            </div>

            <div class="rail-live-badge">
              Engineering Essays
            </div>

            <div class="rating-badge">
              <span class="rating-star" aria-hidden="true">★</span>
              <span class="rating-val">100%</span>
              <span class="rating-desc">Production Tested</span>
            </div>

            <div class="journal-meta-card">
              <span class="meta-label">EDITORIAL THESIS</span>
              <span class="meta-val">Pragmatic Tech</span>
              <span class="meta-desc">Zero superficial trend chasing. Only battle-tested findings from active systems.</span>
            </div>

            <div class="journal-meta-card">
              <span class="meta-label">CONTRIBUTORS</span>
              <span class="meta-val">Senior Collective</span>
              <span class="meta-desc">Direct notes from developers, systems architects, and UI craftspeople.</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            
            <div class="insights-meta-top">
              <nav class="insights-breadcrumbs" aria-label="Breadcrumbs">
                <a href="/">Studio</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">Insights &amp; Dispatches</span>
              </nav>

              <span class="insights-badge-pill">
                2026 ARCHIVE
              </span>
            </div>

            <h1 class="insights-hero-title">
              Notes on Speed, Architecture &amp; <span class="title-highlight">Digital Craft.</span>
            </h1>

            <p class="insights-hero-summary">
              Short, practical writing for teams that care about real web performance, resilient backend systems, AI integrations that actually solve problems, and search visibility.
            </p>

            {/* Topic Filter Chips */}
            <div class="topics-filter-strip" role="tablist" aria-label="Filter insights by discipline">
              {categories.map((cat, idx) => (
                <button
                  type="button"
                  class={`topic-filter-btn ${idx === 0 ? "is-active" : ""}`}
                  data-topic-filter={cat.id}
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  <span>{cat.label}</span>
                  <span class="filter-count">0{cat.count}</span>
                </button>
              ))}
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. DISPATCH ARCHIVE GRID (Light Canvas #f8f5ec)                         */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="dispatches-section" id="archive-matrix" aria-label="Dispatches Archive">
      <div class="insights-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Archive
            </div>

            <div class="rail-pill">
              Selected Papers
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · THE DISPATCH ARCHIVE</span>
              <h2 class="section-title">Field Notes from Production Deployments.</h2>
              <p class="section-desc">
                Concise architectural essays on the tradeoffs, performance techniques, and engineering decisions we implement for our clients every day.
              </p>
            </div>

            {/* Articles Grid */}
            <div class="dispatches-grid">
              {blogPosts.map((post, pIdx) => {
                const topicKey = post.category.toLowerCase().includes("perf") 
                  ? "performance" 
                  : (post.category.toLowerCase().includes("open") || post.category.toLowerCase().includes("source"))
                  ? "opensource"
                  : "visibility";

                return (
                  <article class="dispatch-card" data-topic={topicKey}>
                    <div class="card-meta-bar">
                      <span class="card-category-badge">{post.category}</span>
                      <div class="card-meta-right">
                        <span class="card-date">{post.date}</span>
                        <span class="card-sep">·</span>
                        <span class="card-reading">{post.readingTime}</span>
                      </div>
                    </div>

                    {/* Interactive Editorial Cover Image */}
                    <a href={`/insights/${post.slug}`} class="dispatch-cover-frame" aria-label={`Read ${post.title}`}>
                      <img
                        src={postImages[post.slug] || "https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768"}
                        alt={post.title}
                        class="dispatch-cover-img"
                        loading="lazy"
                        width="680"
                        height="380"
                      />
                      <div class="dispatch-cover-overlay"></div>
                      <span class="dispatch-cover-pill">
                        <span>{post.category}</span>
                      </span>
                    </a>

                    <h3 class="dispatch-card__title">
                      <a href={`/insights/${post.slug}`} class="card-title-link">
                        {post.title}
                      </a>
                    </h3>

                    <p class="dispatch-card__desc">
                      {post.description}
                    </p>

                    {/* Excerpt Snippet from first section */}
                    {post.sections && post.sections.length > 0 && (
                      <div class="card-abstract-quote">
                        <span class="abstract-label">CORE TAKEAWAY:</span>
                        <p class="abstract-text">"{post.sections[0].body}"</p>
                      </div>
                    )}

                    <div class="dispatch-card__footer">
                      <span class="article-index">DISPATCH 0{pIdx + 1}</span>
                      <a href={`/insights/${post.slug}`} class="read-dispatch-link">
                        <span>Read Full Paper</span>
                        <span class="link-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. EDITORIAL AXIOMS & STANDARDS BAND (Dark Obsidian #07080b)            */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="standards-band-section" aria-label="Editorial Standards">
      <div class="insights-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Standards
            </div>

            <div class="rail-live-badge">
              Editorial Criteria
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            <div class="section-header-wrap">
              <span class="section-eyebrow">02 · EDITORIAL COMMITMENTS</span>
              <h2 class="section-title text-light">What We Write About &amp; Why.</h2>
              <p class="section-desc text-muted">
                Our writing adheres to the exact same principles as our code: clarity, verified measurements, and actionable advice.
              </p>
            </div>

            {/* 3 Principles Cards */}
            <div class="axioms-grid">
              <div class="axiom-card">
                <span class="axiom-num">01</span>
                <h3 class="axiom-title">Rooted in Production</h3>
                <p class="axiom-desc">
                  We never write theoretical essays about technologies we haven't personally deployed, benchmarked, and maintained in production.
                </p>
              </div>

              <div class="axiom-card">
                <span class="axiom-num">02</span>
                <h3 class="axiom-title">Zero Superficial Trends</h3>
                <p class="axiom-desc">
                  We deliberately ignore framework hype and transient tooling fatigue. Our focus remains steadfast on fundamentals: speed, accessibility, and type safety.
                </p>
              </div>

              <div class="axiom-card">
                <span class="axiom-num">03</span>
                <h3 class="axiom-title">Measured Benchmarks</h3>
                <p class="axiom-desc">
                  Every performance claim is backed by real Lighthouse metrics, payload numbers, and Core Web Vitals telemetry rather than generic marketing jargon.
                </p>
              </div>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. MONUMENTAL BOTTOM CTA BANNER (Dark Obsidian #07080b)                */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="insights-cta-section" aria-label="Get in Touch">
      <div class="insights-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>

        <div class="cta-inner-box">
          <span class="cta-eyebrow">HAVE A COMPLEX ARCHITECTURAL CHALLENGE?</span>
          <h2 class="cta-title">
            Let's Apply These Principles to <span class="cta-highlight">Your System.</span>
          </h2>
          <p class="cta-desc">
            Whether you need a sub-second brand website, an AI integration pipeline, or a complete digital system overhaul, we build with senior craft and zero bloat.
          </p>

          <div class="cta-button-cluster">
            <a href="/contact" class="cta-primary-btn">
              <span>Initiate Project Intake</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="https://wa.me/6285155455953?text=Halo%20Kairav%20Studio,%20saya%20tertarik%20dengan%20layanan%20engineering%20anda"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-outline-btn"
            >
              <span>Direct WhatsApp</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  // Topic Filtering Script
  document.addEventListener("DOMContentLoaded", () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-topic-filter]");
    const dispatchCards = document.querySelectorAll<HTMLElement>(".dispatch-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTopic = btn.getAttribute("data-topic-filter");

        // Update active button state
        filterButtons.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");

        // Filter cards
        dispatchCards.forEach((card) => {
          const cardTopic = card.getAttribute("data-topic");
          if (targetTopic === "all" || cardTopic === targetTopic) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  });
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════ */
  /* SCOPED CLONIX ARCHITECTURAL BLUEPRINT DESIGN SYSTEM                         */
  /* ═══════════════════════════════════════════════════════════════════════════ */

  .insights-page {
    background-color: #07080b;
    color: #f8f5ec;
    font-family: var(--font-body, system-ui, sans-serif);
    overflow-x: hidden;
    position: relative;
  }

  /* ── Layout Containers & Clonix Hairlines ─────────────────────────────────── */
  .insights-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container-light {
    background-color: #f8f5ec;
    color: #111113;
    border-left-color: rgba(7, 20, 21, 0.08);
    border-right-color: rgba(7, 20, 21, 0.08);
  }

  /* ── Corner Crosshairs (+) ────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
    pointer-events: none;
    z-index: 10;
  }

  .container-light .grid-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross--tl { top: -6px; left: -5px; }
  .cross--tr { top: -6px; right: -5px; }
  .cross--bl { bottom: -6px; left: -5px; }
  .cross--br { bottom: -6px; right: -5px; }

  /* ── Hairline Dividers ────────────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    height: 1px;
    z-index: 2;
  }

  .divider-dark {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .divider-light {
    background-color: rgba(7, 20, 21, 0.08);
  }

  .divider-cross {
    position: absolute;
    top: -6px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
  }

  .divider-light .divider-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 24%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid {
      display: block;
    }
  }

  /* ── Band Row: 24% Left Rail / 76% Main Stage ─────────────────────────────── */
  .band-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .band-row {
      grid-template-columns: 24% 76%;
    }
  }

  .band-rail {
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      padding: 3rem 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: none;
    }
  }

  .rail-light {
    border-bottom-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right-color: rgba(7, 20, 21, 0.08);
    }
  }

  .band-main {
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 900px) {
    .band-main {
      padding: 3rem 3rem 4rem 3rem;
    }
  }

  /* ── Rail Components ──────────────────────────────────────────────────────── */
  .rail-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: inherit;
  }

  .rail-slash {
    color: #b6ff5c;
    font-weight: 700;
  }

  .rail-light .rail-slash {
    color: #4f7d18;
  }

  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .rating-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 4px;
    background: rgba(182, 255, 92, 0.06);
    border: 1px solid rgba(182, 255, 92, 0.2);
    width: fit-content;
  }

  .rating-star {
    color: #b6ff5c;
    font-size: 0.85rem;
  }

  .rating-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    color: #f8f5ec;
  }

  .rating-desc {
    font-size: 0.7rem;
    color: #94a3b8;
  }

  .journal-meta-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .meta-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .meta-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .meta-desc {
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* ── 1. Hero Section ──────────────────────────────────────────────────────── */
  .insights-hero-section {
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    background-color: #07080b;
  }

  @media (min-width: 900px) {
    .insights-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .insights-telemetry-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }

  .telemetry-left,
  .telemetry-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .insights-meta-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
