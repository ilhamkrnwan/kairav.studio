<script>
  // Interactive Filter Tabs & FAQ Accordion Handler
  const initServicesPage = () => {
    // 1. Category Filtering
    const filterContainer = document.querySelector(".services-filters-row");
    if (filterContainer && !filterContainer.hasAttribute("data-filter-initialized")) {
      filterContainer.setAttribute("data-filter-initialized", "true");
      const filterButtons = filterContainer.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const serviceCards = document.querySelectorAll<HTMLElement>("[data-service-card]");

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filterCategory = btn.getAttribute("data-filter") || "all";

          filterButtons.forEach((b) => {
            b.classList.remove("is-active");
            b.setAttribute("aria-selected", "false");
          });
          btn.classList.add("is-active");
          btn.setAttribute("aria-selected", "true");

          serviceCards.forEach((card) => {
            const cardCat = card.getAttribute("data-category") || "";
            if (filterCategory === "all" || cardCat === filterCategory) {
              card.style.display = "flex";
              card.style.opacity = "1";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    }

    // 2. FAQ Accordion Handler
    const faqContainer = document.querySelector("[data-faq-group]");
    if (faqContainer && !faqContainer.hasAttribute("data-faq-initialized")) {
      faqContainer.setAttribute("data-faq-initialized", "true");
      const faqRows = faqContainer.querySelectorAll(".faq-item-row");
      faqRows.forEach((row) => {
        const trigger = row.querySelector("[data-faq-trigger]");
        trigger?.addEventListener("click", () => {
          const isCurrentlyExpanded = row.classList.contains("is-expanded");
          row.classList.toggle("is-expanded", !isCurrentlyExpanded);
          trigger.setAttribute("aria-expanded", String(!isCurrentlyExpanded));
        });
      });
    }
  };

  // Support Astro ClientRouter page transitions
  document.addEventListener("DOMContentLoaded", initServicesPage);
  document.addEventListener("astro:page-load", initServicesPage);
  initServicesPage();
</script>
