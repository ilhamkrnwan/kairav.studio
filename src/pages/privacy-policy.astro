---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy & Data Governance — Kairav Studio"
  description="Kairav Studio privacy policy, detailing our data collection practices, inquiry processing, and strict client privacy commitments."
  canonicalPath="/privacy-policy"
>
  <main class="legal-page">

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. DARK BLUEPRINT HERO (#07080b)                                       */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="legal-hero-section" data-hero-section aria-label="Privacy Policy Header">
      <div class="legal-container">
        
        {/* Top Telemetry Header Bar */}
        <div class="legal-telemetry-bar">
          <div class="telemetry-left">
            <span class="telemetry-text">PRIVACY & DATA GOVERNANCE</span>
          </div>
          <div class="telemetry-right">
            <span class="telemetry-text">LAST UPDATED: 2026-10-10</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">YOGYAKARTA, ID</span>
          </div>
          <span class="grid-cross cross--tl" aria-hidden="true">+</span>
          <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        </div>

        {/* 24% / 76% Asymmetric Blueprint Band */}
        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              Legal Dossier
            </div>

            <div class="rail-live-badge">
              Data Protection
            </div>

            <div class="dossier-card">
              <span class="dossier-label">GOVERNANCE LEVEL</span>
              <span class="dossier-val font-accent">Zero Bloat Tracking</span>
              <span class="dossier-desc">No tracking pixels, third-party advertising cookies, or data brokering.</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">COMMUNICATION</span>
              <span class="dossier-val">hello@kairav.studio</span>
              <span class="dossier-desc">Direct inquiries regarding data retention or removal.</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            
            <div class="legal-meta-top">
              <nav class="legal-breadcrumbs" aria-label="Breadcrumbs">
                <a href="/">Studio</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">Privacy Policy</span>
              </nav>

              <span class="legal-badge-pill">
                ACTIVE SPECIFICATION
              </span>
            </div>

            <h1 class="legal-hero-title">
              Privacy &amp; Data <span class="title-highlight">Governance Policy.</span>
            </h1>

            <p class="legal-hero-summary">
              A transparent, engineering-first standard for how Kairav Studio collects, handles, and protects information submitted by website visitors, prospective clients, and partners.
            </p>

            <div class="legal-action-row">
              <a href="/contact" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Contact Studio DPO</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </span>
              </a>

              <a href="/" class="hero-back-link">
                <span aria-hidden="true">←</span>
                <span>Return to Studio Home</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. POLICY SECTIONS (Light Canvas #f8f5ec)                               */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="policy-section" aria-label="Policy Articles">
      <div class="legal-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              Articles
            </div>

            <div class="rail-pill">
              5 Provisions
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · OPERATIONAL DISCLOSURES</span>
              <h2 class="section-title">Data Collection &amp; Protection Principles.</h2>
              <p class="section-desc">
                Clear, straightforward language. We avoid lengthy legal obfuscation in favor of actionable clarity.
              </p>
            </div>

            {/* Articles Stack */}
            <div class="articles-flow">
              
              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 01</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Information We Collect</h3>
                <p class="article-body">
                  When you reach out to Kairav Studio via our intake matrix, contact form, or direct email, we collect only the necessary details you provide: your name, email address, company or project name, timeline, budget range, and technical brief. We do not operate background tracking pixels, fingerprinting scripts, or third-party behavioral profiling.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 02</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">How We Use Your Information</h3>
                <p class="article-body">
                  All submitted data is strictly utilized to evaluate architectural feasibility, formulate technical proposals, schedule discovery calls, and execute agreed engineering deliverables. We never sell, rent, or lease prospective client information to third-party marketing brokers or advertisers.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 03</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Infrastructure &amp; Vetted Subprocessors</h3>
                <p class="article-body">
                  Our digital properties are hosted on secure, modern edge infrastructure (e.g. Cloudflare / GitHub / Vercel). Subprocessors are audited for encryption in transit (TLS 1.3), SOC2/ISO compliance, and zero data selling practices. Private client repositories are managed securely via GitHub Organization accounts with mandatory multi-factor authentication (MFA).
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 04</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Data Retention &amp; Erasure Rights</h3>
                <p class="article-body">
                  You hold full rights under global privacy frameworks (including GDPR, CCPA, and Indonesian PDP Law No. 27/2022) to inspect, rectify, or demand permanent erasure of your inquiry data at any time. Simply dispatch an email to <a href="mailto:hello@kairav.studio" class="inline-legal-link">hello@kairav.studio</a> with the subject line <code>DATA PURGE REQUEST</code> and we will confirm completion within 7 business days.
                </p>
              </article>

              <article class="article-box">
                <div class="article-box__head">
                  <span class="article-num">SECTION 05</span>
                  <span class="article-indicator"></span>
                </div>
                <h3 class="article-title">Direct Studio Contact</h3>
                <p class="article-body">
                  For any questions regarding this Privacy Specification or custom mutual NDA arrangements, reach our engineering leadership team directly at <a href="mailto:hello@kairav.studio" class="inline-legal-link">hello@kairav.studio</a> or via our official WhatsApp channel.
                </p>
              </article>

            </div>

            {/* Bottom Actions */}
            <div class="legal-bottom-nav">
              <a href="/terms" class="legal-sub-link">
                <span>Review Terms of Service</span>
                <span aria-hidden="true">→</span>
              </a>

              <a href="/contact" class="legal-sub-link font-accent-dark">
                <span>Start a Confidential Project Inquiry</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. BOTTOM CTA BANNER (Dark Obsidian #07080b)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="legal-cta-section" aria-label="Get in Touch">
      <div class="legal-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>

        <div class="cta-inner-box">
          <span class="cta-eyebrow">ENTERPRISE CONFIDENTIALITY GUARANTEED</span>
          <h2 class="cta-title">
            Require a Strict Mutual <span class="cta-highlight">Non-Disclosure Agreement?</span>
          </h2>
          <p class="cta-desc">
            We routinely execute bilateral NDAs with seed-stage startups, private enterprises, and agencies prior to technical discovery.
          </p>

          <div class="cta-button-cluster">
            <a href="/contact" class="cta-primary-btn">
              <span>Initiate Project Intake</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="mailto:hello@kairav.studio?subject=NDA%20Inquiry%20-%20Kairav%20Studio"
              class="cta-outline-btn"
            >
              <span>Email Legal Team</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════ */
  /* SCOPED CLONIX ARCHITECTURAL BLUEPRINT DESIGN SYSTEM                         */
  /* ═══════════════════════════════════════════════════════════════════════════ */

  .legal-page {
    background-color: #07080b;
    color: #f8f5ec;
    font-family: var(--font-body, system-ui, sans-serif);
    overflow-x: hidden;
    position: relative;
  }

  /* ── Layout Containers & Clonix Hairlines ─────────────────────────────────── */
  .legal-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container-light {
    background-color: #f8f5ec;
    color: #111113;
    border-left-color: rgba(7, 20, 21, 0.08);
    border-right-color: rgba(7, 20, 21, 0.08);
  }

  /* ── Corner Crosshairs (+) ────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
    pointer-events: none;
    z-index: 10;
  }

  .container-light .grid-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross--tl { top: -6px; left: -5px; }
  .cross--tr { top: -6px; right: -5px; }
  .cross--bl { bottom: -6px; left: -5px; }
  .cross--br { bottom: -6px; right: -5px; }

  /* ── Hairline Dividers ────────────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    height: 1px;
    z-index: 2;
  }

  .divider-dark {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .divider-light {
    background-color: rgba(7, 20, 21, 0.08);
  }

  .divider-cross {
    position: absolute;
    top: -6px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
  }

  .divider-light .divider-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 24%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid {
      display: block;
    }
  }

  /* ── Band Row: 24% Left Rail / 76% Main Stage ─────────────────────────────── */
  .band-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .band-row {
      grid-template-columns: 24% 76%;
    }
  }

  .band-rail {
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      padding: 3rem 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: none;
    }
  }

  .rail-light {
    border-bottom-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right-color: rgba(7, 20, 21, 0.08);
    }
  }

  .band-main {
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 900px) {
    .band-main {
      padding: 3rem 3rem 4rem 3rem;
    }
  }

  /* ── Rail Components ──────────────────────────────────────────────────────── */
  .rail-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: inherit;
  }

  .rail-slash {
    color: #b6ff5c;
    font-weight: 700;
  }

  .rail-light .rail-slash {
    color: #4f7d18;
  }

  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .dossier-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dossier-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .dossier-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .font-accent {
    color: #b6ff5c;
  }

  .dossier-desc {
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* ── 1. Hero Section ──────────────────────────────────────────────────────── */
  .legal-hero-section {
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    background-color: #07080b;
  }

  @media (min-width: 900px) {
    .legal-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .legal-telemetry-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }

  .telemetry-left,
  .telemetry-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .legal-meta-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .legal-breadcrumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.75rem;
    color: #64748b;
  }

  .legal-breadcrumbs a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .legal-breadcrumbs a:hover {
    color: #b6ff5c;
  }

  .crumb-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .crumb-current {
    color: #f8f5ec;
    font-weight: 600;
  }

  .legal-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #b6ff5c;
    background: rgba(182, 255, 92, 0.06);
    border: 1px solid rgba(182, 255, 92, 0.2);
    padding: 0.25rem 0.55rem;
    border-radius: 3px;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #b6ff5c;
  }

  .legal-hero-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2.2rem, 4.8vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .title-highlight {
    color: #b6ff5c;
  }

  .legal-hero-summary {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 820px;
    margin-bottom: 2.25rem;
  }

  .legal-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .clonix-cta-button {
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    background-color: #b6ff5c;
    color: #07080b;
    border: none;
    padding: 3px 3px 3px 18px;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(182, 255, 92, 0.25);
    transition: transform 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }

  .clonix-cta-button:hover {
    background-color: #c9ff7a;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(182, 255, 92, 0.4);
  }

  .clonix-cta-button__text {
    padding-right: 14px;
    color: #07080b;
  }

  .clonix-cta-button__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: #07080b;
    color: #ffffff;
    border-radius: 3px;
    transition: transform 200ms ease;
  }

  .clonix-cta-button:hover .clonix-cta-button__box {
    transform: translateX(2px);
  }

  .hero-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-back-link:hover {
    color: #f8f5ec;
  }

  /* ── Section Headers ──────────────────────────────────────────────────────── */
  .section-header-wrap {
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    display: block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #4f7d18;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    color: #111113;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
    max-width: 680px;
  }

  /* ── 2. Policy Articles ───────────────────────────────────────────────────── */
  .policy-section {
    background-color: #f8f5ec;
    color: #111113;
  }

  .articles-flow {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .article-box {
    background: #ffffff;
