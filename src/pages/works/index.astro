    padding-right: 14px;
    color: #07080b;
  }

  .case-study-cta-btn__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: #07080b;
    color: #ffffff;
    border-radius: 3px;
    transition: transform 200ms ease;
  }

  .case-study-cta-btn:hover .case-study-cta-btn__box {
    transform: translateX(2px);
  }

  /* ── 3. Archive Table ─────────────────────────────────────────────────────── */
  .projects-table-wrap {
