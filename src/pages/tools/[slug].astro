  .rail-tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #f8f5ec;
    text-transform: uppercase;
  }

  .rail-tag--dark { color: #111113; }
  .rail-slash { color: #b6ff5c; margin-right: 0.35rem; }
