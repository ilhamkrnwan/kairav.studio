---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/blog";
import type { BlogPost } from "../../data/blog";

export function getStaticPaths() {
  return blogPosts.map((post) => {
    const related = blogPosts.filter((p) => p.slug !== post.slug);
    return {
      params: { slug: post.slug },
      props: { post, related },
    };
  });
}

interface Props {
  post: BlogPost;
  related: BlogPost[];
}

const { post, related } = Astro.props;

const postImages: Record<string, string> = {
  "why-fast-websites-still-matter": "https://framerusercontent.com/images/jQ4Hi4oiEduhRH7VSroCWQKfILc.png?width=1376&height=768",
  "building-with-an-open-source-spirit": "https://framerusercontent.com/images/Yq4KEmqOVkZqrGpcssu03px94.png?width=1376&height=768",
  "seo-and-geo-for-modern-brands": "https://framerusercontent.com/images/rPuHe16bujQppKTJnkgFk7DPJQ.png?width=1376&height=768",
};

const heroImage = postImages[post.slug] || "https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768";
---

<BaseLayout
  title={`${post.title} — Engineering Insight · Kairav Studio`}
  description={post.description}
  canonicalPath={`/insights/${post.slug}`}
>
  <main class="insight-single-page">

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. DARK BLUEPRINT HERO (#07080b)                                       */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="insight-hero-section" data-hero-section aria-label="Dispatch Header">
      <div class="insight-container">
        
        {/* Top Telemetry Header Bar */}
        <div class="insight-telemetry-bar">
          <div class="telemetry-left">
            <span class="telemetry-dot" aria-hidden="true"></span>
            <span class="telemetry-text">STATUS: PUBLISHED DISPATCH</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">ID: {post.slug.toUpperCase()}</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">{post.date}</span>
          </div>
          <div class="telemetry-right">
            <span class="telemetry-text">DISCIPLINE: {post.category.toUpperCase()}</span>
            <span class="telemetry-sep">·</span>
            <span class="telemetry-text">{post.readingTime.toUpperCase()}</span>
          </div>
          <span class="grid-cross cross--tl" aria-hidden="true">+</span>
          <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        </div>

        {/* 24% / 76% Asymmetric Blueprint Band */}
        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Dispatch Dossier
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Published Paper
            </div>

            <div class="dossier-card">
              <span class="dossier-label">TOPIC CATEGORY</span>
              <span class="dossier-val font-accent">{post.category}</span>
              <span class="dossier-desc">Studio Architecture &amp; Methodology</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">ESTIMATED READING</span>
              <span class="dossier-val">{post.readingTime}</span>
              <span class="dossier-desc">Published on {post.date}</span>
            </div>

            <div class="dossier-card">
              <span class="dossier-label">AUTHORSHIP</span>
              <span class="dossier-val">Kairav Engineering</span>
              <span class="dossier-desc">Collective craft · Yogyakarta (UTC+7)</span>
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            
            <div class="insight-meta-top">
              <nav class="insight-breadcrumbs" aria-label="Breadcrumbs">
                <a href="/insights">Insights</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-cat">{post.category}</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">{post.slug}</span>
              </nav>

              <span class="insight-badge-pill">
                <span class="badge-dot" aria-hidden="true"></span>
                {post.category.toUpperCase()}
              </span>
            </div>

            <h1 class="insight-hero-title">
              {post.title}
            </h1>

            <p class="insight-hero-summary">
              {post.description}
            </p>

            <div class="insight-pills-strip">
              <span class="insight-pill"># {post.category}</span>
              <span class="insight-pill"># {post.date.split("-")[0]}</span>
              <span class="insight-pill"># Engineering</span>
              <span class="insight-pill"># KairavStudio</span>
            </div>

            {/* Action Row */}
            <div class="insight-action-row">
              <a href="/insights" class="hero-back-link">
                <span aria-hidden="true">←</span>
                <span>Back to All Dispatches</span>
              </a>

              <a href="/contact" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Discuss With Engineering Lead</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </span>
              </a>
            </div>

            {/* Cinematic Editorial Cover Media Frame */}
            <div class="dispatch-hero-media">
              <span class="media-tag">FIELD ESSAY · PRODUCTION NOTES</span>
              <span class="media-cross cross--tl" aria-hidden="true">+</span>
              <span class="media-cross cross--tr" aria-hidden="true">+</span>
              <span class="media-cross cross--bl" aria-hidden="true">+</span>
              <span class="media-cross cross--br" aria-hidden="true">+</span>
              <img
                src={heroImage}
                alt={post.title}
                class="dispatch-hero-img"
                loading="eager"
                width="1376"
                height="768"
              />
              <div class="media-caption-bar">
                <div class="caption-left">
                  <span class="caption-id">{post.slug.toUpperCase()} · DISPATCH SPEC</span>
                  <span class="caption-sep">·</span>
                  <span class="caption-cat">{post.category.toUpperCase()}</span>
                </div>
                <div class="caption-right">
                  <span class="caption-time">{post.readingTime.toUpperCase()} · VERIFIED ESSAY</span>
                </div>
              </div>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. ARTICLE BODY READER SECTION (Light Canvas #f8f5ec)                   */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <article class="reader-section" aria-label="Dispatch Content">
      <div class="insight-container container-light">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Reading
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Full Dispatch
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main main-light">
            <div class="section-header-wrap">
              <span class="section-eyebrow">01 · ARCHITECTURAL OBSERVATIONS</span>
              <h2 class="section-title">Analysis &amp; Pragmatic Findings.</h2>
              <p class="section-desc">
                Field findings drawn from direct production metrics, build pipelines, and real user experience audits.
              </p>
            </div>

            {/* Sections Flow */}
            <div class="article-sections-flow">
              {post.sections.map((sec, sIdx) => (
                <div class="article-section-card">
                  <div class="sec-card-head">
                    <span class="sec-step-num">SECTION 0{sIdx + 1}</span>
                    <span class="sec-status-dot"></span>
                  </div>
                  
                  <h3 class="sec-card-title">{sec.heading}</h3>
                  
                  <div class="sec-card-body">
                    <p>{sec.body}</p>
                  </div>
                </div>
              ))}

              {/* Concluding Takeaway Card */}
              <div class="takeaway-box">
                <span class="takeaway-tag">★ SUMMARY MANDATE</span>
                <h4 class="takeaway-title">The Engineering Takeaway</h4>
                <p class="takeaway-text">
                  Choose simplicity and speed every single time. Digital systems should be built to serve human intentions effortlessly without excessive runtime tax.
                </p>
              </div>
            </div>

            {/* Bottom Navigation */}
            <div class="article-nav-bottom">
              <a href="/insights" class="nav-back-btn">
                <span aria-hidden="true">←</span>
                <span>Return to All Insights</span>
              </a>

              <a href="/contact" class="nav-inquire-btn">
                <span>Start a Project</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </article>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-light" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. RELATED DISPATCHES (Dark Obsidian #07080b)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="related-insights-section" aria-label="Related Dispatches">
      <div class="insight-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Archive
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              More Dispatches
            </div>
          </aside>

          {/* Right Main Stage */}
          <div class="band-main">
            <div class="section-header-wrap">
              <div class="header-split-row">
                <div>
                  <span class="section-eyebrow">02 · CONTINUED READING</span>
                  <h2 class="section-title text-light">Related Engineering Notes.</h2>
                </div>
                <a href="/insights" class="catalog-link">
                  <span>View All Dispatches</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            {/* Related Cards Grid */}
            <div class="related-insights-grid">
              {related.map((relPost) => (
                <a href={`/insights/${relPost.slug}`} class="related-insight-card">
                  <div class="related-img-frame">
                    <img
                      src={postImages[relPost.slug] || "https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768"}
                      alt={relPost.title}
                      class="related-img"
                      loading="lazy"
                      width="420"
                      height="230"
                    />
                  </div>
                  <div class="related-meta-top">
                    <span class="related-category">{relPost.category}</span>
                    <span class="related-arrow" aria-hidden="true">→</span>
                  </div>
                  <h3 class="related-title">{relPost.title}</h3>
                  <p class="related-desc">{relPost.description}</p>
                  <div class="related-meta-bottom">
                    <span>{relPost.date}</span>
                    <span>·</span>
                    <span>{relPost.readingTime}</span>
                  </div>
                </a>
              ))}
            </div>

          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* Hairline Divider with Crosshairs */}
    <div class="hairline-divider divider-dark" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. MONUMENTAL BOTTOM CTA BANNER (Dark Obsidian #07080b)                */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="insight-cta-section" aria-label="Get in Touch">
      <div class="insight-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>

        <div class="cta-inner-box">
          <span class="cta-eyebrow">WANT TO ENGINEER HIGH-SPEED SYSTEMS?</span>
          <h2 class="cta-title">
            Let's Collaborate on Your <span class="cta-highlight">Next Release.</span>
          </h2>
          <p class="cta-desc">
            We partner with teams that prioritize high-craft aesthetics, speed, and architectural longevity. Direct senior engineer involvement on every engagement.
          </p>

          <div class="cta-button-cluster">
            <a href="/contact" class="cta-primary-btn">
              <span>Initiate Project Intake</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="https://wa.me/6285155455953?text=Halo%20Kairav%20Studio,%20saya%20tertarik%20dengan%20layanan%20engineering%20anda"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-outline-btn"
            >
              <span>Direct WhatsApp</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════════ */
  /* SCOPED CLONIX ARCHITECTURAL BLUEPRINT DESIGN SYSTEM                         */
  /* ═══════════════════════════════════════════════════════════════════════════ */

  .insight-single-page {
    background-color: #07080b;
    color: #f8f5ec;
    font-family: var(--font-body, system-ui, sans-serif);
    overflow-x: hidden;
    position: relative;
  }

  /* ── Layout Containers & Clonix Hairlines ─────────────────────────────────── */
  .insight-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container-light {
    background-color: #f8f5ec;
    color: #111113;
    border-left-color: rgba(7, 20, 21, 0.08);
    border-right-color: rgba(7, 20, 21, 0.08);
  }

  /* ── Corner Crosshairs (+) ────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
    pointer-events: none;
    z-index: 10;
  }

  .container-light .grid-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross--tl { top: -6px; left: -5px; }
  .cross--tr { top: -6px; right: -5px; }
  .cross--bl { bottom: -6px; left: -5px; }
  .cross--br { bottom: -6px; right: -5px; }

  /* ── Hairline Dividers ────────────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    height: 1px;
    z-index: 2;
  }

  .divider-dark {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .divider-light {
    background-color: rgba(7, 20, 21, 0.08);
  }

  .divider-cross {
    position: absolute;
    top: -6px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.25);
    user-select: none;
  }

  .divider-light .divider-cross {
    color: rgba(7, 20, 21, 0.35);
  }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 24%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid {
      display: block;
    }
  }

  /* ── Band Row: 24% Left Rail / 76% Main Stage ─────────────────────────────── */
  .band-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .band-row {
      grid-template-columns: 24% 76%;
    }
  }

  .band-rail {
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .band-rail {
      padding: 3rem 2rem;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: none;
    }
  }

  .rail-light {
    border-bottom-color: rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .rail-light {
      border-right-color: rgba(7, 20, 21, 0.08);
    }
  }

  .band-main {
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 900px) {
    .band-main {
      padding: 3rem 3rem 4rem 3rem;
    }
  }

  /* ── Rail Components ──────────────────────────────────────────────────────── */
  .rail-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: inherit;
  }

  .rail-slash {
    color: #b6ff5c;
    font-weight: 700;
  }

  .rail-light .rail-slash {
    color: #4f7d18;
  }

  .rail-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .rail-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    color: #64748b;
    background: rgba(7, 20, 21, 0.03);
    border: 1px solid rgba(7, 20, 21, 0.08);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    width: fit-content;
  }

  .rail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4f7d18;
  }

  .dossier-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dossier-label {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.62rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .dossier-val {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8f5ec;
  }

  .font-accent {
    color: #b6ff5c;
  }

  .dossier-desc {
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  /* ── 1. Hero Section ──────────────────────────────────────────────────────── */
  .insight-hero-section {
    padding: clamp(5.5rem, 8vw, 7.5rem) 1rem 0 1rem;
    background-color: #07080b;
  }

  @media (min-width: 900px) {
    .insight-hero-section {
      padding: clamp(6rem, 8vw, 8rem) 1.5rem 0 1.5rem;
    }
  }

  .insight-telemetry-bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.68rem;
    color: #94a3b8;
  }

  .telemetry-left,
  .telemetry-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .insight-meta-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .insight-breadcrumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.75rem;
    color: #64748b;
  }

  .insight-breadcrumbs a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .insight-breadcrumbs a:hover {
    color: #b6ff5c;
