---
import { getLangFromUrl, useTranslations, localizePath } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-blueprint" data-hero-section>
  <!-- Background Atmosphere: ambient glows & architectural hairline column rails -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-atmosphere"></div>
    <div class="hero-bg-lines"></div>
  </div>

  <!-- Giant Ambient Watermark (Rotating Geometric Asterisk on Left) -->
  <div class="hero-watermark" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="currentColor">
      <path d="M100 15 C102 45, 115 58, 145 60 C115 62, 102 75, 100 105 C98 75, 85 62, 55 60 C85 58, 98 45, 100 15 Z" transform="rotate(0 100 100)" opacity="0.85" />
      <path d="M100 15 C102 45, 115 58, 145 60 C115 62, 102 75, 100 105 C98 75, 85 62, 55 60 C85 58, 98 45, 100 15 Z" transform="rotate(45 100 100)" opacity="0.85" />
      <path d="M100 15 C102 45, 115 58, 145 60 C115 62, 102 75, 100 105 C98 75, 85 62, 55 60 C85 58, 98 45, 100 15 Z" transform="rotate(90 100 100)" opacity="0.85" />
      <path d="M100 15 C102 45, 115 58, 145 60 C115 62, 102 75, 100 105 C98 75, 85 62, 55 60 C85 58, 98 45, 100 15 Z" transform="rotate(135 100 100)" opacity="0.85" />
    </svg>
  </div>

  <div class="hero-wrapper">
    <!-- Top System Eyebrow / Coordinate Rail -->
    <div class="blueprint-meta-bar" data-blueprint-meta>
      <div class="blueprint-meta-left">
        <span class="blueprint-status-dot"></span>
        <span class="blueprint-mono">KAIRAV ARCHITECTURAL GRID · SYSTEM MATRIX</span>
      </div>
      <div class="blueprint-meta-right">
        <span class="blueprint-mono">LAT 7.82° S · LON 110.37° E · ACTIVE</span>
      </div>
    </div>

    <!-- The Architectural Blueprint Grid Box -->
    <div class="blueprint-grid-box" data-blueprint-box>
      <!-- Top Rail Crosshairs (+) -->
      <span class="cross cross--tl" aria-hidden="true">+</span>
      <span class="cross cross--tc" aria-hidden="true">+</span>
      <span class="cross cross--tr" aria-hidden="true">+</span>

      <!-- ── UPPER ROW: 3-COLUMN CLONIX HERO MATRIX ────────────────────── -->
      <div class="hero-upper-deck">
        
        <!-- COLUMN 1: Left Rail (// Meet Kairav) -->
        <div class="hero-col hero-col--rail">
          <div class="rail-tag">
            <span class="rail-slashes" aria-hidden="true">//</span>
            <span class="rail-label">Meet Kairav</span>
          </div>
        </div>

        <!-- COLUMN 2: Main Headline, Lead & Founder Proof -->
        <div class="hero-col hero-col--main">
          <!-- Main Monumental Heading -->
          <h1 class="hero-headline">
            We Build Digital Systems That Demand Attention.
          </h1>

          <!-- Lead Description -->
          <p class="hero-description">
            Kairav Studio is an engineering-first design studio that turns bold ideas into high-velocity brand websites, custom digital systems, and AI-ready architectures.
          </p>

          <!-- Primary Action Button (Clonix Style with Arrow Box) -->
          <div class="hero-action-row">
            <a href={localizePath("/services", lang)} class="clonix-cta-btn" id="hero-cta-btn">
              <span class="clonix-cta-btn__text">{t("Services")}</span>
              <span class="clonix-cta-btn__box" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </span>
            </a>
          </div>

          <!-- Founder / Team Social Proof -->
          <div class="hero-founders-row">
            <div class="founders-avatars" aria-hidden="true">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=96&h=96&fit=crop&crop=face"
                alt="Founder avatar 1"
                class="founder-avatar"
                width="36"
                height="36"
                loading="eager"
              />
              <img
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=96&h=96&fit=crop&crop=face"
                alt="Founder avatar 2"
                class="founder-avatar"
                width="36"
                height="36"
                loading="eager"
              />
              <img
                src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=96&h=96&fit=crop&crop=face"
                alt="Founder avatar 3"
                class="founder-avatar"
                width="36"
                height="36"
                loading="eager"
              />
            </div>
            <div class="founders-meta">
              <span class="founders-label">Founded by</span>
              <span class="founders-names"><strong>Ilham, Ryan,</strong> and <strong>Core Team</strong></span>
            </div>
          </div>

          <!-- Client / Trust Proof Row -->
          <div class="hero-trust-bar">
            <span class="trust-bar-label">Trusted by 50+ Modern Companies</span>
            <div class="trust-logos-row" aria-label="Trusted client partners">
              <span class="trust-logo-item">Logoipsum</span>
              <span class="trust-logo-item">SystemX</span>
              <span class="trust-logo-item">Nexus AI</span>
              <span class="trust-logo-item">Avant</span>
            </div>
          </div>
        </div>

        <!-- COLUMN 3: Right Showcase (Award Badge + Phone Mockup + Label) -->
        <div class="hero-col hero-col--showcase">
          <!-- Award Badge (Clonix Style) -->
          <div class="laurel-award-badge" aria-label="Award Winner">
            <div class="award-laurel-wrap">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" class="laurel-icon" aria-hidden="true">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
              <div class="award-text-col">
                <span class="award-main">ULTRA PRESTIGIOUS</span>
                <span class="award-stars">★★★★★</span>
                <span class="award-sub">WINNER</span>
              </div>
            </div>
          </div>

          <!-- Featured Work Header -->
          <div class="featured-work-header">
            <span class="featured-icon" aria-hidden="true">⚡</span>
            <span class="featured-label">Featured Work</span>
          </div>

          <!-- Phone Mockup Container (Mustaka System) -->
          <a href={localizePath("/works", lang)} class="hero-phone-mockup" data-hero-phone aria-label="View Featured Work: Mustaka Automation Platform">
            <div class="phone-mockup__bezel">
              <div class="phone-mockup__speaker" aria-hidden="true"></div>
              <div class="phone-mockup__screen">
                <div class="phone-screen__header">
                  <span class="phone-brand">Mustaka</span>
                  <span class="phone-version">v2.6 Live</span>
                </div>
                <div class="phone-screen__body">
                  <p class="phone-screen__tag">AI & BUSINESS OS</p>
                  <h3 class="phone-screen__title">
                    The future of intelligent automation: adaptive workflows, real-time inventory, and edge API.
                  </h3>
                  <div class="phone-screen__action">
                    <span>Tap to explore</span>
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4"/>
                    </svg>
                  </div>
                </div>
                <!-- Interactive Phone Mockup Metrics -->
                <div class="phone-screen__meta">
                  <span>99.98% Sync</span>
                  <span class="meta-divider" aria-hidden="true">·</span>
                  <span>Sub-45ms API</span>
                </div>
              </div>
            </div>
          </a>

          <!-- Project Caption -->
          <div class="showcase-caption">
            <a href={localizePath("/works", lang)} class="showcase-caption-link">
              Mustaka – AI Automation Platform Launch
            </a>
          </div>
        </div>

      </div>

      <!-- ── LOWER ROW: MONUMENTAL HERO SHOWCASE VIDEO / MEDIA CARD ── -->
      <div class="hero-media-deck">
        <div class="hero-video-frame">
          <!-- Glowing Lime Border Around the Video Frame -->
          <div class="video-frame-border" aria-hidden="true"></div>

          <!-- Video Thumbnail Image (Team Collaboration Session) -->
          <img
            src="https://framerusercontent.com/images/jQ4Hi4oiEduhRH7VSroCWQKfILc.png?width=1264&height=848"
            alt="Kairav Studio engineering team collaborating on digital systems"
            class="video-thumbnail-img"
            width="1264"
            height="848"
            loading="eager"
          />

          <!-- Ambient Overlay Gradient -->
          <div class="video-overlay-gradient" aria-hidden="true"></div>

          <!-- Centered Play Button (Clonix Style) -->
          <button
            type="button"
            class="hero-play-button"
            id="hero-video-play-btn"
            data-magnetic
            aria-label="Play studio collaboration video"
          >
            <span class="play-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </span>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     HERO SECTION — CLONIX ARCHITECTURAL BLUEPRINT LAYOUT
     Dark Obsidian (#07080b) + Neon Lime (#b6ff5c) + Hairline Borders
     ═══════════════════════════════════════════════════════════════════ */

  .hero-blueprint {
    position: relative;
    background-color: #07080b;
    color: #f8f5ec;
    overflow: hidden;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    isolation: isolate;
  }

  /* Background Atmosphere */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-bg-atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 50% at 20% 25%, rgba(79, 125, 24, 0.05), transparent 60%),
      radial-gradient(ellipse 50% 60% at 85% 65%, rgba(182, 255, 92, 0.04), transparent 70%);
  }

  .hero-bg-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, black 30%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, black 30%, transparent 90%);
  }

  /* Rotating Geometric Watermark on Far Left (Clonix Style) */
  .hero-watermark {
    position: absolute;
    top: 5rem;
    left: -8rem;
    width: 32rem;
    height: 32rem;
    color: rgba(255, 255, 255, 0.035);
    pointer-events: none;
    z-index: 1;
    animation: rotateWatermark 80s linear infinite;
  }

  @keyframes rotateWatermark {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Wrapper */
  .hero-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
  }

  /* Meta Bar */
  .blueprint-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.25rem 0.85rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: #71717a;
    text-transform: uppercase;
  }

  .blueprint-meta-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .blueprint-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.5);
    animation: heroPulse 2.5s ease-in-out infinite;
  }

  @keyframes heroPulse {
    0%, 100% { opacity: 0.7; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  /* Grid Box */
  .blueprint-grid-box {
    position: relative;
    background: #090a0e;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    overflow: visible;
  }

  /* Crosshairs (+) */
  .cross {
    position: absolute;
    width: 14px;
    height: 14px;
    line-height: 14px;
    text-align: center;
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.35);
    user-select: none;
    pointer-events: none;
    z-index: 10;
  }

  .cross--tl { top: -7px; left: -7px; }
  .cross--tr { top: -7px; right: -7px; }
  .cross--tc { top: -7px; left: 16%; display: none; }

  @media (min-width: 1024px) {
    .cross--tc { display: block; }
  }

  /* ── Upper Deck: 3-Column Layout ──────────────────────────────────── */
  .hero-upper-deck {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 900px) {
    .hero-upper-deck {
      grid-template-columns: 14% 56% 30%;
    }
  }

  .hero-col {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 900px) {
    .hero-col {
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .hero-col:last-child {
      border-right: none;
    }
  }

  /* Column 1: Left Rail */
  .hero-col--rail {
    background: #07080b;
  }

  .rail-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .rail-slashes {
    color: #b6ff5c;
    font-weight: 700;
  }

  .rail-label {
    color: #f8f5ec;
  }

  /* Column 2: Main Hero Content */
  .hero-col--main {
    background: #0a0b10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-headline {
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: clamp(2.35rem, 4.2vw, 3.85rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #f8f5ec;
    margin: 0 0 1.25rem 0;
  }

  .hero-description {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(0.95rem, 1.2vw, 1.12rem);
    line-height: 1.55;
    color: #a1a1aa;
    margin: 0 0 2rem 0;
    max-width: 38rem;
  }

  /* Clonix Style Action Button */
  .hero-action-row {
    margin-bottom: 2.25rem;
  }

  .clonix-cta-btn {
    display: inline-flex;
    align-items: center;
    background: #b6ff5c;
    color: #07080b;
    text-decoration: none;
    border-radius: 4px;
    padding: 3px 3px 3px 18px;
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms ease,
      box-shadow 200ms ease;
    box-shadow: 0 8px 24px -6px rgba(182, 255, 92, 0.35);
  }

  .clonix-cta-btn:hover {
    background-color: #c9ff7a;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgba(182, 255, 92, 0.45);
  }

  .clonix-cta-btn__text {
    padding-right: 14px;
  }

  .clonix-cta-btn__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #07080b;
    color: #ffffff;
    border-radius: 3px;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .clonix-cta-btn:hover .clonix-cta-btn__box {
    transform: translateX(2px);
  }

  /* Founder Proof Row */
  .hero-founders-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .founders-avatars {
    display: flex;
    align-items: center;
  }

  .founder-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #0a0b10;
    margin-left: -8px;
  }

  .founder-avatar:first-child {
    margin-left: 0;
  }

  .founders-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.8rem;
    color: #a1a1aa;
  }

  .founders-label {
    font-size: 0.72rem;
    color: #71717a;
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .founders-names strong {
    color: #f8f5ec;
  }

  /* Client Trust Bar */
  .hero-trust-bar {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .trust-bar-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: #71717a;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .trust-logos-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .trust-logo-item {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #8e8e93;
    transition: color 180ms ease;
  }

  .trust-logo-item:hover {
    color: #f8f5ec;
  }

  /* Column 3: Right Showcase */
  .hero-col--showcase {
    background: #090a0e;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Laurel Award Badge (Clonix Style) */
  .laurel-award-badge {
    margin-bottom: 1.5rem;
  }

  .award-laurel-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
  }

  .laurel-icon {
    color: #b6ff5c;
  }

  .award-text-col {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .award-main {
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #f8f5ec;
  }

  .award-stars {
    color: #b6ff5c;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .award-sub {
    font-family: var(--font-mono, monospace);
    font-size: 0.5rem;
    color: #71717a;
    letter-spacing: 0.08em;
  }

  /* Featured Work Label */
  .featured-work-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b6ff5c;
  }

  .featured-icon {
    font-size: 0.8rem;
  }

  .hero-col--showcase {
    perspective: 1000px;
  }

  /* Phone Mockup */
  .hero-phone-mockup {
    display: block;
    width: 100%;
    max-width: 17.5rem;
    margin: 0 auto 1.25rem;
    text-decoration: none;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .phone-mockup__bezel {
    position: relative;
    background: #06070a;
    border-radius: 24px;
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 20px 40px -10px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .phone-mockup__speaker {
    width: 44px;
    height: 3.5px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    margin: 4px auto 8px;
  }

  .phone-mockup__screen {
    background:
      radial-gradient(circle at 80% 20%, rgba(79, 125, 24, 0.4), transparent 55%),
      radial-gradient(circle at 20% 80%, rgba(124, 58, 237, 0.3), transparent 60%),
      #0e0f14;
    border-radius: 16px;
    padding: 1rem;
    color: #f8f5ec;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 14.5rem;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5);
  }

  .phone-screen__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono, monospace);
  }

  .phone-brand {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-transform: uppercase;
  }

  .phone-version {
    font-size: 0.6rem;
    font-weight: 500;
    color: #a1a1aa;
    letter-spacing: 0.04em;
  }

  .phone-screen__tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: #a1a1aa;
    margin-bottom: 0.35rem;
  }

  .phone-screen__title {
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin: 0 0 0.85rem 0;
  }

  .phone-screen__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    font-weight: 600;
    color: #b6ff5c;
  }

  .phone-screen__meta {
    margin-top: 0.75rem;
    padding-top: 0.65rem;
