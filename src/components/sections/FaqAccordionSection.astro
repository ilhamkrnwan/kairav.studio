---
/**
 * FaqAccordionSection.astro (Clonix Architectural FAQ Accordion)
 * Light architectural contrast section with hairline blueprint borders,
 * left rail tags, category/item headers, ambient pinwheel watermark,
 * and responsive Q&A layouts.
 */

export interface FaqItem {
  q: string;
  a: string;
}

export interface FaqCategory {
  title: string;
  subtitle?: string;
  items: FaqItem[];
}

interface Props {
  id?: string;
  tag?: string;
  questionsTag?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  showCta?: boolean;
  categories?: FaqCategory[];
  items?: FaqItem[];
}

const defaultCategories: FaqCategory[] = [
  {
    title: "Services & Process",
    subtitle: "Understand how we work and what to expect when partnering with Kairav.",
    items: [
      {
        q: "What type of services do you offer?",
        a: "We specialize in branding, web design, and digital marketing — covering everything from strategy to launch.",
      },
      {
        q: "How long does a typical project take?",
        a: "Most projects are completed within 3–6 weeks, depending on complexity and feedback speed.",
      },
      {
        q: "Can you work with existing brand assets?",
        a: "Yes, we can build upon your current visuals or refresh them for a stronger, more consistent identity.",
      },
    ],
  },
  {
    title: "Pricing & Payments",
    subtitle: "Learn about how we price our work and the payment options available.",
    items: [
      {
        q: "Do you offer monthly and project-based pricing?",
        a: "Yes. We provide both flexible monthly retainers and fixed-price project options based on your goals.",
      },
      {
        q: "What payment methods do you accept?",
        a: "We accept all major cards, bank transfers, and automated invoices for international and local clients.",
      },
      {
        q: "Can I upgrade or change my plan later?",
        a: "Absolutely. You can switch, scale, or customize your plan anytime as your needs evolve.",
      },
    ],
  },
  {
    title: "Support & Revisions",
    subtitle: "Find answers about post-project support, updates, and collaboration.",
    items: [
      {
        q: "Do you offer support after project delivery?",
        a: "Yes, we provide post-launch assistance and maintenance to ensure everything runs smoothly after your site or campaign goes live.",
      },
      {
        q: "How many revisions are included?",
        a: "Each project includes up to three rounds of revisions to make sure you're fully satisfied with the final result.",
      },
      {
        q: "How do you handle communication during projects?",
        a: "We stay connected through Slack, WhatsApp, or email, sharing regular progress reports and staging walkthroughs for full transparency.",
      },
    ],
  },
];

const {
  id = "faq",
  tag = "FAQs",
  questionsTag = "Questions Answered",
  eyebrow,
  title = "Got Questions? We've Got Answers.",
  description = "Everything you need to know before working with us — no jargon, no fine print.",
  ctaText = "Book a Call",
  ctaHref = "/contact",
  showCta = true,
  categories,
  items,
} = Astro.props;

// Determine whether to use categories (passed or default when no flat items provided)
const activeCategories = !items && (categories || defaultCategories);
---

<section class="faq-accordion-section" id={id} data-faq-section>
  {/* Ambient Pinwheel Watermark (Top-Right) */}
  <div class="ambient-pinwheel pinwheel--tr" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" class="pinwheel-svg">
      <g transform="translate(100, 100)" fill="rgba(255, 255, 255, 0.85)">
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(0)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(45)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(90)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(135)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(180)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(225)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(270)" />
        <path d="M0,0 C24,-45 70,-55 90,-35 C80,-12 45,0 0,0" transform="rotate(315)" />
      </g>
    </svg>
  </div>

  <div class="faq-container">
    {/* Corner Crosshairs */}
    <span class="grid-cross cross--tl" aria-hidden="true">+</span>
    <span class="grid-cross cross--tr" aria-hidden="true">+</span>

    {/* ── ROW 1: Header Band ────────────────────────────────────────────── */}
    <div class="band-row band-header">
      <div class="band-rail">
        <div class="rail-tag">
          {tag}
        </div>
      </div>

      <div class="band-main header-main-wrap">
        <div class="header-copy">
          {eyebrow && <span class="faq-eyebrow">{eyebrow}</span>}
          <h2 class="faq-title">{title}</h2>
          {description && <p class="faq-desc">{description}</p>}
        </div>

        {showCta && (
          <a href={ctaHref} class="dark-pill-btn">
            <span>{ctaText}</span>
            <span class="btn-arrow-box" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>

    {/* Horizontal Hairline Divider with Crosshairs */}
    <div class="hairline-divider" aria-hidden="true">
      <span class="divider-cross cross-left">+</span>
      <span class="divider-cross cross-mid">+</span>
      <span class="divider-cross cross-right">+</span>
    </div>

    {/* ── ROW 2: Questions & Accordion Band ─────────────────────────────── */}
    <div class="band-row band-accordion">
      <div class="band-rail">
        <div class="rail-tag">
          {questionsTag}
        </div>
      </div>

      <div class="band-main">
        {/* Categories List (Index Categorized FAQ) */}
        {activeCategories && (
          <div class="faq-categories-list" data-faq-group>
            {activeCategories.map((cat, catIdx) => (
              <div class={`faq-category-item ${catIdx === 0 ? "is-expanded" : ""}`} data-faq-cat={catIdx + 1} data-faq-item>
                <button
                  type="button"
                  class="faq-category-trigger"
                  data-faq-trigger
                  aria-expanded={catIdx === 0 ? "true" : "false"}
                >
                  <div class="trigger-meta-grid">
                    <h3 class="cat-title">{cat.title}</h3>
                    {cat.subtitle && <p class="cat-subtitle">{cat.subtitle}</p>}
                  </div>
                  <span class="cat-toggle-icon" aria-hidden="true">+</span>
                </button>

                <div class="faq-category-body">
                  <div class="faq-category-content">
                    <div class="qa-pairs-list">
                      {cat.items.map((item) => (
                        <div class="qa-item">
                          <div class="qa-question">{item.q}</div>
                          <div class="qa-answer">{item.a}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* Flat Q&A Items List (Subpages Q&A Accordion) */}
        {items && (
          <div class="faq-items-list" data-faq-group>
            {items.map((item, idx) => (
              <div class={`faq-item-row ${idx === 0 ? "is-expanded" : ""}`} data-faq-item={idx}>
                <button
                  type="button"
                  class="faq-item-trigger"
                  data-faq-trigger
                  aria-expanded={idx === 0 ? "true" : "false"}
                >
                  <div class="trigger-left">
                    <span class="faq-index-number">0{idx + 1}</span>
                    <h3 class="faq-question-text">{item.q}</h3>
                  </div>
                  <span class="faq-toggle-icon" aria-hidden="true">+</span>
                </button>

                <div class="faq-item-body">
                  <div class="faq-item-content">
                    <p class="faq-answer-text">{item.a}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    {/* Bottom Crosshairs */}
    <span class="grid-cross cross--bl" aria-hidden="true">+</span>
    <span class="grid-cross cross--br" aria-hidden="true">+</span>
  </div>
</section>

<style>
  /* ── Canvas & Section Frame ───────────────────────────────────────────────── */
  .faq-accordion-section {
    position: relative;
    background-color: #f3f4ef;
    color: #071415;
    padding: 0 1rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .faq-accordion-section {
      padding: 0 1.5rem;
    }
  }

  /* ── Ambient Floral Watermark ─────────────────────────────────────────────── */
  .ambient-pinwheel {
    position: absolute;
    width: 520px;
    height: 520px;
    pointer-events: none;
    z-index: 0;
    user-select: none;
    color: rgba(255, 255, 255, 0.75);
    mix-blend-mode: normal;
  }

  .pinwheel--tr {
    top: -140px;
    right: -120px;
    transform: rotate(15deg);
  }

  .pinwheel-svg {
    width: 100%;
    height: 100%;
  }

  /* ── Main Container Box ───────────────────────────────────────────────────── */
  .faq-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    border-left: 1px solid rgba(7, 20, 21, 0.1);
    border-right: 1px solid rgba(7, 20, 21, 0.1);
    border-top: 1px solid rgba(7, 20, 21, 0.1);
    border-bottom: 1px solid rgba(7, 20, 21, 0.1);
    background-color: rgba(243, 244, 239, 0.7);
    backdrop-filter: blur(2px);
    z-index: 1;
  }

  /* ── Crosshairs ───────────────────────────────────────────────────────────── */
  .grid-cross {
    position: absolute;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(7, 20, 21, 0.35);
    pointer-events: none;
    z-index: 10;
    user-select: none;
  }

  .cross--tl { top: -7px; left: -5px; }
  .cross--tr { top: -7px; right: -5px; }
  .cross--bl { bottom: -7px; left: -5px; }
  .cross--br { bottom: -7px; right: -5px; }

  /* ── Continuous Divider Line ──────────────────────────────────────────────── */
  .hairline-divider {
    position: relative;
    width: 100%;
    height: 1px;
    background-color: rgba(7, 20, 21, 0.1);
    z-index: 2;
  }

  .divider-cross {
    position: absolute;
    top: -7px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 13px;
    line-height: 1;
    color: rgba(7, 20, 21, 0.35);
    user-select: none;
  }

  .cross-left { left: -5px; }
  .cross-mid {
    left: 20%;
    transform: translateX(-50%);
    display: none;
  }
  .cross-right { right: -5px; }

  @media (min-width: 900px) {
    .cross-mid {
      display: block;
    }
  }

  /* ── Band Rows Architecture ───────────────────────────────────────────────── */
  .band-row {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .band-row {
      grid-template-columns: 20% 80%;
    }
  }

  /* ── Left Rail Cell ───────────────────────────────────────────────────────── */
  .band-rail {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid rgba(7, 20, 21, 0.08);
  }

  @media (min-width: 900px) {
    .band-rail {
      padding: 2.75rem 2rem;
      border-right: 1px solid rgba(7, 20, 21, 0.1);
      border-bottom: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .band-accordion .band-rail {
      align-items: flex-start;
      padding-top: 3.25rem;
    }
  }

  .rail-tag {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #617072;
    text-transform: uppercase;
    user-select: none;
  }

  @media (min-width: 900px) {
    .rail-tag {
      writing-mode: vertical-lr;
      transform: rotate(180deg);
      white-space: nowrap;
    }
  }

  /* ── Main Column Content ──────────────────────────────────────────────────── */
  .band-main {
    display: flex;
    flex-direction: column;
  }

  /* ── Header Band ──────────────────────────────────────────────────────────── */
  .header-main-wrap {
    padding: 2.5rem 1.5rem 2rem 1.5rem;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .header-main-wrap {
      padding: 3.25rem 3rem 2.5rem 3rem;
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .header-copy {
    max-width: 680px;
  }

  .faq-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #4f7d18;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .faq-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: #071415;
    margin: 0 0 1rem 0;
  }

  .faq-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: #4a5658;
    margin: 0;
  }

  .dark-pill-btn {
    display: inline-flex;
    align-items: center;
    background-color: #071415;
    color: #f8f5ec;
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 3px 3px 3px 18px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
    align-self: flex-start;
    flex-shrink: 0;
  }

  .dark-pill-btn span:first-child {
    padding-right: 14px;
  }

  .dark-pill-btn:hover {
    background-color: #12282a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(7, 20, 21, 0.15);
  }

  .btn-arrow-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    font-size: 0.85rem;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .dark-pill-btn:hover .btn-arrow-box {
    background-color: #b6ff5c;
    color: #07080b;
    transform: translateX(2px);
  }

  /* ── Categories List ──────────────────────────────────────────────────────── */
  .faq-categories-list {
    display: flex;
    flex-direction: column;
  }

  .faq-category-item {
    border-bottom: 1px solid rgba(7, 20, 21, 0.1);
    transition: background-color 0.2s ease;
  }

  .faq-category-item:last-child {
    border-bottom: none;
  }

  .faq-category-trigger {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 30px;
    align-items: center;
    padding: 2rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .faq-category-trigger {
      padding: 2.75rem 3rem;
    }
  }

  .faq-category-trigger:hover {
    background-color: rgba(7, 20, 21, 0.025);
  }

  .trigger-meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .trigger-meta-grid {
      grid-template-columns: 1fr 1.25fr;
      align-items: baseline;
      gap: 2.5rem;
    }
  }

  .cat-title {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.4rem, 2.3vw, 1.95rem);
    font-weight: 700;
    color: #617072;
    letter-spacing: -0.025em;
    margin: 0;
    transition: color 0.2s ease;
  }

  .faq-category-item.is-expanded .cat-title {
    color: #071415;
  }

  .faq-category-trigger:hover .cat-title {
    color: #071415;
  }

  .cat-subtitle {
    font-size: 0.95rem;
    color: #556264;
    line-height: 1.55;
    margin: 0;
  }

  .cat-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 1.6rem;
    font-weight: 300;
    color: #071415;
    line-height: 1;
    user-select: none;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
    transform-origin: center;
  }

  .faq-category-item.is-expanded .cat-toggle-icon {
    transform: rotate(45deg);
  }

  /* ── Category Body ────────────────────────────────────────────────────────── */
  .faq-category-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-category-item.is-expanded .faq-category-body {
    grid-template-rows: 1fr;
  }

  .faq-category-content {
    overflow: hidden;
    min-height: 0;
  }

  .qa-pairs-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.5rem 1.5rem 2.5rem 1.5rem;
    border-top: 1px solid rgba(7, 20, 21, 0.08);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 260ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .qa-pairs-list {
      padding: 1.5rem 3rem 3rem 3rem;
    }
  }

  .faq-category-item.is-expanded .qa-pairs-list {
    opacity: 1;
    transform: translateY(0);
  }

  .qa-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .qa-item {
      grid-template-columns: 1fr 1.25fr;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .qa-question {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #071415;
    line-height: 1.4;
  }

  .qa-answer {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #4a5658;
  }

  /* ── Flat Items List (Subpages) ───────────────────────────────────────────── */
  .faq-items-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item-row {
    border-bottom: 1px solid rgba(7, 20, 21, 0.1);
    transition: background-color 0.2s ease;
  }

  .faq-item-row:last-child {
    border-bottom: none;
  }

  .faq-item-trigger {
    width: 100%;
    display: grid;
    grid-template-columns: 2.25rem 1fr 28px;
    align-items: baseline;
    gap: 1.25rem;
    padding: 2rem 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .faq-item-trigger {
      padding: 2.5rem 3rem;
      gap: 1.75rem;
    }
  }

  .faq-item-trigger:hover {
    background-color: rgba(7, 20, 21, 0.025);
  }

  .trigger-left {
    display: contents;
  }

  .faq-index-number {
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.85rem;
    font-weight: 700;
    color: #617072;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s ease;
  }

  .faq-item-row.is-expanded .faq-index-number,
  .faq-item-trigger:hover .faq-index-number {
    color: #071415;
  }

  .faq-question-text {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: clamp(1.18rem, 1.9vw, 1.5rem);
    font-weight: 700;
    color: #617072;
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin: 0;
    transition: color 0.2s ease;
  }

  .faq-item-row.is-expanded .faq-question-text,
  .faq-item-trigger:hover .faq-question-text {
    color: #071415;
  }

  .faq-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 1.6rem;
    font-weight: 300;
    color: #071415;
    line-height: 1;
    user-select: none;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
    transform-origin: center;
    justify-self: end;
  }

  .faq-item-row.is-expanded .faq-toggle-icon {
    transform: rotate(45deg);
  }

  .faq-item-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-item-row.is-expanded .faq-item-body {
    grid-template-rows: 1fr;
  }

  .faq-item-content {
    overflow: hidden;
    min-height: 0;
  }

  .faq-answer-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #4a5658;
    margin: 0;
    padding: 0 1.5rem 2rem calc(1.5rem + 2.25rem + 1.25rem);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 260ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .faq-answer-text {
      padding: 0 3rem 2.75rem calc(3rem + 2.25rem + 1.75rem);
      max-width: 58rem;
    }
  }

  .faq-item-row.is-expanded .faq-answer-text {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .faq-item-trigger {
      grid-template-columns: 1.75rem 1fr 24px;
      gap: 0.75rem;
      padding: 1.5rem 1.25rem;
    }

    .faq-answer-text {
      padding: 0 1.25rem 1.5rem calc(1.25rem + 1.75rem + 0.75rem);
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const setupFaqAccordion = () => {
    const sections = document.querySelectorAll<HTMLElement>("[data-faq-section]");
    sections.forEach((section) => {
      if (section.hasAttribute("data-faq-initialized")) return;
      section.setAttribute("data-faq-initialized", "true");

      const groups = section.querySelectorAll("[data-faq-group]");
      groups.forEach((group) => {
        const items = group.querySelectorAll("[data-faq-item], [data-faq-cat]");

        items.forEach((item) => {
          const trigger = item.querySelector("[data-faq-trigger]");

          trigger?.addEventListener("click", (e) => {
            e.preventDefault();
            const isCurrentlyExpanded = item.classList.contains("is-expanded");
            item.classList.toggle("is-expanded", !isCurrentlyExpanded);
            trigger.setAttribute("aria-expanded", String(!isCurrentlyExpanded));
          });
        });
      });
    });
  };

  document.addEventListener("DOMContentLoaded", setupFaqAccordion);
  document.addEventListener("astro:page-load", setupFaqAccordion);
  setupFaqAccordion();
</script>
