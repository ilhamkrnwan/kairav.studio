---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import SectionHeading from "../../components/common/SectionHeading.astro";
import ContributorCard from "../../components/cards/ContributorCard.astro";
import CTASection from "../../components/sections/CTASection.astro";
import DarkAccentSection from "../../components/sections/DarkAccentSection.astro";
import PageHero from "../../components/sections/PageHero.astro";
import Badge from "../../components/common/Badge.astro";
import { getContributors } from "../../data/contributors";
import { getDict, getLangFromUrl, getLocalePaths } from "../../i18n/ui";

export function getStaticPaths() {
  return getLocalePaths();
}

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang).about;
const contributors = getContributors(lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description}>
  <main>
    <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} description={t.hero.description} />

    <section class="section-spacing">
      <Container>
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
          <SectionHeading
            eyebrow={t.positioning.eyebrow}
            title={t.positioning.title}
            description={t.positioning.description}
          />
          <div class="grid gap-4">
            {t.positioning.items.map((item) => (
              <div class="card-surface p-5">
                <h2 class="font-heading text-xl font-semibold text-[var(--color-text)]">{item}</h2>
                <p class="mt-3 text-sm leading-6 text-[var(--color-text-soft)]">
                  {t.positioning.itemBody}
                </p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <DarkAccentSection>
      <div class="max-w-2xl">
        <Badge class="border-[var(--color-primary)]/30 bg-[var(--color-primary-soft)] text-[var(--color-primary)]">{t.openSource.badge}</Badge>
        <h2 class="mt-5 font-heading text-3xl font-semibold leading-tight text-white sm:text-4xl">
          {t.openSource.title}
        </h2>
        <p class="mt-4 text-base leading-7 text-[var(--color-text-soft)]">
          {t.openSource.description}
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {t.openSource.values.map((value) => (
          <article class="card-surface p-6">
            <h3 class="font-heading text-xl font-semibold text-white">{value}</h3>
            <p class="mt-4 text-sm leading-6 text-[var(--color-text-soft)]">
              {t.openSource.valueBody}
            </p>
          </article>
        ))}
      </div>
    </DarkAccentSection>

    <section class="section-spacing">
      <Container>
        <SectionHeading
          eyebrow={t.contributors.eyebrow}
          title={t.contributors.title}
          description={t.contributors.description}
        />
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {contributors.map((contributor) => <ContributorCard contributor={contributor} />)}
        </div>
      </Container>
    </section>

    <CTASection />
  </main>
</BaseLayout>
