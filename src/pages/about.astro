<script>
  function setupAboutFaq() {
    const group = document.querySelector("[data-faq-group]");
    if (!group || group.hasAttribute("data-faq-initialized")) return;
    group.setAttribute("data-faq-initialized", "true");

    const items = group.querySelectorAll("[data-faq-item]");
    items.forEach((item) => {
      const trigger = item.querySelector("[data-faq-trigger]");
      const icon = item.querySelector(".faq-toggle-icon");

      trigger?.addEventListener("click", () => {
        const isExpanded = item.classList.contains("is-expanded");

        items.forEach((other) => {
          other.classList.remove("is-expanded");
          const otherTrigger = other.querySelector("[data-faq-trigger]");
          const otherIcon = other.querySelector(".faq-toggle-icon");
          if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
          if (otherIcon) otherIcon.textContent = "+";
        });

        if (!isExpanded) {
          item.classList.add("is-expanded");
          trigger.setAttribute("aria-expanded", "true");
          if (icon) icon.textContent = "×";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupAboutFaq);
</script>
