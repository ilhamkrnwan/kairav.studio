---
import type { Contributor } from "../../data/contributors";

interface Props {
  contributor: Contributor;
}

const { contributor } = Astro.props;
---

<article class="card-surface flex h-full gap-4 p-5">
  <img
    src={contributor.avatar}
    alt=""
    class="h-14 w-14 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-soft)] object-cover"
    loading="lazy"
  />
  <div>
    <h3 class="font-heading text-lg font-semibold text-[var(--color-text)]">{contributor.name}</h3>
    <p class="mt-1 text-xs font-semibold uppercase text-[var(--color-primary)]">{contributor.role}</p>
    <p class="mt-3 text-sm leading-6 text-[var(--color-text-soft)]">{contributor.bio}</p>
    <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold text-[var(--color-text)]">
      <a class="link-accent" href={contributor.githubUrl}>GitHub</a>
      {contributor.portfolioUrl && <a class="link-accent" href={contributor.portfolioUrl}>Portfolio</a>}
    </div>
  </div>
</article>
