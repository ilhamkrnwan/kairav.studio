---
/**
 * src/pages/teams.astro
 * Architectural Blueprint Teams Page for Kairav Studio.
 * Designed to seamlessly match the Clonix aesthetic of index.astro, services.astro, and contact.astro:
 * 1. Dark Blueprint Hero with telemetry bar, studio collective status, and engineering guarantees.
 * 2. Light Canvas Core Roster Showcase Matrix with deep architectural member cards.
 * 3. Extended Specialist Network Pods ("Core + On-Demand Specialists").
 * 4. Dark Obsidian Studio Culture & Operating Axioms.
 * 5. Prospective Client Team Collaboration FAQ Accordion.
 * 6. Monumental Bottom CTA Banner leading to /contact.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { contributors } from "../data/contributors";

// Enhanced member metrics & highlights for the architectural cards
const memberHighlights: Record<string, { badge: string; metrics: string[]; quote: string; location: string }> = {
  ilhamkrnwan: {
    badge: "SYSTEM ARCHITECT & LEAD",
    metrics: ["50+ Systems Shipped", "Astro & Fullstack Lead", "8+ Years Engineering"],
    quote: "Building resilient web systems where high visual craft meets zero-bloat static architecture.",
    location: "Yogyakarta (UTC+7)",
  },
  "Reyyy-05": {
    badge: "MOBILE & CLIENT SYSTEMS",
    metrics: ["BioLearn & MasjidFlow", "React Native / Expo Lead", "Cross-Platform Core"],
    quote: "Crafting fluid, offline-first mobile apps that feel tactile, responsive, and durable in the field.",
    location: "Yogyakarta (UTC+7)",
  },
  fantzyyy: {
    badge: "SECURITY & API HARDENING",
    metrics: ["CTF Offensive Security", "Zero-Trust Backend", "API Hardening Lead"],
    quote: "Hardening APIs, reviewing architecture for zero-day vulnerabilities, and scaling clean serverless logic.",
    location: "Yogyakarta (UTC+7)",
  },
};

// Extended specialist network capabilities
const specialistPods = [
  {
    code: "POD-01",
    discipline: "Brand & Technical Copywriting",
    leadTime: "On-Demand per Sprint",
    desc: "Positioning architecture, conversion-focused product storytelling, technical developer documentation, and microcopy that converts.",
    skills: ["Product Positioning", "Tone of Voice", "Technical Writing", "Conversion UX"],
  },
  {
    code: "POD-02",
    discipline: "3D WebGL & Motion Physics",
    leadTime: "On-Demand per Sprint",
    desc: "Interactive Three.js canvas experiences, GLSL custom shaders, and GSAP layout physics that give digital platforms signature brand identities.",
    skills: ["Three.js", "GLSL Shaders", "GSAP Physics", "Canvas Animation"],
  },
  {
    code: "POD-03",
    discipline: "Data Ops & Machine Intelligence",
    leadTime: "On-Demand per Sprint",
    desc: "Vector embeddings, prompt caching pipelines, fine-tuned retrieval systems, and BigQuery data transformations that automate core workflows.",
    skills: ["Vector DBs", "Prompt Caching", "PostgreSQL / Supabase", "BigQuery SQL"],
  },
  {
    code: "POD-04",
    discipline: "Cloud Infrastructure & DevOps",
    leadTime: "On-Demand per Sprint",
    desc: "Cloudflare Workers edge setups, Docker container orchestration, automated GitHub Actions CI/CD pipelines, and zero-downtime database migrations.",
    skills: ["Cloudflare Edge", "Docker / Podman", "GitHub Actions CI", "Zero-Downtime Deploy"],
  },
];

// Operating Axioms & Culture
const operatingAxioms = [
  {
    num: "01",
    tag: "Autonomy",
    title: "High Autonomy, Zero Bureaucracy",
    desc: "We ship at exceptional velocity because every lead has direct architectural agency. No five-layer approval chains or political account hierarchies.",
  },
  {
    num: "02",
    tag: "Reality",
    title: "Code Is The Ground Truth",
    desc: "Figma files and slide decks are hypotheses. Responsive, accessible, sub-100ms code running in a browser is reality. We validate in production early.",
  },
  {
    num: "03",
    tag: "Integrity",
    title: "Open Source Mindset",
    desc: "We contribute to public repositories, publish reusable Astro utilities, and build systems with clean boundaries that any future developer can inspect.",
  },
  {
    num: "04",
    tag: "Velocity",
    title: "Relentless Respect For Speed",
    desc: "Speed is a core feature. We optimize Core Web Vitals to 100/100, eliminate unused runtime dependencies, and respect both user bandwidth and battery.",
  },
];

// Team Collaboration FAQ
const teamFaqs = [
  {
    q: "How do we interact with the team during an active project?",
    a: "You communicate directly with the engineers building your system. We set up a shared Slack or Discord channel, provide weekly async video walkthroughs (Loom) with preview deployment links, and maintain transparent task boards in Linear or GitHub. No intermediary account managers.",
  },
  {
    q: "Can Kairav Studio embed directly into our existing engineering squad?",
    a: "Yes. We frequently operate as a specialized strike team — embedding alongside your internal tech leads for frontend migrations, design system rollouts, mobile app development, or security hardening sprints, opening PRs directly into your repositories.",
  },
  {
    q: "What time zone does the team operate in?",
    a: "Our core leads are based in Yogyakarta, Indonesia (UTC+7 / Western Indonesia Time). We offer deep working hours overlap with Singapore/APAC (UTC+8), Australia (AEST), EMEA morning hours, and async workflows structured for North American teams.",
  },
  {
    q: "How are responsibilities divided across the core roster?",
    a: "Ilham leads overall technical architecture, design systems, and web performance. Reyhan directs mobile applications, offline-first client data, and interactive frontend modules. Moriarty oversees backend APIs, security posture, zero-trust audits, and database schemas.",
  },
  {
    q: "Can we talk with the technical leads before signing a contract?",
    a: "Yes, absolutely. Discovery and scoping sessions are conducted directly by the lead engineers who will write the code — giving you honest feasibility assessments, realistic timelines, and clear architectural recommendations from day one.",
  },
];
---

<BaseLayout
  title="Teams & Engineering Collective — Kairav Studio"
  description="Meet the core team and engineering collective behind Kairav Studio — senior engineers building high-velocity web platforms, mobile systems, and secure APIs."
>
  <main class="teams-page-main">
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. HERO BAND (Dark Blueprint Architecture)                             */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="teams-hero-section" data-hero-section aria-label="Team Overview">
      {/* Background Rotating Watermark */}
      <div class="hero-watermark" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" class="rotor-svg">
          <path
            d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.6142 50 100C50 72.6142 72.6142 50 100 50C72.6142 50 50 27.6142 50 0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <div class="teams-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        {/* Top Blueprint Telemetry Bar */}
        <div class="blueprint-meta-bar" aria-hidden="true">
          <div class="blueprint-meta-left">
            <span class="blueprint-status-dot"></span>
            <span class="blueprint-mono">STATUS: ACTIVE · CORE ROSTER & SPECIALIST NETWORK · YOGYAKARTA (UTC+7)</span>
          </div>
          <div class="blueprint-meta-right">
            <span class="blueprint-mono">LEAN SENIOR COLLECTIVE · ZERO ACCOUNT LAYERS · DIRECT COMMITS</span>
          </div>
        </div>

        <div class="band-row hero-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Studio Collective
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              03 Core Leads Active
            </div>

            {/* Rating Pill */}
            <div class="rating-badge">
              <div class="rating-star-box">
                <span class="star-icon">★</span>
                <span class="rating-val">4.9</span>
              </div>
              <span class="rating-sub">50+ Shipped Systems</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">DELIVERY MODEL</span>
              <span class="spec-value">Lead-Driven Pods</span>
              <span class="spec-detail">Direct engineering accountability. No account-manager telephone games.</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">HEADQUARTERS</span>
              <span class="spec-value">Yogyakarta, ID</span>
              <span class="spec-detail">Western Indonesia Time (UTC+7) with global async alignment.</span>
            </div>
          </aside>

          {/* Main Hero Stage */}
          <div class="band-main">
            <div class="hero-header-wrap">
              <span class="hero-eyebrow">THE ARCHITECTS & BUILDERS</span>
              <h1 class="hero-title">
                Small Core Team. <span class="hero-highlight">Full-Stack Architectural Range.</span>
              </h1>
              <p class="hero-desc">
                Kairav Studio is a design-led engineering collective based in Yogyakarta. We bridge high-craft visual aesthetics with hardened backend architecture, low-latency mobile apps, and resilient cloud systems.
              </p>
            </div>

            {/* Guarantees & Operating Commitments Strip */}
            <div class="hero-standards-strip">
              <div class="standard-chip">
                <span class="chip-val">100% Senior Craft</span>
                <span class="chip-sub">Zero delegation to junior contractors.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Direct Slack Sync</span>
                <span class="chip-sub">Talk directly with the engineers building your code.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Weekly Loom Demos</span>
                <span class="chip-sub">Interactive video walkthroughs on private staging PRs.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Open Source Proven</span>
                <span class="chip-sub">Public repositories, transparent notes, vetted code.</span>
              </div>
            </div>

            {/* Action buttons */}
            <div class="hero-action-row">
              <a href="#core-roster" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Meet the Roster</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3v10M4 9l4 4 4-4"/>
                  </svg>
                </span>
              </a>

              <a href="/contact" class="hero-outline-btn">
                <span>Start a Project with Us</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            {/* Studio Engineering Collective Workspace Frame */}
            <div class="teams-hero-media-frame">
              <span class="frame-tag">ENGINEERING LAB · YOGYAKARTA</span>
              <span class="frame-cross cross--tl" aria-hidden="true">+</span>
              <span class="frame-cross cross--tr" aria-hidden="true">+</span>
              <span class="frame-cross cross--bl" aria-hidden="true">+</span>
              <span class="frame-cross cross--br" aria-hidden="true">+</span>
              <img
                src="https://framerusercontent.com/images/Yq4KEmqOVkZqrGpcssu03px94.png?width=1376&height=768"
                alt="Kairav Studio engineering and architecture workshop"
                class="teams-hero-img"
                loading="eager"
                width="1376"
                height="768"
              />
              <div class="frame-caption">
                <div class="caption-left">
                  <span class="caption-id">STUDIO CORE LAB · LAT 7.82° S · LON 110.37° E</span>
                  <span class="caption-sep">·</span>
                  <span class="caption-status">DIRECT SENIOR INVOLVEMENT</span>
                </div>
                <div class="caption-right">
                  <span class="caption-tech">FULLSTACK · CLOUD · MOBILE · UI CRAFT</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. CORE ROSTER MATRIX (Light Canvas #f8f5ec)                           */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="roster-matrix-section" id="core-roster" aria-label="Core Team Roster">
      <div class="teams-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Core Leads
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Direct Accountability
            </div>

            <div class="roster-meta-note">
              <span class="meta-label">ROSTER VOLUME</span>
              <span class="meta-val">{contributors.length} Core Partners</span>
              <span class="meta-desc">Hands-on technical leadership across all studio engagements.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">01 · THE BUILDERS</span>
              <h2 class="matrix-title">The People Behind Every Shipped System.</h2>
              <p class="matrix-desc">
                No handoffs to junior contractors or outsourced teams. The developers you speak with in discovery are the ones writing your tests, optimizing your payloads, and deploying your code.
              </p>
            </div>

            {/* Architectural Member Cards Grid */}
            <div class="roster-cards-grid">
              {contributors.map((member, index) => {
                const extra = memberHighlights[member.handle || ""] || {
                  badge: "CORE ENGINEER",
                  metrics: ["Fullstack Engineer", "Production Lead"],
                  quote: member.bio,
                  location: "Yogyakarta (UTC+7)",
                };

                return (
                  <article class="architectural-member-card" id={`member-${member.handle || index}`}>
                    {/* Corner Crosshairs */}
                    <span class="member-cross cross--tl" aria-hidden="true">+</span>
                    <span class="member-cross cross--tr" aria-hidden="true">+</span>
                    <span class="member-cross cross--bl" aria-hidden="true">+</span>
                    <span class="member-cross cross--br" aria-hidden="true">+</span>

                    {/* Card Header with Avatar & Identity */}
                    <div class="member-header">
                      <div class="member-avatar-frame">
                        <img
                          src={member.avatar}
                          alt={member.name}
                          class="member-avatar-img"
                          width="84"
                          height="84"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="avatar-status-ping" title="Online / Active Studio Member"></span>
                      </div>

                      <div class="member-title-box">
                        <div class="member-role-badge">
                          <span class="role-badge-dot"></span>
                          <span class="role-badge-text">{extra.badge}</span>
                        </div>
                        <h3 class="member-full-name">{member.name}</h3>
                        {member.handle && (
                          <a
                            href={member.githubUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="member-handle-link"
                          >
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                            </svg>
                            <span>@{member.handle}</span>
                          </a>
                        )}
                      </div>
                    </div>

                    {/* Member Quote / Philosophy */}
                    <blockquote class="member-quote">
                      "{extra.quote}"
                    </blockquote>

                    {/* Bio Detail */}
                    <p class="member-bio-text">{member.bio}</p>

                    {/* Specialized Discipline Badges */}
                    {member.skills && member.skills.length > 0 && (
                      <div class="member-skills-section">
                        <span class="skills-section-label">SPECIALIZED PROTOCOLS & STACK:</span>
                        <div class="member-skills-chips">
                          {member.skills.map((skill) => (
                            <span class="skill-blueprint-pill">{skill}</span>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Architectural Highlights / Metrics */}
                    <div class="member-metrics-strip">
                      {extra.metrics.map((metric) => (
                        <div class="metric-item">
                          <span class="metric-bullet">›</span>
                          <span class="metric-text">{metric}</span>
                        </div>
                      ))}
                    </div>

                    {/* Action Links Bar */}
                    <div class="member-links-bar">
                      <a
                        href={member.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="member-btn-primary"
                        aria-label={`View ${member.name} on GitHub`}
                      >
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                          <path d="M9 18c-4.51 2-5-2-7-2"/>
                        </svg>
                        <span>GitHub Profile</span>
                      </a>

                      {member.portfolioUrl && (
                        <a
                          href={member.portfolioUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="member-btn-secondary"
                          aria-label={`Visit ${member.name}'s portfolio`}
                        >
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="12" x2="21" y2="3"></line>
                          </svg>
                          <span>Portfolio</span>
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>

            {/* Editorial Collaboration Note */}
            <div class="team-editorial-banner">
              <div class="editorial-left">
                <span class="editorial-badge">// SQUAD ARCHITECTURE</span>
                <h4 class="editorial-title">Agile Core, Senior On-Demand Scaling.</h4>
                <p class="editorial-desc">
                  We collaborate with an established network of vetted visual designers, motion specialists, and infrastructure engineers per project. Clients get direct senior leadership with zero agency overhead.
                </p>
              </div>
              <div class="editorial-action">
                <a href="/contact" class="editorial-btn">
                  <span>Inquire About Team Fit</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. EXTENDED SPECIALIST NETWORK PODS (Light Canvas #f8f5ec)            */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="specialists-section" aria-label="Specialist Network">
      <div class="teams-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Specialist Squad
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              On-Demand Network
            </div>

            <div class="roster-meta-note">
              <span class="meta-label">EXPANSION MODEL</span>
              <span class="meta-val">4 Specialist Pods</span>
              <span class="meta-desc">Deep domain capability activated when project complexity requires it.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">02 · EXTENDED DOMAIN EXPERTISE</span>
              <h2 class="matrix-title">Specialist Network Pods.</h2>
              <p class="matrix-desc">
                For complex engagements requiring bespoke motion design, deep LLM pipelines, or enterprise security penetration tests, we assemble vetted domain specialists who integrate directly into our workflow.
              </p>
            </div>

            {/* 4 Pods Grid */}
            <div class="specialist-pods-grid">
              {specialistPods.map((pod) => (
                <div class="specialist-pod-card">
                  <div class="pod-top-bar">
                    <span class="pod-code-badge">{pod.code}</span>
                    <span class="pod-lead-time">{pod.leadTime}</span>
                  </div>

                  <h3 class="pod-discipline-title">{pod.discipline}</h3>
                  <p class="pod-desc-text">{pod.desc}</p>

                  <div class="pod-skills-chips">
                    {pod.skills.map((skill) => (
                      <span class="pod-chip">{skill}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. STUDIO CULTURE & OPERATING AXIOMS (Dark Canvas #07080b)             */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="axioms-section" aria-label="Studio Culture and Axioms">
      <div class="teams-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Engineering Culture
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              4 Core Axioms
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">CULTURE METRIC</span>
              <span class="spec-value">Radical Clarity</span>
              <span class="spec-detail">Honest engineering estimates, transparent commits, and zero corporate posturing.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main">
            <div class="axioms-header-wrap">
              <span class="axioms-eyebrow">03 · HOW WE WORK TOGETHER</span>
              <h2 class="axioms-title">Our Operating Principles.</h2>
              <p class="axioms-desc">
                We believe the best software is built by small, highly disciplined teams that value craftsmanship over ceremony.
              </p>
            </div>

            {/* 4 Axioms Grid */}
            <div class="axioms-grid">
              {operatingAxioms.map((axiom) => (
                <div class="axiom-card">
                  <div class="axiom-num-row">
                    <span class="axiom-number">{axiom.num}</span>
