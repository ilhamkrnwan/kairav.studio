---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Badge from "../../../components/common/Badge.astro";
import Container from "../../../components/common/Container.astro";
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import { getInsights } from "../../../lib/content";
import { formatDate, getDict, getLangFromUrl, getLocalePaths, localizePath } from "../../../i18n/ui";

export function getStaticPaths() {
  return getLocalePaths();
}

const lang = getLangFromUrl(Astro.url);
const t = getDict(lang).insightsPage;
const posts = await getInsights(lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
>
  <main>
    <PageHero
      eyebrow={t.hero.eyebrow}
      title={t.hero.title}
      description={t.hero.description}
    />

    <section class="section-spacing">
      <Container>
        <div class="grid gap-5 md:grid-cols-3">
          {posts.map((post) => (
            <a href={localizePath(`/insights/${post.slug}`, lang)} class="card-surface group block p-6">
              <Badge>{post.category}</Badge>
              <h2 class="mt-6 font-heading text-2xl font-semibold text-[var(--color-text)] group-hover:text-[var(--color-primary)]">
                {post.title}
              </h2>
              <p class="mt-4 text-sm leading-6 text-[var(--color-text-soft)]">{post.description}</p>
              <p class="mt-6 font-mono text-xs text-[var(--color-text-subtle)]">
                {formatDate(post.pubDate, lang)} / {post.readingTime}
              </p>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <CTASection />
  </main>
</BaseLayout>
