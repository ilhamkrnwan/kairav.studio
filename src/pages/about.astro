---
/**
 * src/pages/about.astro
 * Architectural Blueprint About Page for Kairav Studio.
 * Designed to seamlessly match the Clonix aesthetic of index.astro, services.astro, teams.astro, and contact.astro:
 * 1. Dark Blueprint Hero with telemetry bar, studio dossier status, and engineering pillars.
 * 2. Light Canvas Studio Philosophy & 3 Operating Principles.
 * 3. Dark Obsidian Founder & Leadership Spotlight (with direct link to /teams).
 * 4. Light Canvas Studio Evolution & Milestone Timeline (2022 to 2026).
 * 5. Dark Obsidian Comparison Matrix: Traditional Agency vs Kairav Collective.
 * 6. Light Canvas Studio FAQ Accordion.
 * 7. Monumental Bottom CTA Banner leading to /contact.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { contributors } from "../data/contributors";

// 3 Core Studio Operating Principles
const studioValues = [
  {
    num: "01",
    tag: "Simplicity",
    title: "Clarity Before Complexity",
    desc: "We reject premature abstractions, unnecessary dependencies, and framework theater. The simplest, most transparent architecture that solves the problem is always superior.",
    points: [
      "Zero unnecessary npm dependencies",
      "Readable, self-documenting codebases",
      "Predictable state without cognitive overhead",
    ],
  },
  {
    num: "02",
    tag: "Latency",
    title: "Performance as Brand Authority",
    desc: "Speed is not just a technical metric; it is the visceral first impression of your company. Sub-100ms response times communicate precision, engineering respect, and credibility.",
    points: [
      "100/100 target Core Web Vitals",
      "Sub-100ms server response & edge delivery",
      "Minimal main-thread JavaScript execution",
    ],
  },
  {
    num: "03",
    tag: "Openness",
    title: "Open Source Spirit & Total IP Ownership",
    desc: "We build in the open. Our engineering patterns are publicly inspectable, our utilities are shared, and clients retain 100% ownership of their repositories with zero proprietary vendor lock-in.",
    points: [
      "Public repositories & open source contributions",
      "Clean handoff documentation for your team",
      "Zero proprietary CMS or closed-source lock-in",
    ],
  },
];

// 4-Stage Studio Timeline
const studioMilestones = [
  {
    year: "2022",
    phase: "PHASE 01",
    title: "The Inception & Lab Formation",
    desc: "Founded in Yogyakarta as an independent engineering lab by senior developers who were tired of agency bureaucracy and sluggish, bloated websites.",
    achievement: "First 10 bespoke web systems shipped.",
    image: "https://framerusercontent.com/images/aHX2BnKMKr0LkJqGw1RcII9s5bQ.png?width=1376&height=768",
  },
  {
    year: "2023",
    phase: "PHASE 02",
    title: "Fullstack Systems & Mobile Expansion",
    desc: "Expanded capabilities into cross-platform mobile apps (React Native/Expo), real-time SQLite syncing, and hardened API architectures.",
    achievement: "Shipped flagship BioLearn mobile platform.",
    image: "https://framerusercontent.com/images/2PmXnNCt00qT9vzYVb3QaUnf4zw.png?width=1376&height=768",
  },
  {
    year: "2024",
    phase: "PHASE 03",
    title: "Open Source Initiatives & Community Impact",
    desc: "Launched community-driven open source systems including MasjidFlow, scaling to thousands of active users with robust offline capabilities.",
    achievement: "MasjidFlow active deployments in 20+ communities.",
    image: "https://framerusercontent.com/images/XjlU11jxUwW1F9YareI2KWN9h7U.png?width=1376&height=768",
  },
  {
    year: "2025–2026",
    phase: "PHASE 04",
    title: "The Architectural Blueprint Era",
    desc: "Pioneered the Clonix blueprint design system, sub-100ms static Astro pipelines, and Generative Engine Optimization (GEO) for global ambitious brands.",
    achievement: "50+ Shipped Systems · 100% Senior Pod Model.",
    image: "https://framerusercontent.com/images/9zKvRtHkgdsk6GrAEumhiKXosI.png?width=1376&height=768",
  },
];

// Agency vs Kairav Studio Comparison
const agencyComparison = [
  {
    dimension: "Team Composition",
    traditional: "Senior pitch team handsoff to junior contractors",
    kairav: "100% Senior engineers writing every commit",
  },
  {
    dimension: "Turnaround Time",
    traditional: "3 to 6 months weighed down by bureaucratic reviews",
    kairav: "2 to 4 weeks for brand systems; 4 to 8 for web apps",
  },
  {
    dimension: "Technology Stack",
    traditional: "Bloated WordPress, heavy Webflow, or brittle page-builders",
    kairav: "Zero-bloat Astro, TypeScript, and modern edge runtimes",
  },
  {
    dimension: "Client Communication",
    traditional: "Indirect telephone games through junior account managers",
    kairav: "Direct Slack channel and weekly async Loom walkthroughs",
  },
  {
    dimension: "Code Ownership",
    traditional: "Proprietary plugin ecosystems and host lock-in",
    kairav: "100% Clean GitHub repo ownership with full documentation",
  },
];

// About / Studio FAQ
const aboutFaqs = [
  {
    q: "What makes Kairav Studio different from typical digital agencies?",
    a: "We are an engineering-led collective, not an account-management agency. You work directly with senior architects who write and review your code. We don't mark up junior developer hours, and we don't build on fragile, sluggish page builders. Every project is built for longevity and performance.",
  },
  {
    q: "Where is Kairav Studio located, and how do you work with remote clients?",
    a: "Our core team is based in Yogyakarta, Indonesia (UTC+7 / Western Indonesia Time). We are built from the ground up for asynchronous remote collaboration — working seamlessly with clients across Asia-Pacific (Singapore, Australia, Japan), EMEA, and North America using Slack, Linear, GitHub, and Loom.",
  },
  {
    q: "What does 'Open Source Spirit' mean for client work?",
    a: "It means absolute transparency. We build with modern, open standards (Astro, TypeScript, Tailwind, Node.js) instead of proprietary black boxes. You own 100% of the repository, assets, and design tokens upon completion. Any developer on your team can easily read, modify, and deploy the code.",
  },
  {
    q: "Do you offer post-launch support and long-term partnerships?",
    a: "Yes. Every build includes a 30-day post-launch warranty period covering any bug fixes or adjustments. For ongoing feature development and performance monitoring, we offer flexible monthly engineering retainers.",
  },
  {
    q: "How can I learn more about the engineers building the projects?",
    a: "You can explore our dedicated Teams page, which showcases full profiles, technical specializations, GitHub repositories, and past project impact for each of our core leads.",
  },
];
---

<BaseLayout
  title="About Kairav Studio — Philosophy, Craft & Architecture"
  description="Learn about Kairav Studio: our design-led engineering ethos, open-source mindset, 4-stage studio evolution, and commitment to sub-100ms web systems."
>
  <main class="about-page-main">
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 1. HERO BAND (Dark Blueprint Architecture)                             */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="about-hero-section" data-hero-section aria-label="About Kairav Studio Overview">
      {/* Background Rotating Watermark */}
      <div class="hero-watermark" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" class="rotor-svg">
          <path
            d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.6142 50 100C50 72.6142 72.6142 50 100 50C72.6142 50 50 27.6142 50 0Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>

      <div class="about-container">
        {/* Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        {/* Top Blueprint Telemetry Bar */}
        <div class="blueprint-meta-bar" aria-hidden="true">
          <div class="blueprint-meta-left">
            <span class="blueprint-status-dot"></span>
            <span class="blueprint-mono">STATUS: ONLINE · EST. 2022 · HEADQUARTERED IN YOGYAKARTA, ID (UTC+7)</span>
          </div>
          <div class="blueprint-meta-right">
            <span class="blueprint-mono">FOUNDED ON CRAFT · STATIC FIRST · ZERO COMPROMISE</span>
          </div>
        </div>

        <div class="band-row hero-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Studio Dossier
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Design-Led Engineering
            </div>

            {/* Rating Pill */}
            <div class="rating-badge">
              <div class="rating-star-box">
                <span class="star-icon">★</span>
                <span class="rating-val">4.9</span>
              </div>
              <span class="rating-sub">50+ Shipped Systems</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">STUDIO ETHOS</span>
              <span class="spec-value">Substance Over Hype</span>
              <span class="spec-detail">We reject disposable digital marketing fluff. We build durable, fast software.</span>
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">HEADQUARTERS</span>
              <span class="spec-value">Yogyakarta, ID</span>
              <span class="spec-detail">Creative & engineering hub in Central Java, collaborating globally.</span>
            </div>
          </aside>

          {/* Main Hero Stage */}
          <div class="band-main">
            <div class="hero-header-wrap">
              <span class="hero-eyebrow">THE KAIRAV MANIFESTO</span>
              <h1 class="hero-title">
                Design-Led Craft. <span class="hero-highlight">Engineered for Permanence.</span>
              </h1>
              <p class="hero-desc">
                Kairav Studio was founded to bridge the divide between high-end visual aesthetics and rock-solid technical execution. We build digital platforms that feel considered, load in milliseconds, and remain maintainable as organizations scale.
              </p>
            </div>

            {/* Guarantees & Operating Commitments Strip */}
            <div class="hero-standards-strip">
              <div class="standard-chip">
                <span class="chip-val">Static-First Core</span>
                <span class="chip-sub">Zero-JS default hydration for instant page loads.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Design System Rigor</span>
                <span class="chip-sub">Coherent tokens spanning web, brand, and mobile.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">SEO & GEO Ready</span>
                <span class="chip-sub">Structured for both Google search & AI engine retrieval.</span>
              </div>
              <div class="standard-chip">
                <span class="chip-val">Direct Accountability</span>
                <span class="chip-sub">Direct access to senior leads with zero account layers.</span>
              </div>
            </div>

            {/* Action buttons */}
            <div class="hero-action-row">
              <a href="#philosophy" class="clonix-cta-button">
                <span class="clonix-cta-button__text">Explore Our Philosophy</span>
                <span class="clonix-cta-button__box" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 3v10M4 9l4 4 4-4"/>
                  </svg>
                </span>
              </a>

              <a href="/works" class="hero-outline-btn">
                <span>View Shipped Systems</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            {/* Architectural Studio Blueprint Media Frame */}
            <div class="about-hero-media-frame">
              <span class="frame-tag">STUDIO BLUEPRINT · ARCHITECTURAL CRAFT</span>
              <span class="frame-cross cross--tl" aria-hidden="true">+</span>
              <span class="frame-cross cross--tr" aria-hidden="true">+</span>
              <span class="frame-cross cross--bl" aria-hidden="true">+</span>
              <span class="frame-cross cross--br" aria-hidden="true">+</span>
              <img
                src="https://framerusercontent.com/images/1Kse6ZxZaIqYjLtJebeRYG2G8s.png?width=1376&height=768"
                alt="Kairav Studio architectural interface craftsmanship"
                class="about-hero-img"
                loading="eager"
                width="1376"
                height="768"
              />
              <div class="frame-caption">
                <div class="caption-left">
                  <span class="caption-id">SPEC // ZERO BLOAT · STATIC CORE</span>
                  <span class="caption-sep">·</span>
                  <span class="caption-status">BUILT IN YOGYAKARTA</span>
                </div>
                <div class="caption-right">
                  <span class="caption-tech">ASTRO 5 · TYPESCRIPT · EDGE RUNTIME</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 2. STUDIO PHILOSOPHY & VALUES (Light Canvas #f8f5ec)                   */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="philosophy-section" id="philosophy" aria-label="Studio Philosophy and Values">
      <div class="about-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Core Values
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              Engineering Standards
            </div>

            <div class="about-meta-note">
              <span class="meta-label">DISCIPLINE</span>
              <span class="meta-val">03 Axioms</span>
              <span class="meta-desc">Core convictions that guide our architecture and team decisions.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">01 · OPERATING PRINCIPLES</span>
              <h2 class="matrix-title">How We Think, Design, and Ship.</h2>
              <p class="matrix-desc">
                We believe the best digital work is born from restraint, deep technical grounding, and honest collaboration with our clients.
              </p>
            </div>

            {/* 3 Values Grid */}
            <div class="values-cards-grid">
              {studioValues.map((val) => (
                <article class="value-card">
                  <div class="value-top-row">
                    <span class="value-number">{val.num}</span>
                    <span class="value-tag-pill">{val.tag}</span>
                  </div>

                  <h3 class="value-card-title">{val.title}</h3>
                  <p class="value-card-desc">{val.desc}</p>

                  <div class="value-points-list">
                    {val.points.map((pt) => (
                      <div class="value-point-item">
                        <span class="point-bullet">›</span>
                        <span class="point-text">{pt}</span>
                      </div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 3. FOUNDER & LEADERSHIP DOSSIER (Dark Canvas #07080b)                  */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="founder-section" aria-label="Founder and Leadership">
      <div class="about-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Leadership
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              Founder Statement
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">LEADERSHIP ROLE</span>
              <span class="spec-value">Inisiator & Lead</span>
              <span class="spec-detail">Guiding technical delivery, architectural standards, and studio culture.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main">
            <div class="founder-dossier-card">
              <div class="founder-photo-frame">
                <img
                  src="https://github.com/ilhamkrnwan.png"
                  alt="Ilham Kurniawan - Founder & Lead Engineer at Kairav Studio"
                  class="founder-portrait"
                  width="220"
                  height="220"
                  loading="lazy"
                  decoding="async"
                />
                <span class="founder-status-dot" title="Active Lead"></span>
              </div>

              <div class="founder-content-block">
                <div class="founder-role-tag">
                  <span class="role-dot"></span>
                  <span>STUDIO INISIATOR & SYSTEM ARCHITECT</span>
                </div>

                <h3 class="founder-full-name">Ilham Kurniawan</h3>
                
                <blockquote class="founder-statement">
                  “We started Kairav Studio because we were tired of seeing great brands settle for forgettable, sluggish websites built on bloated page builders. Every build we take on is a commitment to senior craft, speed, and lasting architectural value.”
                </blockquote>

                <p class="founder-bio-text">
                  Fullstack web and mobile developer who shapes product direction, visual systems, and technical delivery across the studio's projects. Specializing in zero-hydration static engines (Astro), modern edge deployments, and accessible design tokens.
                </p>

                <div class="founder-meta-links">
                  <a href="https://github.com/ilhamkrnwan" target="_blank" rel="noopener noreferrer" class="founder-link">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    <span>@ilhamkrnwan</span>
                  </a>

                  <a href="https://ilhamkrnwan.my.id" target="_blank" rel="noopener noreferrer" class="founder-link">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="12" x2="21" y2="3"></line>
                    </svg>
                    <span>Portfolio Site</span>
                  </a>

                  <a href="/teams" class="teams-page-btn">
                    <span>Meet Entire Core Roster ({contributors.length} Leads)</span>
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 4. STUDIO EVOLUTION & TIMELINE (Light Canvas #f8f5ec)                  */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="timeline-section" aria-label="Studio Chronology and Milestones">
      <div class="about-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail rail-light">
            <div class="rail-tag rail-tag--dark">
              <span class="rail-slash">//</span> Chronology
            </div>

            <div class="rail-pill">
              <span class="rail-dot" aria-hidden="true"></span>
              2022 to 2026
            </div>

            <div class="about-meta-note">
              <span class="meta-label">MILESTONE VOLUME</span>
              <span class="meta-val">4 Key Eras</span>
              <span class="meta-desc">From independent research to full-lifecycle production delivery.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main main-light">
            <div class="matrix-header-wrap">
              <span class="matrix-eyebrow">02 · STUDIO TRAJECTORY</span>
              <h2 class="matrix-title">From Independent Lab to Production Studio.</h2>
              <p class="matrix-desc">
                Our growth has been organic, code-driven, and focused on shipping resilient systems rather than chasing marketing headlines.
              </p>
            </div>

            {/* 4-Stage Timeline Matrix */}
            <div class="milestones-matrix">
              {studioMilestones.map((m) => (
                <div class="milestone-card">
                  <div class="milestone-head">
                    <span class="milestone-year">{m.year}</span>
                    <span class="milestone-phase-badge">{m.phase}</span>
                  </div>

                  <div class="milestone-media-frame">
                    <img
                      src={m.image}
                      alt={m.title}
                      class="milestone-media-img"
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="340"
                    />
                    <div class="milestone-media-overlay"></div>
                    <span class="milestone-era-chip">{m.year} ARCHIVE</span>
                  </div>

                  <h3 class="milestone-title">{m.title}</h3>
                  <p class="milestone-desc">{m.desc}</p>

                  <div class="milestone-achievement-pill">
                    <span class="achievement-icon">★</span>
                    <span class="achievement-text">{m.achievement}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Bottom Corner Crosshairs */}
        <span class="grid-cross cross--bl" aria-hidden="true">+</span>
        <span class="grid-cross cross--br" aria-hidden="true">+</span>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════════════════════ */}
    {/* 5. COMPARISON MATRIX (Dark Obsidian Canvas #07080b)                    */}
    {/* ═══════════════════════════════════════════════════════════════════════ */}
    <section class="comparison-section" aria-label="Why Choose Kairav Studio">
      <div class="about-container">
        {/* Top Corner Crosshairs */}
        <span class="grid-cross cross--tl" aria-hidden="true">+</span>
        <span class="grid-cross cross--tr" aria-hidden="true">+</span>

        <div class="band-row">
          {/* Left Rail */}
          <aside class="band-rail">
            <div class="rail-tag">
              <span class="rail-slash">//</span> Model Contrast
            </div>

            <div class="rail-live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              The Kairav Advantage
            </div>

            <div class="rail-spec-box">
              <span class="spec-label">EFFICIENCY RATIO</span>
              <span class="spec-value">3x Faster Delivery</span>
              <span class="spec-detail">Zero layers of account managers means rapid feedback loops and pure senior execution.</span>
            </div>
          </aside>

          {/* Right Main Column */}
          <div class="band-main">
            <div class="comparison-header-wrap">
              <span class="comparison-eyebrow">03 · WHY AMBITIOUS TEAMS PARTNER WITH US</span>
              <h2 class="comparison-title">The Bloated Agency vs The Kairav Collective.</h2>
              <p class="comparison-desc">
                We engineered our studio structure to remove the friction points that plague traditional creative agencies.
              </p>
            </div>

            {/* Comparison Table Grid */}
            <div class="comparison-grid">
              <div class="comparison-grid-header">
                <span class="col-head col-dim">DIMENSION</span>
                <span class="col-head col-agency">TRADITIONAL AGENCY</span>
