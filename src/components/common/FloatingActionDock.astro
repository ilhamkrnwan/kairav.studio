---
import { getLangFromUrl, localizePath } from "../../i18n/ui";

const lang = getLangFromUrl(Astro.url);
---

<aside class="floating-dock" aria-label="Quick actions dock">
  <!-- Primary Pill (Lime Accent - Start a Project) -->
  <a
    href={localizePath("/contact", lang)}
    class="dock-pill dock-pill--primary"
    id="dock-cta-project"
  >
    <span class="dock-pill__text">Start a Project</span>
    <span class="dock-pill__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </a>

  <!-- Secondary Pill (White/Ivory Pill - Hire / WhatsApp Direct) -->
  <a
    href="https://wa.me/6282241907338?text=Hello%20Kairav%20Studio,%20I%20would%20like%20to%20discuss%20a%20project"
    target="_blank"
    rel="noopener noreferrer"
    class="dock-pill dock-pill--secondary"
    id="dock-cta-chat"
  >
    <span class="dock-pill__text">Hire Studio</span>
    <span class="dock-pill__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </span>
  </a>
</aside>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     CLONIX-INSPIRED FLOATING ACTION DOCK
     Fixed bottom-right corner with pill CTAs & circular arrow badges
     ═══════════════════════════════════════════════════════════════════ */

  .floating-dock {
    position: fixed;
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    right: clamp(1rem, 2.5vw, 1.75rem);
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.625rem;
    pointer-events: none; /* children enable pointer events */
  }

  .dock-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    height: 42px;
    padding: 4px 5px 4px 16px;
    border-radius: 9999px;
    text-decoration: none;
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow:
      0 12px 30px -6px rgba(0, 0, 0, 0.45),
      0 4px 12px -2px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 220ms ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .dock-pill:hover {
    transform: translateY(-2.5px) scale(1.02);
    box-shadow:
      0 18px 36px -6px rgba(0, 0, 0, 0.6),
      0 6px 16px -2px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .dock-pill:active {
    transform: translateY(0) scale(0.98);
  }

  /* ── Pill 1: Primary (Lime Accent) ────────────────────────────────── */
  .dock-pill--primary {
    background: #b6ff5c;
    color: #07080b;
  }

  .dock-pill--primary .dock-pill__icon {
    background: #07080b;
    color: #b6ff5c;
  }

  .dock-pill--primary:hover {
    filter: brightness(1.04);
  }

  /* ── Pill 2: Secondary (White/Ivory High Contrast) ─────────────────── */
  .dock-pill--secondary {
    background: #ffffff;
    color: #07080b;
  }

  .dock-pill--secondary .dock-pill__icon {
    background: #07080b;
    color: #ffffff;
  }

  .dock-pill--secondary:hover {
    filter: brightness(0.97);
  }

  /* ── Circular Icon Container ──────────────────────────────────────── */
  .dock-pill__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-pill:hover .dock-pill__icon {
    transform: translateX(2px);
  }

  /* ── Desktop Right Rail Offset (padding-right: 4.5rem) ───────────── */
  @media (min-width: 768px) {
    .floating-dock {
      right: calc(4.5rem + clamp(1.25rem, 2.5vw, 2rem));
      bottom: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  /* ── Mobile responsiveness ────────────────────────────────────────── */
  @media (max-width: 767px) {
    .floating-dock {
      bottom: 1rem;
      right: 1rem;
      gap: 0.5rem;
    }

    .dock-pill {
      height: 38px;
      padding: 3px 4px 3px 13px;
      font-size: 0.76rem;
    }

    .dock-pill__icon {
      width: 28px;
      height: 28px;
    }
  }

  /* ── Accessibility ────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .dock-pill,
    .dock-pill__icon {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
