---
import { getLangFromUrl, localizePath, useTranslations } from "../../i18n/ui";
import Grainient from "../common/Grainient.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer" role="contentinfo">
  <!-- Top Neon/Lime Hairline Accent -->
  <div class="footer-accent-rule" aria-hidden="true"></div>

  <!-- Ambient Texture & Grainient Canvas (vue-bits style) -->
  <div class="footer-atmosphere" aria-hidden="true">
    <Grainient
      color1="#7ecc2c"
      color2="#050806"
      color3="#1a320f"
      timeSpeed={0.18}
      warpStrength={1.15}
      warpFrequency={4.2}
      warpSpeed={1.4}
      warpAmplitude={46.0}
      blendAngle={18.0}
      blendSoftness={0.09}
      rotationAmount={380.0}
      noiseScale={2.0}
      grainAmount={0.09}
      grainScale={2.4}
      contrast={1.4}
      gamma={1.0}
      saturation={1.05}
      zoom={0.95}
      class="footer-grainient"
    />
    <div class="footer-atmosphere__glow"></div>
    <div class="footer-atmosphere__scrim"></div>
  </div>

  <div class="footer-container">

    <!-- ── 1. UPPER DECK: Monumental CTA Banner (Clonix Style) ──────── -->
    <section class="footer-cta-card" aria-label="Call to action">
      <!-- Architectural Corner Crosshairs (+) -->
      <span class="grid-cross cross--tl" aria-hidden="true">+</span>
      <span class="grid-cross cross--tr" aria-hidden="true">+</span>
      <span class="grid-cross cross--bl" aria-hidden="true">+</span>
      <span class="grid-cross cross--br" aria-hidden="true">+</span>

      <div class="cta-card__inner">
        <h2 class="cta-card__headline">
          Let’s Build Something That Defines Your Brand and Drives Real Growth.
        </h2>
        <p class="cta-card__desc">
          Kairav Studio helps ambitious teams turn bold ideas into high-velocity websites, scalable systems, and automated workflows.
        </p>

        <div class="cta-card__actions">
          <!-- Primary Clonix-style Action Button with Arrow Box -->
          <a href={localizePath("/contact", lang)} class="clonix-cta-button" id="footer-main-cta">
            <span class="clonix-cta-button__text">{t("Start a Project")}</span>
            <span class="clonix-cta-button__box" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8h10M9 4l4 4-4 4"/>
              </svg>
            </span>
          </a>

          <!-- Rating / Trust Signal -->
          <div class="clonix-rating-pill" aria-label="5 star client rating">
            <span class="clonix-rating-pill__star" aria-hidden="true">★</span>
            <span class="clonix-rating-pill__label">5 Star Ratings · Trusted by 50+ Modern Teams</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2. BRAND BAR (Clonix Style) ──────────────────────────────── -->
    <div class="footer-brand-bar">
      <div class="footer-brand-bar__left">
        <a href={localizePath("/", lang)} class="footer-logo" aria-label="Kairav Studio Home">
          <img src="/logo-mark.avif" alt="" class="footer-logo__mark" width="30" height="30" />
          <span class="footer-logo__text">KAIRAV<span class="footer-logo__studio">.studio</span></span>
        </a>
      </div>

      <div class="footer-brand-bar__right">
        <span class="availability-status">
          <span class="availability-dot" aria-hidden="true"></span>
          <span class="availability-text">AVAILABLE FOR PROJECTS · YOGYAKARTA, ID</span>
        </span>
      </div>
    </div>

    <!-- ── 3. LOWER DECK: Architectural Multi-Column Grid with Lines ── -->
    <div class="footer-grid-wrapper">
      <!-- Horizontal Lime Divider across top of the grid -->
      <div class="lime-top-divider" aria-hidden="true"></div>

      <!-- Crosshairs (+) pinned at column line intersections -->
      <span class="line-cross cross--c0" aria-hidden="true">+</span>
      <span class="line-cross cross--c1" aria-hidden="true">+</span>
      <span class="line-cross cross--c2" aria-hidden="true">+</span>
      <span class="line-cross cross--c3" aria-hidden="true">+</span>

      <div class="footer-nav-grid">
        <!-- Column 1: QUICK LINKS. + Bottom Copyright -->
        <div class="footer-grid-col footer-grid-col--col1">
          <div class="col-content">
            <h3 class="nav-col-title">QUICK LINKS.</h3>
            <ul class="nav-list" role="list">
              <li><a href={localizePath("/", lang)} class="nav-link">Home</a></li>
              <li><a href={localizePath("/about", lang)} class="nav-link">{t("About")}</a></li>
              <li><a href={localizePath("/teams", lang)} class="nav-link">{t("Teams")}</a></li>
              <li><a href={localizePath("/services", lang)} class="nav-link">{t("Services")}</a></li>
              <li><a href={localizePath("/works", lang)} class="nav-link">{t("Work")}</a></li>
              <li><a href={localizePath("/tools", lang)} class="nav-link">{t("Tools")}</a></li>
              <li><a href={localizePath("/insights", lang)} class="nav-link">{t("Insights")}</a></li>
              <li><a href={localizePath("/contact", lang)} class="nav-link">{t("Contact")}</a></li>
            </ul>
          </div>

          <div class="footer-copyright-wrap">
            <span class="footer-copyright">Copyright © {year} Kairav Studio</span>
          </div>
        </div>

        <!-- Column 2: CONTACT & FOLLOW (Clonix Layout) -->
        <div class="footer-grid-col footer-grid-col--col2">
          <!-- Contact block -->
          <div class="col-content">
            <h3 class="nav-col-title">CONTACT</h3>
            <ul class="nav-list" role="list">
              <li>
                <div class="email-copy-row">
                  <a href="mailto:hello@kairav.studio" class="nav-link nav-link--highlight">hello@kairav.studio</a>
                  <button
                    type="button"
                    class="footer-copy-btn"
                    id="copy-email-btn"
                    aria-label="Copy email address"
                    title="Copy email to clipboard"
                  >
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                    </svg>
                    <span class="copy-label">Copy</span>
                  </button>
                </div>
              </li>
              <li>
                <span class="nav-text-muted">17 Mataram St, Yogyakarta, ID</span>
              </li>
              <li>
                <a href="https://wa.me/6282241907338" target="_blank" rel="noopener noreferrer" class="nav-link">
                  +62 822 4190 7338
                </a>
              </li>
            </ul>

            <!-- Follow block below Contact -->
            <div class="sub-col-block">
              <h3 class="nav-col-title">FOLLOW</h3>
              <ul class="nav-list" role="list">
                <li><a href="https://github.com/ilhamkrnwan/kairav.studio" target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a></li>
                <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="nav-link">LinkedIn</a></li>
                <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="nav-link">Instagram</a></li>
                <li><a href="https://x.com" target="_blank" rel="noopener noreferrer" class="nav-link">Twitter / X</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Column 3: LEGAL & TELEMETRY -->
        <div class="footer-grid-col footer-grid-col--col3">
          <div class="col-content">
            <h3 class="nav-col-title">LEGAL</h3>
            <ul class="nav-list" role="list">
              <li><a href={localizePath("/privacy-policy", lang)} class="nav-link">Privacy Policy</a></li>
              <li><a href={localizePath("/terms", lang)} class="nav-link">Terms & Conditions</a></li>
              <li><a href={localizePath("/security-sla", lang)} class="nav-link">Security & SLA</a></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom Hairline Border -->
      <div class="grid-bottom-line" aria-hidden="true"></div>
      <span class="line-cross cross--b0" aria-hidden="true">+</span>
      <span class="line-cross cross--b1" aria-hidden="true">+</span>
      <span class="line-cross cross--b2" aria-hidden="true">+</span>
      <span class="line-cross cross--b3" aria-hidden="true">+</span>
    </div>

  </div>
</footer>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     CLONIX-INSPIRED ARCHITECTURAL FOOTER
     Full Hairline Grid System: Visible Vertical & Horizontal Lines
     ═══════════════════════════════════════════════════════════════════ */

  .site-footer {
    position: relative;
    background-color: #07080b;
    color: #f8f5ec;
    overflow: hidden;
    padding-top: clamp(3rem, 5vw, 5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
    isolation: isolate;
  }

  /* Top Border Rule */
  .footer-accent-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 15%,
      rgba(182, 255, 92, 0.5) 50%,
      rgba(255, 255, 255, 0.08) 85%,
      transparent 100%
    );
  }

  /* Atmosphere / Glow */
  .footer-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .footer-grainient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.48;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .footer-atmosphere__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 50% at 20% 90%, rgba(79, 125, 24, 0.08), transparent 60%),
      radial-gradient(ellipse 50% 60% at 80% 30%, rgba(182, 255, 92, 0.05), transparent 70%);
  }

  .footer-atmosphere__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(7, 8, 11, 0.55) 90%),
      linear-gradient(
        180deg,
        rgba(7, 8, 11, 0.65) 0%,
        rgba(7, 8, 11, 0.15) 35%,
        rgba(7, 8, 11, 0.35) 70%,
        rgba(7, 8, 11, 0.85) 100%
      );
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
  }

  /* ── 1. Upper CTA Card ────────────────────────────────────────────── */
  .footer-cta-card {
    position: relative;
    background: rgba(11, 12, 16, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.75rem, 4vw, 3.5rem);
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
  }

  /* Corner Crosshairs (+) */
  .grid-cross {
    position: absolute;
    width: 14px;
    height: 14px;
    line-height: 14px;
    text-align: center;
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.35);
    user-select: none;
    pointer-events: none;
    z-index: 5;
  }

  .cross--tl { top: -7px; left: -7px; }
  .cross--tr { top: -7px; right: -7px; }
  .cross--bl { bottom: -7px; left: -7px; }
  .cross--br { bottom: -7px; right: -7px; }

  .cta-card__inner {
    max-width: 52rem;
  }

  .cta-card__headline {
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: clamp(2.1rem, 4.2vw, 3.85rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #f8f5ec;
    margin: 0 0 1.25rem 0;
  }

  .cta-card__desc {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.55;
    color: #a1a1aa;
    margin: 0 0 2.25rem 0;
    max-width: 44rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .clonix-cta-button {
    display: inline-flex;
    align-items: center;
    background: #b6ff5c;
    color: #07080b;
    text-decoration: none;
    border-radius: 4px;
    padding: 3px 3px 3px 18px;
    font-family: var(--font-heading, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms ease,
      box-shadow 200ms ease;
    box-shadow: 0 8px 24px -6px rgba(182, 255, 92, 0.3);
  }

  .clonix-cta-button:hover {
    background-color: #c9ff7a;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgba(182, 255, 92, 0.45);
  }

  .clonix-cta-button__text {
    padding-right: 14px;
  }

  .clonix-cta-button__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #07080b;
    color: #ffffff;
    border-radius: 3px;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .clonix-cta-button:hover .clonix-cta-button__box {
    transform: translateX(2px);
  }

  .clonix-rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.88rem;
    color: #d4d4d8;
  }

  .clonix-rating-pill__star {
    color: #b6ff5c;
    font-size: 1rem;
    line-height: 1;
  }

  .clonix-rating-pill__label {
    letter-spacing: -0.01em;
  }

  /* ── 2. Brand Bar (Clonix Style) ──────────────────────────────────── */
  .footer-brand-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #f8f5ec;
  }

  .footer-logo__mark {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .footer-logo__text {
    font-family: var(--font-heading, "Space Grotesk", sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    display: inline-flex;
    align-items: baseline;
  }

  .footer-logo__studio {
    color: #b6ff5c;
    font-weight: 700;
  }

  .availability-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #71717a;
  }

  .availability-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b6ff5c;
    box-shadow: 0 0 8px rgba(182, 255, 92, 0.6);
    animation: statusPulse 2.5s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 0.7; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  /* ── 3. ARCHITECTURAL GRID WRAPPER WITH VISIBLE LINES ─────────────── */
  .footer-grid-wrapper {
    position: relative;
    width: 100%;
  }

  /* Visible Horizontal Lime Top Line */
  .lime-top-divider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: #b6ff5c;
    opacity: 0.65;
    box-shadow: 0 0 12px rgba(182, 255, 92, 0.35);
    z-index: 3;
  }

  /* Visible Bottom Line */
  .grid-bottom-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    z-index: 3;
  }

  /* ── 4-Column Grid Structure with Vertical Hairlines ──────────────── */
  .footer-nav-grid {
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 640px) {
    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-nav-grid {
      grid-template-columns: 1.6fr 1.4fr 1.2fr;
    }
  }

  /* Grid Column Cell: VISIBLE VERTICAL LINES */
  .footer-grid-col {
    position: relative;
    padding: clamp(2rem, 3.5vw, 3.25rem) clamp(1.25rem, 2.25vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 24rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Vertical lines on tablet & desktop */
  @media (min-width: 640px) {
    .footer-grid-col {
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }

    .footer-grid-col:nth-child(2n) {
      border-right: none;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid-col {
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.12) !important;
    }

    .footer-grid-col:first-child {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }

    .footer-grid-col:last-child {
      border-right: 1px solid rgba(255, 255, 255, 0.12) !important;
    }
  }

  /* ── Crosshairs (+) pinned at line intersections ─────────────────── */
  .line-cross {
    position: absolute;
    width: 14px;
    height: 14px;
    line-height: 14px;
    text-align: center;
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    font-weight: 500;
    color: #b6ff5c;
    user-select: none;
    pointer-events: none;
    z-index: 5;
    display: none;
  }

  @media (min-width: 1024px) {
    .line-cross {
      display: block;
    }

    /* Top lime line intersections (3 columns) */
    .cross--c0 { top: -7px; left: -7px; }
    .cross--c1 { top: -7px; left: calc(38.1% - 7px); }
    .cross--c2 { top: -7px; left: calc(71.43% - 7px); }
    .cross--c3 { top: -7px; right: -7px; }

    /* Bottom line intersections (3 columns) */
    .cross--b0 { bottom: -7px; left: -7px; color: rgba(255, 255, 255, 0.35); }
    .cross--b1 { bottom: -7px; left: calc(38.1% - 7px); color: rgba(255, 255, 255, 0.35); }
    .cross--b2 { bottom: -7px; left: calc(71.43% - 7px); color: rgba(255, 255, 255, 0.35); }
    .cross--b3 { bottom: -7px; right: -7px; color: rgba(255, 255, 255, 0.35); }
  }

  /* ── Column Content Styles ────────────────────────────────────────── */
  .col-content {
    display: flex;
    flex-direction: column;
  }

  .nav-col-title {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8e8e93;
    margin: 0 0 1.25rem 0;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .nav-link {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 400;
    color: #e4e4e7;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
    display: inline-block;
  }

  .nav-link:hover {
    color: #b6ff5c;
    transform: translateX(3px);
  }

  .nav-link--highlight {
    font-weight: 500;
    color: #f8f5ec;
  }

  .nav-link--highlight:hover {
    color: #b6ff5c;
  }

  .nav-text-muted {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: #a1a1aa;
    line-height: 1.5;
    display: block;
  }

  .sub-col-block {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Email copy button */
  .email-copy-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: #a1a1aa;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .footer-copy-btn:hover {
    color: #f8f5ec;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.14);
  }

  .footer-copy-btn.copied {
    color: #b6ff5c;
    border-color: rgba(182, 255, 92, 0.5);
    background: rgba(182, 255, 92, 0.15);
  }

  /* Copyright */
  .footer-copyright-wrap {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
  }

  .footer-copyright {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.88rem;
    color: #8e8e93;
    letter-spacing: -0.01em;
  }

  /* Telemetry info */
  .telemetry-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: #71717a;
    letter-spacing: 0.04em;
  }

  .telemetry-status {
    color: #b6ff5c;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  /* ── Reduced Motion ───────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .availability-dot {
      animation: none !important;
    }
    .clonix-cta-button,
    .clonix-cta-button__box,
    .nav-link {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  const setupFooterEmailCopy = () => {
    const copyBtn = document.getElementById("copy-email-btn");
    if (!copyBtn) return;

    if (copyBtn.dataset.listenerAttached) return;
    copyBtn.dataset.listenerAttached = "true";

    copyBtn.addEventListener("click", async () => {
      const email = "hello@kairav.studio";
      try {
        await navigator.clipboard.writeText(email);
        const label = copyBtn.querySelector(".copy-label");
        if (label) {
          const original = label.textContent;
          label.textContent = "Copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            label.textContent = original;
            copyBtn.classList.remove("copied");
          }, 2000);
        }
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    });
  };

  document.addEventListener("DOMContentLoaded", setupFooterEmailCopy);
  document.addEventListener("astro:page-load", setupFooterEmailCopy);
</script>
