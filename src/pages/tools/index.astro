<script>
  function setupToolsPage() {
    // 1. Discipline Filter Tabs
    const filterContainer = document.querySelector(".discipline-filters-row");
    if (filterContainer && !filterContainer.hasAttribute("data-filter-initialized")) {
      filterContainer.setAttribute("data-filter-initialized", "true");
      const filterButtons = filterContainer.querySelectorAll("[data-filter]");
      const toolCards = document.querySelectorAll("[data-tool-card]");

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filterCategory = btn.getAttribute("data-filter") || "all";

          filterButtons.forEach((b) => {
            b.classList.remove("is-active");
            b.setAttribute("aria-selected", "false");
          });
          btn.classList.add("is-active");
          btn.setAttribute("aria-selected", "true");

          toolCards.forEach((card) => {
            const cardCat = card.getAttribute("data-category") || "";
            if (filterCategory === "all" || cardCat === filterCategory) {
              (card as HTMLElement).style.display = "flex";
              (card as HTMLElement).style.opacity = "1";
            } else {
              (card as HTMLElement).style.display = "none";
            }
          });
        });
      });
    }

    // 2. FAQ Accordion Handler
    const group = document.querySelector("[data-faq-group]");
    if (group && !group.hasAttribute("data-faq-initialized")) {
      group.setAttribute("data-faq-initialized", "true");

      const items = group.querySelectorAll("[data-faq-item]");
      items.forEach((item) => {
        const trigger = item.querySelector("[data-faq-trigger]");

        trigger?.addEventListener("click", () => {
          const isExpanded = item.classList.contains("is-expanded");
          item.classList.toggle("is-expanded", !isExpanded);
          trigger.setAttribute("aria-expanded", String(!isExpanded));
        });
      });
    }
  }

  document.addEventListener("DOMContentLoaded", setupToolsPage);
  document.addEventListener("astro:page-load", setupToolsPage);
  setupToolsPage();
</script>
